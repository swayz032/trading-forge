// -----------------------------------------------------------------------------
// COLORS / PLATFORM CONTEXT
// -----------------------------------------------------------------------------
color GREEN_UP = color.rgb(0, 205, 105)
color RED_DOWN = color.rgb(230, 55, 70)
color BLUE_DAY = color.rgb(35, 112, 255)
color BLUE_WEEK = color.rgb(91, 82, 230)
color BLUE_TARGET = color.rgb(42, 118, 255)
color YELLOW_GO = color.rgb(255, 215, 0)
color ORANGE_WAIT = color.rgb(255, 155, 35)
color PANEL_DARK = color.rgb(18, 20, 25)
color PANEL_MID = color.rgb(37, 41, 49)
color GOLD_ACCENT = color.rgb(205, 165, 70)

bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool isNqMnq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool tickGridExpected = math.abs(syminfo.mintick - EXPECTED_TICK) < 1e-6
bool exactIntrabarAvailable = barstate.isrealtime
string chartStatus = isFiveMinute ? "5 MIN ✓" : timeframe.period + " — USE 5 MIN"
float touchTolerance = touchToleranceTicks * syminfo.mintick
float overlapTolerance = overlapTicks * syminfo.mintick
float violationPenetration = violationPenetrationTicks * syminfo.mintick

// -----------------------------------------------------------------------------
// PDH / PDL / PWH / PWL — PDH/PDL always; weekly only when near.
// -----------------------------------------------------------------------------
[dHighCurrent, dLowCurrent, dCloseTimeCurrent] = request.security(syminfo.tickerid, "D", [high, low, time_close], lookahead = barmerge.lookahead_off)
[dHighPrev, dLowPrev] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wHighCurrent, wLowCurrent, wCloseTimeCurrent] = request.security(syminfo.tickerid, "W", [high, low, time_close], lookahead = barmerge.lookahead_off)
[wHighPrev, wLowPrev] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

int closedGapMs = timenow - time_close
bool recentClosedGap = not barstate.isrealtime and closedGapMs >= 0 and closedGapMs <= NORMAL_CLOSED_GAP_MS
bool extendedClosedGap = not barstate.isrealtime and closedGapMs > NORMAL_CLOSED_GAP_MS
bool dailyCurrentCompletedNow = recentClosedGap and not na(dCloseTimeCurrent) and timenow >= dCloseTimeCurrent
bool weeklyCurrentCompletedNow = recentClosedGap and not na(wCloseTimeCurrent) and timenow >= wCloseTimeCurrent
float pdh = dailyCurrentCompletedNow ? dHighCurrent : dHighPrev
float pdl = dailyCurrentCompletedNow ? dLowCurrent : dLowPrev
float pwh = weeklyCurrentCompletedNow ? wHighCurrent : wHighPrev
float pwl = weeklyCurrentCompletedNow ? wLowCurrent : wLowPrev
bool dayValuesValid = not na(pdh) and not na(pdl)
bool weekValuesValid = not na(pwh) and not na(pwl)
float dailyVisualEnvelope = dayValuesValid ? math.max(math.abs(pdh - close), math.abs(pdl - close)) : na
bool showPdh = dayValuesValid
bool showPdl = dayValuesValid
bool showPwh = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwh - close) <= dailyVisualEnvelope
bool showPwl = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwl - close) <= dailyVisualEnvelope

plot(pdh, "PDH data", display = display.none)
plot(pdl, "PDL data", display = display.none)
plot(pwh, "PWH data", display = display.none)
plot(pwl, "PWL data", display = display.none)

// -----------------------------------------------------------------------------
// CONFIRMED SWING PACKS. Daily carries six same-side pivots; lower TFs carry four.
// Combined request tuple count remains under Pine's request tuple-element ceiling.
// Pine tuple return expressions are intentionally kept on one physical line here.
// -----------------------------------------------------------------------------
f_pack6() =>
    float pl = ta.pivotlow(low, 2, 2)
    float ph = ta.pivothigh(high, 2, 2)
    bool hasPl = not na(pl)
    bool hasPh = not na(ph)
    int plt = hasPl ? time[2] : na
    int pht = hasPh ? time[2] : na
    [ta.valuewhen(hasPl, plt, 5), ta.valuewhen(hasPl, pl, 5), ta.valuewhen(hasPl, plt, 4), ta.valuewhen(hasPl, pl, 4), ta.valuewhen(hasPl, plt, 3), ta.valuewhen(hasPl, pl, 3), ta.valuewhen(hasPl, plt, 2), ta.valuewhen(hasPl, pl, 2), ta.valuewhen(hasPl, plt, 1), ta.valuewhen(hasPl, pl, 1), ta.valuewhen(hasPl, plt, 0), ta.valuewhen(hasPl, pl, 0), ta.valuewhen(hasPh, pht, 5), ta.valuewhen(hasPh, ph, 5), ta.valuewhen(hasPh, pht, 4), ta.valuewhen(hasPh, ph, 4), ta.valuewhen(hasPh, pht, 3), ta.valuewhen(hasPh, ph, 3), ta.valuewhen(hasPh, pht, 2), ta.valuewhen(hasPh, ph, 2), ta.valuewhen(hasPh, pht, 1), ta.valuewhen(hasPh, ph, 1), ta.valuewhen(hasPh, pht, 0), ta.valuewhen(hasPh, ph, 0)]

f_pack4() =>
    float pl = ta.pivotlow(low, 2, 2)
    float ph = ta.pivothigh(high, 2, 2)
    bool hasPl = not na(pl)
    bool hasPh = not na(ph)
    int plt = hasPl ? time[2] : na
    int pht = hasPh ? time[2] : na
    [ta.valuewhen(hasPl, plt, 3), ta.valuewhen(hasPl, pl, 3), ta.valuewhen(hasPl, plt, 2), ta.valuewhen(hasPl, pl, 2), ta.valuewhen(hasPl, plt, 1), ta.valuewhen(hasPl, pl, 1), ta.valuewhen(hasPl, plt, 0), ta.valuewhen(hasPl, pl, 0), ta.valuewhen(hasPh, pht, 3), ta.valuewhen(hasPh, ph, 3), ta.valuewhen(hasPh, pht, 2), ta.valuewhen(hasPh, ph, 2), ta.valuewhen(hasPh, pht, 1), ta.valuewhen(hasPh, ph, 1), ta.valuewhen(hasPh, pht, 0), ta.valuewhen(hasPh, ph, 0)]

[dlt5, dlp5, dlt4, dlp4, dlt3, dlp3, dlt2, dlp2, dlt1, dlp1, dlt0, dlp0, dht5, dhp5, dht4, dhp4, dht3, dhp3, dht2, dhp2, dht1, dhp1, dht0, dhp0] = request.security(syminfo.tickerid, "D", f_pack6(), lookahead = barmerge.lookahead_off)
[h4lt3, h4lp3, h4lt2, h4lp2, h4lt1, h4lp1, h4lt0, h4lp0, h4ht3, h4hp3, h4ht2, h4hp2, h4ht1, h4hp1, h4ht0, h4hp0] = request.security(syminfo.tickerid, "240", f_pack4(), lookahead = barmerge.lookahead_off)
[h1lt3, h1lp3, h1lt2, h1lp2, h1lt1, h1lp1, h1lt0, h1lp0, h1ht3, h1hp3, h1ht2, h1hp2, h1ht1, h1hp1, h1ht0, h1hp0] = request.security(syminfo.tickerid, "60", f_pack4(), lookahead = barmerge.lookahead_off)
[m15lt3, m15lp3, m15lt2, m15lp2, m15lt1, m15lp1, m15lt0, m15lp0, m15ht3, m15hp3, m15ht2, m15hp2, m15ht1, m15hp1, m15ht0, m15hp0] = request.security(syminfo.tickerid, "15", f_pack4(), lookahead = barmerge.lookahead_off)
[m5lt3, m5lp3, m5lt2, m5lp2, m5lt1, m5lp1, m5lt0, m5lp0, m5ht3, m5hp3, m5ht2, m5hp2, m5ht1, m5hp1, m5ht0, m5hp0] = request.security(syminfo.tickerid, "5", f_pack4(), lookahead = barmerge.lookahead_off)

array<int> dLowT = array.from(dlt5, dlt4, dlt3, dlt2, dlt1, dlt0)
array<float> dLowP = array.from(dlp5, dlp4, dlp3, dlp2, dlp1, dlp0)
array<int> dHighT = array.from(dht5, dht4, dht3, dht2, dht1, dht0)
array<float> dHighP = array.from(dhp5, dhp4, dhp3, dhp2, dhp1, dhp0)
array<int> h4LowT = array.from(h4lt3, h4lt2, h4lt1, h4lt0)
array<float> h4LowP = array.from(h4lp3, h4lp2, h4lp1, h4lp0)
array<int> h4HighT = array.from(h4ht3, h4ht2, h4ht1, h4ht0)
array<float> h4HighP = array.from(h4hp3, h4hp2, h4hp1, h4hp0)
array<int> h1LowT = array.from(h1lt3, h1lt2, h1lt1, h1lt0)
array<float> h1LowP = array.from(h1lp3, h1lp2, h1lp1, h1lp0)
array<int> h1HighT = array.from(h1ht3, h1ht2, h1ht1, h1ht0)
array<float> h1HighP = array.from(h1hp3, h1hp2, h1hp1, h1hp0)
array<int> m15LowT = array.from(m15lt3, m15lt2, m15lt1, m15lt0)
array<float> m15LowP = array.from(m15lp3, m15lp2, m15lp1, m15lp0)
array<int> m15HighT = array.from(m15ht3, m15ht2, m15ht1, m15ht0)
array<float> m15HighP = array.from(m15hp3, m15hp2, m15hp1, m15hp0)
array<int> m5LowT = array.from(m5lt3, m5lt2, m5lt1, m5lt0)
array<float> m5LowP = array.from(m5lp3, m5lp2, m5lp1, m5lp0)
array<int> m5HighT = array.from(m5ht3, m5ht2, m5ht1, m5ht0)
array<float> m5HighP = array.from(m5hp3, m5hp2, m5hp1, m5hp0)

// -----------------------------------------------------------------------------
// FAMILY GEOMETRY: Daily root; every child uses parent.B as child.A exactly.
// -----------------------------------------------------------------------------
f_line_at(int t1, float p1, int t2, float p2, int atTime) =>
    not na(t1) and not na(t2) and t2 > t1 ? p1 + (float(atTime - t1) / float(t2 - t1)) * (p2 - p1) : na

f_clean_pair(int aT, float aP, int bT, float bP, array<int> ts, array<float> ps, bool bullish, float tol) =>
    bool clean = true
    int n = array.size(ts)
    for i = 0 to n - 1
        int st = array.get(ts, i)
        float sp = array.get(ps, i)
        if not na(st) and not na(sp) and st > aT and st < bT
            float lp = f_line_at(aT, aP, bT, bP, st)
            if bullish and sp < lp - tol
                clean := false
            if not bullish and sp > lp + tol
                clean := false
    clean

f_root(array<int> ts, array<float> ps, bool bullish, float tol, int minBExclusive) =>
    bool valid = false
    int aT = na
    float aP = na
    int bT = na
    float bP = na
    int n = array.size(ts)
    for i = 0 to n - 1
        int st = array.get(ts, i)
        float sp = array.get(ps, i)
        if not na(st) and not na(sp)
            bool better = na(aP) or (bullish ? sp < aP : sp > aP)
            if better
                aT := st
                aP := sp
    if not na(aT)
        for off = 0 to n - 1
            int j = n - 1 - off
            int st = array.get(ts, j)
            float sp = array.get(ps, j)
            bool afterA = not na(st) and st > aT
            bool afterOld = na(minBExclusive) or (not na(st) and st > minBExclusive)
            bool directional = not na(sp) and (bullish ? sp > aP : sp < aP)
            if not valid and afterA and afterOld and directional and f_clean_pair(aT, aP, st, sp, ts, ps, bullish, tol)
                valid := true
                bT := st
                bP := sp
    [valid, aT, aP, bT, bP]

f_child(bool parentValid, int pAT, float pAP, int pBT, float pBP, array<int> ts, array<float> ps, bool bullish, float tol, float separation, int minBExclusive) =>
    bool valid = false
    int aT = pBT
    float aP = pBP
    int bT = na
    float bP = na
    int n = array.size(ts)
    if parentValid and not na(aT) and not na(aP)
        for off = 0 to n - 1
            int j = n - 1 - off
            int st = array.get(ts, j)
            float sp = array.get(ps, j)
            bool afterA = not na(st) and st > aT
            bool afterOld = na(minBExclusive) or (not na(st) and st > minBExclusive)
            bool directional = not na(sp) and (bullish ? sp > aP : sp < aP)
            if not valid and afterA and afterOld and directional and f_clean_pair(aT, aP, st, sp, ts, ps, bullish, tol)
                float parentAtB = f_line_at(pAT, pAP, pBT, pBP, st)
                bool distinctPath = na(parentAtB) or math.abs(sp - parentAtB) >= separation
                if distinctPath
                    valid := true
                    bT := st
                    bP := sp
    [valid, aT, aP, bT, bP]

// Current confirmed candidate family. This may evolve internally; the BOARD below does not.
[dGC, dGATC, dGAPC, dGBTC, dGBPC] = f_root(dLowT, dLowP, true, touchTolerance, na)
[dRC, dRATC, dRAPC, dRBTC, dRBPC] = f_root(dHighT, dHighP, false, touchTolerance, na)
[h4GC, h4GATC, h4GAPC, h4GBTC, h4GBPC] = f_child(dGC, dGATC, dGAPC, dGBTC, dGBPC, h4LowT, h4LowP, true, touchTolerance, overlapTolerance, na)
[h4RC, h4RATC, h4RAPC, h4RBTC, h4RBPC] = f_child(dRC, dRATC, dRAPC, dRBTC, dRBPC, h4HighT, h4HighP, false, touchTolerance, overlapTolerance, na)

bool h1GPV = h4GC or dGC
int h1GPAT = h4GC ? h4GATC : dGATC
float h1GPAP = h4GC ? h4GAPC : dGAPC
int h1GPBT = h4GC ? h4GBTC : dGBTC
float h1GPBP = h4GC ? h4GBPC : dGBPC
bool h1RPV = h4RC or dRC
int h1RPAT = h4RC ? h4RATC : dRATC
float h1RPAP = h4RC ? h4RAPC : dRAPC
int h1RPBT = h4RC ? h4RBTC : dRBTC
float h1RPBP = h4RC ? h4RBPC : dRBPC
[h1GC, h1GATC, h1GAPC, h1GBTC, h1GBPC] = f_child(h1GPV, h1GPAT, h1GPAP, h1GPBT, h1GPBP, h1LowT, h1LowP, true, touchTolerance, overlapTolerance, na)
[h1RC, h1RATC, h1RAPC, h1RBTC, h1RBPC] = f_child(h1RPV, h1RPAT, h1RPAP, h1RPBT, h1RPBP, h1HighT, h1HighP, false, touchTolerance, overlapTolerance, na)

bool m15GPV = h1GC or h4GC or dGC
int m15GPAT = h1GC ? h1GATC : h4GC ? h4GATC : dGATC
float m15GPAP = h1GC ? h1GAPC : h4GC ? h4GAPC : dGAPC
int m15GPBT = h1GC ? h1GBTC : h4GC ? h4GBTC : dGBTC
float m15GPBP = h1GC ? h1GBPC : h4GC ? h4GBPC : dGBPC
bool m15RPV = h1RC or h4RC or dRC
int m15RPAT = h1RC ? h1RATC : h4RC ? h4RATC : dRATC
float m15RPAP = h1RC ? h1RAPC : h4RC ? h4RAPC : dRAPC
int m15RPBT = h1RC ? h1RBTC : h4RC ? h4RBTC : dRBTC
float m15RPBP = h1RC ? h1RBPC : h4RC ? h4RBPC : dRBPC
[m15GC, m15GATC, m15GAPC, m15GBTC, m15GBPC] = f_child(m15GPV, m15GPAT, m15GPAP, m15GPBT, m15GPBP, m15LowT, m15LowP, true, touchTolerance, overlapTolerance, na)
[m15RC, m15RATC, m15RAPC, m15RBTC, m15RBPC] = f_child(m15RPV, m15RPAT, m15RPAP, m15RPBT, m15RPBP, m15HighT, m15HighP, false, touchTolerance, overlapTolerance, na)

bool m5GPV = m15GC or h1GC or h4GC or dGC
int m5GPAT = m15GC ? m15GATC : h1GC ? h1GATC : h4GC ? h4GATC : dGATC
float m5GPAP = m15GC ? m15GAPC : h1GC ? h1GAPC : h4GC ? h4GAPC : dGAPC
int m5GPBT = m15GC ? m15GBTC : h1GC ? h1GBTC : h4GC ? h4GBTC : dGBTC
float m5GPBP = m15GC ? m15GBPC : h1GC ? h1GBPC : h4GC ? h4GBPC : dGBPC
bool m5RPV = m15RC or h1RC or h4RC or dRC
int m5RPAT = m15RC ? m15RATC : h1RC ? h1RATC : h4RC ? h4RATC : dRATC
float m5RPAP = m15RC ? m15RAPC : h1RC ? h1RAPC : h4RC ? h4RAPC : dRAPC
int m5RPBT = m15RC ? m15RBTC : h1RC ? h1RBTC : h4RC ? h4RBTC : dRBTC
float m5RPBP = m15RC ? m15RBPC : h1RC ? h1RBPC : h4RC ? h4RBPC : dRBPC
[m5GC, m5GATC, m5GAPC, m5GBTC, m5GBPC] = f_child(m5GPV, m5GPAT, m5GPAP, m5GPBT, m5GPBP, m5LowT, m5LowP, true, touchTolerance, overlapTolerance, na)
[m5RC, m5RATC, m5RAPC, m5RBTC, m5RBPC] = f_child(m5RPV, m5RPAT, m5RPAP, m5RPBT, m5RPBP, m5HighT, m5HighP, false, touchTolerance, overlapTolerance, na)

