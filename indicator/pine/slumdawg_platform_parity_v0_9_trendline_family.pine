bool show15MRed = input.bool(true, "15M RED", inline = "15M", group = gBoard)
bool show5MGreen = input.bool(true, "5M GREEN", inline = "5M", group = gBoard)
bool show5MRed = input.bool(true, "5M RED", inline = "5M", group = gBoard)

string gRepair = "2B — REPAIR VIOLATED ONLY"
bool repair1Enabled = input.bool(false, "Repair #1", inline = "R1", group = gRepair)
int repair1Time = input.time(0, "time", inline = "R1", group = gRepair, active = repair1Enabled, tooltip = "Set to the bar where you want the selective repair. Valid lines remain untouched.", display = display.none)
bool repair2Enabled = input.bool(false, "Repair #2", inline = "R2", group = gRepair)
int repair2Time = input.time(0, "time", inline = "R2", group = gRepair, active = repair2Enabled, display = display.none)
bool repair3Enabled = input.bool(false, "Repair #3", inline = "R3", group = gRepair)
int repair3Time = input.time(0, "time", inline = "R3", group = gRepair, active = repair3Enabled, display = display.none)

string gResearch = "2C — TRENDLINE RESEARCH GUARDS"
int touchToleranceTicks = input.int(1, "Clean-ray tolerance (ticks)", minval = 0, maxval = 20, group = gResearch, tooltip = "Research/calibration value. Not production-certified.", display = display.none)
int overlapTicks = input.int(8, "Parent/child overlap filter (ticks)", minval = 0, maxval = 100, group = gResearch, tooltip = "Rejects a child whose B remains too close to the parent ray. Research/calibration value.", display = display.none)
int violationPenetrationTicks = input.int(1, "Violation penetration (ticks)", minval = 0, maxval = 20, group = gResearch, display = display.none)
int violationCloses = input.int(2, "Consecutive source-TF closes", minval = 1, maxval = 4, group = gResearch, tooltip = "Slumdawg robustness layer, not attributed to the external trendline teaching.", display = display.none)

string gTest = "3 — PARITY TEST ONLY"
bool enableParityEngine = input.bool(false, "Enable test engine", group = gTest, display = display.none)
string runtimeMode = input.string("STUDY", "Runtime", options = ["STUDY", "LIVE_DECISION_SUPPORT"], group = gTest, display = display.none)
string feedAttestation = input.string("UNKNOWN", "Feed", options = ["UNKNOWN", "REALTIME", "DELAYED"], group = gTest, display = display.none)
