var int dGBreach = 0
var int dRBreach = 0
var int h4GBreach = 0
var int h4RBreach = 0
var int h1GBreach = 0
var int h1RBreach = 0
var int m15GBreach = 0
var int m15RBreach = 0
var int m5GBreach = 0
var int m5RBreach = 0
var bool dGViolated = false
var bool dRViolated = false
var bool h4GViolated = false
var bool h4RViolated = false
var bool h1GViolated = false
var bool h1RViolated = false
var bool m15GViolated = false
var bool m15RViolated = false
var bool m5GViolated = false
var bool m5RViolated = false

bool freezeEvent = not boardInitialized and boardFreezeTime > 0 and time >= boardFreezeTime
if freezeEvent
    boardInitialized := true
    dGreenValid := dGC
    dGAT := dGATC
    dGAP := dGAPC
    dGBT := dGBTC
    dGBP := dGBPC
    dRedValid := dRC
    dRAT := dRATC
    dRAP := dRAPC
    dRBT := dRBTC
    dRBP := dRBPC

    h4GreenValid := h4GC
    h4GAT := h4GATC
    h4GAP := h4GAPC
    h4GBT := h4GBTC
    h4GBP := h4GBPC
    h4RedValid := h4RC
    h4RAT := h4RATC
    h4RAP := h4RAPC
    h4RBT := h4RBTC
    h4RBP := h4RBPC

    h1GreenValid := h1GC
    h1GAT := h1GATC
    h1GAP := h1GAPC
    h1GBT := h1GBTC
    h1GBP := h1GBPC
    h1RedValid := h1RC
    h1RAT := h1RATC
    h1RAP := h1RAPC
    h1RBT := h1RBTC
    h1RBP := h1RBPC

    m15GreenValid := m15GC
    m15GAT := m15GATC
    m15GAP := m15GAPC
    m15GBT := m15GBTC
    m15GBP := m15GBPC
    m15RedValid := m15RC
    m15RAT := m15RATC
    m15RAP := m15RAPC
    m15RBT := m15RBTC
    m15RBP := m15RBPC

    m5GreenValid := m5GC
    m5GAT := m5GATC
    m5GAP := m5GAPC
    m5GBT := m5GBTC
    m5GBP := m5GBPC
    m5RedValid := m5RC
    m5RAT := m5RATC
    m5RAP := m5RAPC
    m5RBT := m5RBTC
    m5RBP := m5RBPC

// -----------------------------------------------------------------------------
// VIOLATION: confirmed closes on each line's own source timeframe.
// -----------------------------------------------------------------------------
[dSourceClose, dSourceCloseTime] = request.security(syminfo.tickerid, "D", [close[1], time_close[1]], lookahead = barmerge.lookahead_on)
[h4SourceClose, h4SourceCloseTime] = request.security(syminfo.tickerid, "240", [close[1], time_close[1]], lookahead = barmerge.lookahead_on)
[h1SourceClose, h1SourceCloseTime] = request.security(syminfo.tickerid, "60", [close[1], time_close[1]], lookahead = barmerge.lookahead_on)
[m15SourceClose, m15SourceCloseTime] = request.security(syminfo.tickerid, "15", [close[1], time_close[1]], lookahead = barmerge.lookahead_on)
[m5SourceClose, m5SourceCloseTime] = request.security(syminfo.tickerid, "5", [close[1], time_close[1]], lookahead = barmerge.lookahead_on)
bool newDSourceClose = ta.change(dSourceCloseTime) != 0
bool newH4SourceClose = ta.change(h4SourceCloseTime) != 0
bool newH1SourceClose = ta.change(h1SourceCloseTime) != 0
bool newM15SourceClose = ta.change(m15SourceCloseTime) != 0
bool newM5SourceClose = ta.change(m5SourceCloseTime) != 0

f_violation(bool valid, bool bullish, int aT, float aP, int bT, float bP, bool isNewClose, int sourceCloseTime, float sourceClose, int streak, bool violated) =>
    int nextStreak = streak
    bool nextViolated = violated
    if valid and isNewClose and not na(sourceCloseTime) and sourceCloseTime > bT and not violated
        float linePrice = f_line_at(aT, aP, bT, bP, sourceCloseTime)
        bool adverse = bullish ? sourceClose < linePrice - violationPenetration : sourceClose > linePrice + violationPenetration
        if adverse
            nextStreak += 1
            if nextStreak >= violationCloses
                nextViolated := true
        else
            nextStreak := 0
    [nextStreak, nextViolated]

if boardInitialized
    [nextDGBreach, nextDGViolated] = f_violation(dGreenValid, true, dGAT, dGAP, dGBT, dGBP, newDSourceClose, dSourceCloseTime, dSourceClose, dGBreach, dGViolated)
    dGBreach := nextDGBreach
    dGViolated := nextDGViolated
    [nextDRBreach, nextDRViolated] = f_violation(dRedValid, false, dRAT, dRAP, dRBT, dRBP, newDSourceClose, dSourceCloseTime, dSourceClose, dRBreach, dRViolated)
    dRBreach := nextDRBreach
    dRViolated := nextDRViolated
    [nextH4GBreach, nextH4GViolated] = f_violation(h4GreenValid, true, h4GAT, h4GAP, h4GBT, h4GBP, newH4SourceClose, h4SourceCloseTime, h4SourceClose, h4GBreach, h4GViolated)
    h4GBreach := nextH4GBreach
    h4GViolated := nextH4GViolated
    [nextH4RBreach, nextH4RViolated] = f_violation(h4RedValid, false, h4RAT, h4RAP, h4RBT, h4RBP, newH4SourceClose, h4SourceCloseTime, h4SourceClose, h4RBreach, h4RViolated)
    h4RBreach := nextH4RBreach
    h4RViolated := nextH4RViolated
    [nextH1GBreach, nextH1GViolated] = f_violation(h1GreenValid, true, h1GAT, h1GAP, h1GBT, h1GBP, newH1SourceClose, h1SourceCloseTime, h1SourceClose, h1GBreach, h1GViolated)
    h1GBreach := nextH1GBreach
    h1GViolated := nextH1GViolated
    [nextH1RBreach, nextH1RViolated] = f_violation(h1RedValid, false, h1RAT, h1RAP, h1RBT, h1RBP, newH1SourceClose, h1SourceCloseTime, h1SourceClose, h1RBreach, h1RViolated)
    h1RBreach := nextH1RBreach
    h1RViolated := nextH1RViolated
    [nextM15GBreach, nextM15GViolated] = f_violation(m15GreenValid, true, m15GAT, m15GAP, m15GBT, m15GBP, newM15SourceClose, m15SourceCloseTime, m15SourceClose, m15GBreach, m15GViolated)
    m15GBreach := nextM15GBreach
    m15GViolated := nextM15GViolated
    [nextM15RBreach, nextM15RViolated] = f_violation(m15RedValid, false, m15RAT, m15RAP, m15RBT, m15RBP, newM15SourceClose, m15SourceCloseTime, m15SourceClose, m15RBreach, m15RViolated)
    m15RBreach := nextM15RBreach
    m15RViolated := nextM15RViolated
    [nextM5GBreach, nextM5GViolated] = f_violation(m5GreenValid, true, m5GAT, m5GAP, m5GBT, m5GBP, newM5SourceClose, m5SourceCloseTime, m5SourceClose, m5GBreach, m5GViolated)
    m5GBreach := nextM5GBreach
    m5GViolated := nextM5GViolated
    [nextM5RBreach, nextM5RViolated] = f_violation(m5RedValid, false, m5RAT, m5RAP, m5RBT, m5RBP, newM5SourceClose, m5SourceCloseTime, m5SourceClose, m5RBreach, m5RViolated)
    m5RBreach := nextM5RBreach
    m5RViolated := nextM5Violated

// -----------------------------------------------------------------------------
// SELECTIVE REPAIR EVENTS. Valid lines are never assigned inside this block.
// -----------------------------------------------------------------------------
var bool repair1Applied = false
var bool repair2Applied = false
var bool repair3Applied = false
bool fireRepair1 = boardInitialized and repair1Enabled and not repair1Applied and repair1Time > boardFreezeTime and time >= repair1Time
bool fireRepair2 = boardInitialized and repair2Enabled and not repair2Applied and repair2Time > boardFreezeTime and time >= repair2Time
bool fireRepair3 = boardInitialized and repair3Enabled and not repair3Applied and repair3Time > boardFreezeTime and time >= repair3Time
bool repairEvent = fireRepair1 or fireRepair2 or fireRepair3
var int lastRepairReplaced = 0

if repairEvent
    int replaced = 0

    if dGreenValid and dGViolated
        [rv, raT, raP, rbT, rbP] = f_root(dLowT, dLowP, true, touchTolerance, dGBT)
        if rv
            dGAT := raT
            dGAP := raP
            dGBT := rbT
            dGBP := rbP
            dGBreach := 0
            dGViolated := false
            replaced += 1
    if dRedValid and dRViolated
        [rv, raT, raP, rbT, rbP] = f_root(dHighT, dHighP, false, touchTolerance, dRBT)
        if rv
            dRAT := raT
            dRAP := raP
            dRBT := rbT
            dRBP := rbP
            dRBreach := 0
            dRViolated := false
            replaced += 1

    bool h4GPActive = dGreenValid and not dGViolated
    bool h4RPActive = dRedValid and not dRViolated
    if h4GreenValid and h4GViolated and h4GPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, dGAT, dGAP, dGBT, dGBP, h4LowT, h4LowP, true, touchTolerance, overlapTolerance, h4GBT)
        if rv
            h4GAT := raT
            h4GAP := raP
            h4GBT := rbT
            h4GBP := rbP
            h4GBreach := 0
            h4GViolated := false
            replaced += 1
    if h4RedValid and h4RViolated and h4RPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, dRAT, dRAP, dRBT, dRBP, h4HighT, h4HighP, false, touchTolerance, overlapTolerance, h4RBT)
        if rv
            h4RAT := raT
            h4RAP := raP
            h4RBT := rbT
            h4RBP := rbP
            h4RBreach := 0
            h4RViolated := false
            replaced += 1

    bool h1GPActive = (h4GreenValid and not h4GViolated) or (dGreenValid and not dGViolated)
    int h1PAT = h4GreenValid and not h4GViolated ? h4GAT : dGAT
    float h1PAP = h4GreenValid and not h4GViolated ? h4GAP : dGAP
    int h1PBT = h4GreenValid and not h4GViolated ? h4GBT : dGBT
    float h1PBP = h4GreenValid and not h4GViolated ? h4GBP : dGBP
    bool h1RPActive = (h4RedValid and not h4RViolated) or (dRedValid and not dRViolated)
    int h1R_PAT = h4RedValid and not h4RViolated ? h4RAT : dRAT
    float h1R_PAP = h4RedValid and not h4RViolated ? h4RAP : dRAP
    int h1R_PBT = h4RedValid and not h4RViolated ? h4RBT : dRBT
    float h1R_PBP = h4RedValid and not h4RViolated ? h4RBP : dRBP
    if h1GreenValid and h1GViolated and h1GPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, h1PAT, h1PAP, h1PBT, h1PBP, h1LowT, h1LowP, true, touchTolerance, overlapTolerance, h1GBT)
        if rv
            h1GAT := raT
            h1GAP := raP
            h1GBT := rbT
            h1GBP := rbP
            h1GBreach := 0
            h1GViolated := false
            replaced += 1
    if h1RedValid and h1RViolated and h1RPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, h1R_PAT, h1R_PAP, h1R_PBT, h1R_PBP, h1HighT, h1HighP, false, touchTolerance, overlapTolerance, h1RBT)
        if rv
            h1RAT := raT
            h1RAP := raP
            h1RBT := rbT
            h1RBP := rbP
            h1RBreach := 0
            h1RViolated := false
            replaced += 1

    bool m15GPActive = (h1GreenValid and not h1GViolated) or (h4GreenValid and not h4GViolated) or (dGreenValid and not dGViolated)
    int m15PAT = h1GreenValid and not h1GViolated ? h1GAT : h4GreenValid and not h4GViolated ? h4GAT : dGAT
    float m15PAP = h1GreenValid and not h1GViolated ? h1GAP : h4GreenValid and not h4GViolated ? h4GAP : dGAP
    int m15PBT = h1GreenValid and not h1GViolated ? h1GBT : h4GreenValid and not h4GViolated ? h4GBT : dGBT
    float m15PBP = h1GreenValid and not h1GViolated ? h1GBP : h4GreenValid and not h4GViolated ? h4GBP : dGBP
    bool m15RPActive = (h1RedValid and not h1RViolated) or (h4RedValid and not h4RViolated) or (dRedValid and not dRViolated)
    int m15R_PAT = h1RedValid and not h1RViolated ? h1RAT : h4RedValid and not h4RViolated ? h4RAT : dRAT
    float m15R_PAP = h1RedValid and not h1RViolated ? h1RAP : h4RedValid and not h4RViolated ? h4RAP : dRAP
    int m15R_PBT = h1RedValid and not h1RViolated ? h1RBT : h4RedValid and not h4RViolated ? h4RBT : dRBT
    float m15R_PBP = h1RedValid and not h1RViolated ? h1RBP : h4RedValid and not h4RViolated ? h4RBP : dRBP
    if m15GreenValid and m15GViolated and m15GPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, m15PAT, m15PAP, m15PBT, m15PBP, m15LowT, m15LowP, true, touchTolerance, overlapTolerance, m15GBT)
        if rv
            m15GAT := raT
            m15GAP := raP
            m15GBT := rbT
            m15GBP := rbP
            m15GBreach := 0
            m15GViolated := false
            replaced += 1
    if m15RedValid and m15RViolated and m15RPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, m15R_PAT, m15R_PAP, m15R_PBT, m15R_PBP, m15HighT, m15HighP, false, touchTolerance, overlapTolerance, m15RBT)
        if rv
            m15RAT := raT
            m15RAP := raP
            m15RBT := rbT
            m15RBP := rbP
            m15RBreach := 0
            m15RViolated := false
            replaced += 1

    bool m5GPActive = (m15GreenValid and not m15GViolated) or (h1GreenValid and not h1GViolated) or (h4GreenValid and not h4GViolated) or (dGreenValid and not dGViolated)
    int m5PAT = m15GreenValid and not m15GViolated ? m15GAT : h1GreenValid and not h1GViolated ? h1GAT : h4GreenValid and not h4GViolated ? h4GAT : dGAT
    float m5PAP = m15GreenValid and not m15GViolated ? m15GAP : h1GreenValid and not h1GViolated ? h1GAP : h4GreenValid and not h4GViolated ? h4GAP : dGAP
    int m5PBT = m15GreenValid and not m15GViolated ? m15GBT : h1GreenValid and not h1GViolated ? h1GBT : h4GreenValid and not h4GViolated ? h4GBT : dGBT
    float m5PBP = m15GreenValid and not m15GViolated ? m15GBP : h1GreenValid and not h1GViolated ? h1GBP : h4GreenValid and not h4GViolated ? h4GBP : dGBP
    bool m5RPActive = (m15RedValid and not m15RViolated) or (h1RedValid and not h1RViolated) or (h4RedValid and not h4RViolated) or (dRedValid and not dRViolated)
    int m5R_PAT = m15RedValid and not m15RViolated ? m15RAT : h1RedValid and not h1RViolated ? h1RAT : h4RedValid and not h4RViolated ? h4RAT : dRAT
    float m5R_PAP = m15RedValid and not m15RViolated ? m15RAP : h1RedValid and not h1RViolated ? h1RAP : h4RedValid and not h4RViolated ? h4RAP : dRAP
    int m5R_PBT = m15RedValid and not m15RViolated ? m15RBT : h1RedValid and not h1RViolated ? h1RBT : h4RedValid and not h4RViolated ? h4RBT : dRBT
    float m5R_PBP = m15RedValid and not m15RViolated ? m15RBP : h1RedValid and not h1RViolated ? h1RBP : h4RedValid and not h4RViolated ? h4RBP : dRBP
    if m5GreenValid and m5GViolated and m5GPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, m5PAT, m5PAP, m5PBT, m5PBP, m5LowT, m5LowP, true, touchTolerance, overlapTolerance, m5GBT)
        if rv
            m5GAT := raT
            m5GAP := raP
            m5GBT := rbT
            m5GBP := rbP
            m5GBreach := 0
            m5GViolated := false
            replaced += 1
    if m5RedValid and m5RViolated and m5RPActive
        [rv, raT, raP, rbT, rbP] = f_child(true, m5R_PAT, m5R_PAP, m5R_PBT, m5R_PBP, m5HighT, m5HighP, false, touchTolerance, overlapTolerance, m5RBT)
        if rv
            m5RAT := raT
            m5RAP := raP
            m5RBT := rbT
            m5RBP := rbP
            m5RBreach := 0
            m5RViolated := false
            replaced += 1

    lastRepairReplaced := replaced
    if fireRepair1
        repair1Applied := true
    if fireRepair2
        repair2Applied := true
    if fireRepair3
        repair3Applied := true

// -----------------------------------------------------------------------------
// CURRENT LINE PROJECTIONS / NEXT WALL — violated lines stay visible but are not walls.
// -----------------------------------------------------------------------------
int projectionTime = time_close
float dGreenNow = dGreenValid ? f_line_at(dGAT, dGAP, dGBT, dGBP, projectionTime) : na
float dRedNow = dRedValid ? f_line_at(dRAT, dRAP, dRBT, dRBP, projectionTime) : na
float h4GreenNow = h4GreenValid ? f_line_at(h4GAT, h4GAP, h4GBT, h4GBP, projectionTime) : na
float h4RedNow = h4RedValid ? f_line_at(h4RAT, h4RAP, h4RBT, h4RBP, projectionTime) : na
float h1GreenNow = h1GreenValid ? f_line_at(h1GAT, h1GAP, h1GBT, h1GBP, projectionTime) : na
float h1RedNow = h1RedValid ? f_line_at(h1RAT, h1RAP, h1RBT, h1RBP, projectionTime) : na
float m15GreenNow = m15GreenValid ? f_line_at(m15GAT, m15GAP, m15GBT, m15GBP, projectionTime) : na
float m15RedNow = m15RedValid ? f_line_at(m15RAT, m15RAP, m15RBT, m15RBP, projectionTime) : na
float m5GreenNow = m5GreenValid ? f_line_at(m5GAT, m5GAP, m5GBT, m5GBP, projectionTime) : na
float m5RedNow = m5RedValid ? f_line_at(m5RAT, m5RAP, m5RBT, m5RBP, projectionTime) : na

int activeTlCount = (dGreenValid ? 1 : 0) + (dRedValid ? 1 : 0) + (h4GreenValid ? 1 : 0) + (h4RedValid ? 1 : 0) + (h1GreenValid ? 1 : 0) + (h1RedValid ? 1 : 0) + (m15GreenValid ? 1 : 0) + (m15RedValid ? 1 : 0) + (m5GreenValid ? 1 : 0) + (m5RedValid ? 1 : 0)
int violatedCount = (dGViolated ? 1 : 0) + (dRViolated ? 1 : 0) + (h4GViolated ? 1 : 0) + (h4RViolated ? 1 : 0) + (h1GViolated ? 1 : 0) + (h1RViolated ? 1 : 0) + (m15GViolated ? 1 : 0) + (m15RViolated ? 1 : 0) + (m5GViolated ? 1 : 0) + (m5RViolated ? 1 : 0)

array<string> wallNames = array.new_string()
array<float> wallPrices = array.new_float()
f_add_wall(bool condition, string name, float price) =>
    if condition and not na(price)
        array.push(wallNames, name)
        array.push(wallPrices, price)

if planSide == "LONG"
    f_add_wall(dRedValid and not dRViolated and dRedNow > close, "D RED", dRedNow)
    f_add_wall(h4RedValid and not h4RViolated and h4RedNow > close, "4H RED", h4RedNow)
    f_add_wall(h1RedValid and not h1RViolated and h1RedNow > close, "1H RED", h1RedNow)
    f_add_wall(m15RedValid and not m15RViolated and m15RedNow > close, "15M RED", m15RedNow)
    f_add_wall(m5RedValid and not m5RViolated and m5RedNow > close, "5M RED", m5RedNow)
    f_add_wall(showPdh and pdh > close, "PDH", pdh)
    f_add_wall(showPwh and pwh > close, "PWH", pwh)
else
    f_add_wall(dGreenValid and not dGViolated and dGreenNow < close, "D GREEN", dGreenNow)
    f_add_wall(h4GreenValid and not h4GViolated and h4GreenNow < close, "4H GREEN", h4GreenNow)
    f_add_wall(h1GreenValid and not h1GViolated and h1GreenNow < close, "1H GREEN", h1GreenNow)
    f_add_wall(m15GreenValid and not m15GViolated and m15GreenNow < close, "15M GREEN", m15GreenNow)
    f_add_wall(m5GreenValid and not m5GViolated and m5GreenNow < close, "5M GREEN", m5GreenNow)
    f_add_wall(showPdl and pdl < close, "PDL", pdl)
    f_add_wall(showPwl and pwl < close, "PWL", pwl)

string nextWallName = "NONE AHEAD"
float nextWallPrice = na
float nextWallDistance = HUGE_DISTANCE
if array.size(wallPrices) > 0
    for i = 0 to array.size(wallPrices) - 1
        float p = array.get(wallPrices, i)
        float dist = math.abs(p - close)
        if dist < nextWallDistance
            nextWallDistance := dist
            nextWallName := array.get(wallNames, i)
            nextWallPrice := p
string nextWallText = na(nextWallPrice) ? nextWallName : nextWallName + " @ " + str.tostring(nextWallPrice, format.mintick)

// -----------------------------------------------------------------------------
// DRAWINGS — no timeframe labels on trendline rays.
// -----------------------------------------------------------------------------
var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pwhLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pwlLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line goDraw = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.right)
var label pdhLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pdlLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pwhLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pwlLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label goLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var box targetBox = na
var label targetLabel = na

f_sync_level(line id, label lid, float price, string name, color c, bool visible, int width, bool fullSpan) =>
    if visible and not na(price) and price > 0
        line.set_xy1(id, math.max(0, bar_index - 1), price)
        line.set_xy2(id, bar_index + 1, price)
        line.set_extend(id, fullSpan ? extend.both : extend.right)
        line.set_color(id, c)
        line.set_width(id, width)
        label.set_xy(lid, bar_index + 3, price)
        label.set_text(lid, name + "  " + str.tostring(price, format.mintick))
        label.set_color(lid, c)
        label.set_textcolor(lid, name == "GO LINE" ? color.black : color.white)
        label.set_size(lid, size.large)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

var line dGreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line dRedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)

f_sync_trend(line id, bool valid, bool visible, int aT, float aP, int bT, float bP, color c) =>
    if valid and visible and not na(aT) and not na(bT) and aP > 0 and bP > 0
        line.set_xy1(id, aT, aP)
        line.set_xy2(id, bT, bP)
        line.set_extend(id, extend.right)
        line.set_color(id, c)
        line.set_width(id, 2)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)

bool goSet = goLine > 0
float goTicks = goSet ? goLine / syminfo.mintick : na
bool goOnGrid = goSet and math.abs(goTicks - math.round(goTicks)) < 1e-7
bool targetSet = safeTargetLow > 0 and safeTargetHigh > safeTargetLow
float targetLowTicks = targetSet ? safeTargetLow / syminfo.mintick : na
float targetHighTicks = targetSet ? safeTargetHigh / syminfo.mintick : na
bool targetOnGrid = targetSet and math.abs(targetLowTicks - math.round(targetLowTicks)) < 1e-7 and math.abs(targetHighTicks - math.round(targetHighTicks)) < 1e-7

if barstate.islast
    f_sync_level(pdhLine, pdhLabel, pdh, "PDH", BLUE_DAY, showPdh, 2, true)
    f_sync_level(pdlLine, pdlLabel, pdl, "PDL", BLUE_DAY, showPdl, 2, true)
    f_sync_level(pwhLine, pwhLabel, pwh, "PWH", BLUE_WEEK, showPwh, 2, true)
    f_sync_level(pwlLine, pwlLabel, pwl, "PWL", BLUE_WEEK, showPwl, 2, true)
    f_sync_level(goDraw, goLabel, goLine, "GO LINE", YELLOW_GO, showGoLine and goSet and goOnGrid, 4, false)

    f_sync_trend(dGreenLine, dGreenValid, showDGreen, dGAT, dGAP, dGBT, dGBP, GREEN_UP)
    f_sync_trend(dRedLine, dRedValid, showDRed, dRAT, dRAP, dRBT, dRBP, RED_DOWN)
    f_sync_trend(h4GreenLine, h4GreenValid, show4HGreen, h4GAT, h4GAP, h4GBT, h4GBP, GREEN_UP)
    f_sync_trend(h4RedLine, h4RedValid, show4HRed, h4RAT, h4RAP, h4RBT, h4RBP, RED_DOWN)
    f_sync_trend(h1GreenLine, h1GreenValid, show1HGreen, h1GAT, h1GAP, h1GBT, h1GBP, GREEN_UP)
    f_sync_trend(h1RedLine, h1RedValid, show1HRed, h1RAT, h1RAP, h1RBT, h1RBP, RED_DOWN)
    f_sync_trend(m15GreenLine, m15GreenValid, show15MGreen, m15GAT, m15GAP, m15GBT, m15GBP, GREEN_UP)
    f_sync_trend(m15RedLine, m15RedValid, show15MRed, m15RAT, m15RAP, m15RBT, m15RBP, RED_DOWN)
    f_sync_trend(m5GreenLine, m5GreenValid, show5MGreen, m5GAT, m5GAP, m5GBT, m5GBP, GREEN_UP)
    f_sync_trend(m5RedLine, m5RedValid, show5MRed, m5RAT, m5RAP, m5RBT, m5RBP, RED_DOWN)

    bool targetVisible = showSafeTarget and targetSet and targetOnGrid
    if targetVisible
        int boxLeft = math.max(0, bar_index - 35)
        int boxRight = bar_index + 10
        if na(targetBox)
            targetBox := box.new(boxLeft, safeTargetHigh, boxRight, safeTargetLow, xloc = xloc.bar_index, border_color = BLUE_TARGET, bgcolor = color.new(BLUE_TARGET, 84), border_width = 2)
        else
            box.set_lefttop(targetBox, boxLeft, safeTargetHigh)
            box.set_rightbottom(targetBox, boxRight, safeTargetLow)
        float targetMid = (safeTargetHigh + safeTargetLow) / 2.0
        if na(targetLabel)
            targetLabel := label.new(bar_index + 3, targetMid, "SAFE TARGET", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = BLUE_TARGET, textcolor = color.white, size = size.large)
        else
            label.set_xy(targetLabel, bar_index + 3, targetMid)
    else
        if not na(targetBox)
            box.delete(targetBox)
            targetBox := na
        if not na(targetLabel)
            label.delete(targetLabel)
            targetLabel := na

// -----------------------------------------------------------------------------
// BEGINNER SEMANTICS / RUNTIME GUARDS
// -----------------------------------------------------------------------------
bool directionKnown = bigDirection != "NOT SET"
bool planWithDirection = directionKnown and ((bigDirection == "UP" and planSide == "LONG") or (bigDirection == "DOWN" and planSide == "SHORT"))
string currentMoveText = not directionKnown ? "WAITING FOR DIRECTION" : planWithDirection ? (planSide == "LONG" ? "UP WITH BIG DIRECTION" : "DOWN WITH BIG DIRECTION") : (planSide == "LONG" ? "TEMPORARY UP MOVE" : "TEMPORARY DOWN MOVE")
string safeTargetText = targetSet and targetOnGrid ? str.tostring(safeTargetLow, format.mintick) + " – " + str.tostring(safeTargetHigh, format.mintick) : "NOT SET"
string trendlineText = not boardInitialized ? "SET FREEZE POINT" : str.tostring(activeTlCount) + " LOCKED" + (violatedCount > 0 ? " | " + str.tostring(violatedCount) + " VIOLATED" : "")

bool liveFeedAttested = feedAttestation == "REALTIME"
bool delayedLiveBlock = runtimeMode == "LIVE_DECISION_SUPPORT" and not liveFeedAttested
bool contextValid = isFiveMinute and isNqMnq and tickGridExpected and goSet and goOnGrid and not extendedClosedGap
bool engineRuntimeAllowed = enableParityEngine and contextValid and not delayedLiveBlock
string runtimeReason =
     not boardInitialized ? "CLICK BOARD FREEZE POINT" :
     not isNqMnq ? "USE NQ OR MNQ" :
     not isFiveMinute ? "CHANGE CHART TO 5 MIN" :
     not tickGridExpected ? "TICK DATA CHECK NEEDED" :
     extendedClosedGap ? "EXTENDED CLOSE — VERIFY LEVELS" :
     not goSet ? "SET YELLOW GO LINE" :
     not goOnGrid ? "GO LINE MUST BE .00/.25/.50/.75" :
     targetSet and not targetOnGrid ? "SAFE TARGET TICK CHECK" :
     delayedLiveBlock ? "LIVE FEED NOT CONFIRMED" :
     not enableParityEngine ? "TEST ENGINE OFF" :
     not exactIntrabarAvailable ? "WAITING FOR LIVE 5M CANDLE" :
     "TEST ENGINE RUNNING"

// -----------------------------------------------------------------------------
// EXISTING TEST-ONLY 5M MOMENTUM STATE MACHINE (unchanged semantics).
// -----------------------------------------------------------------------------
f_is_doji_like(float o, float h, float l, float c, float threshold) =>
    float r = h - l
    r <= 0.0 ? true : math.abs(c - o) / r <= threshold

const string WAIT_REFERENCE = "WAIT_REFERENCE"
const string WAIT_BREAK = "WAIT_BREAK"
const string BREAK_STAGE = "BREAK"
const string PUSH_1 = "PUSH_1"
const string ENTRY_READY = "ENTRY_READY"
varip string stage = WAIT_REFERENCE
varip bool referenceArmed = false
varip float reference = na
varip float anchor = na
varip int referenceSourceBar = na
varip int lastStageTimeMs = na
varip string lastTransition = "NONE"

bool eventBreak = false
bool eventPush1 = false
bool eventReady = false
bool eventRecoil = false
float direction = planSide == "LONG" ? 1.0 : -1.0
float favorable = direction * close
float referenceFav = direction * reference
float anchorFav = direction * anchor

if engineRuntimeAllowed and exactIntrabarAvailable and referenceArmed and bar_index > referenceSourceBar and stage != ENTRY_READY
    bool recoilEligible = stage == BREAK_STAGE or stage == PUSH_1
    float recoil = recoilEligible and not na(anchor) ? anchorFav - favorable : 0.0
    if recoilEligible and recoil >= maxRecoil
        stage := WAIT_BREAK
        anchor := reference
        lastStageTimeMs := na
        lastTransition := "RECOIL — START OVER"
        eventRecoil := true
    else if stage == WAIT_BREAK
        if favorable >= referenceFav + minBreak
            stage := BREAK_STAGE
            anchor := close
            lastStageTimeMs := timenow
            lastTransition := "BREAK"
            eventBreak := true
    else if stage == BREAK_STAGE
        if favorable >= anchorFav + minPush
            float sec1 = na(lastStageTimeMs) ? 0.0 : (timenow - lastStageTimeMs) / 1000.0
            if sec1 <= maxPushSeconds
                stage := PUSH_1
                anchor := close
                lastStageTimeMs := timenow
                lastTransition := "PUSH 1"
                eventPush1 := true
    else if stage == PUSH_1
        if favorable >= anchorFav + minPush
            float sec2 = na(lastStageTimeMs) ? 0.0 : (timenow - lastStageTimeMs) / 1000.0
            if sec2 <= maxPushSeconds
                stage := ENTRY_READY
                anchor := close
                lastStageTimeMs := timenow
                lastTransition := "READY — TEST ONLY"
                eventReady := true

if engineRuntimeAllowed and exactIntrabarAvailable and barstate.isconfirmed
    bool beyondGo = planSide == "LONG" ? close > goLine : close < goLine
    if not referenceArmed and beyondGo
        if not f_is_doji_like(open, high, low, close, dojiBodyFraction)
            reference := planSide == "LONG" ? high : low
            anchor := reference
            referenceSourceBar := bar_index
            referenceArmed := true
            stage := WAIT_BREAK
            lastStageTimeMs := na
            lastTransition := "REFERENCE CANDLE SET"
    else if referenceArmed and bar_index > referenceSourceBar and stage != ENTRY_READY
        reference := planSide == "LONG" ? high : low
        anchor := reference
        referenceSourceBar := bar_index
        stage := WAIT_BREAK
        lastStageTimeMs := na
        lastTransition := "NEW CANDLE — RESET TEST"

if not contextValid or delayedLiveBlock or not enableParityEngine
    stage := WAIT_REFERENCE
    referenceArmed := false
    reference := na
    anchor := na
    referenceSourceBar := na
    lastStageTimeMs := na
    lastTransition := runtimeReason

string stageText =
     stage == WAIT_REFERENCE ? "1  WAIT FOR CANDLE PAST GO LINE" :
     stage == WAIT_BREAK ? "2  REFERENCE SET — WAIT FOR BREAK" :
     stage == BREAK_STAGE ? "3  BREAK — WATCH PUSH 1" :
     stage == PUSH_1 ? "4  PUSH 1 — WATCH PUSH 2" :
     "5  READY — TEST ONLY"

// -----------------------------------------------------------------------------
// PREMIUM BEGINNER COACH
// -----------------------------------------------------------------------------
color bigDirectionColor = bigDirection == "UP" ? GREEN_UP : bigDirection == "DOWN" ? RED_DOWN : color.gray
color moveColor = not directionKnown ? color.gray : planSide == "LONG" ? GREEN_UP : RED_DOWN
color stageColor = stage == ENTRY_READY ? GREEN_UP : stage == PUSH_1 ? color.aqua : stage == BREAK_STAGE ? YELLOW_GO : ORANGE_WAIT
var table coach = table.new(position.top_right, 2, 9, border_width = 2, frame_width = 2, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)
if barstate.islast
    if showCoach
        table.cell(coach, 0, 0, "SLUMDAWG", text_color = color.lime, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 1, 0, "5M COACH", text_color = color.white, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 0, 1, "BIG DIRECTION", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 1, bigDirection, text_color = color.white, bgcolor = bigDirectionColor, text_size = 16)
        table.cell(coach, 0, 2, "CURRENT MOVE", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 2, currentMoveText, text_color = color.white, bgcolor = moveColor, text_size = 15)
        table.cell(coach, 0, 3, "TRENDLINES", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 3, trendlineText, text_color = violatedCount > 0 ? color.orange : activeTlCount > 0 ? color.lime : color.orange, text_size = 13)
        table.cell(coach, 0, 4, "NEXT WALL", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 4, nextWallText, text_color = color.orange, text_size = 14)
        table.cell(coach, 0, 5, "GO LINE", text_color = color.black, bgcolor = YELLOW_GO, text_size = 15)
        table.cell(coach, 1, 5, goSet ? str.tostring(goLine, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 16)
        table.cell(coach, 0, 6, "SAFE TARGET", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 1, 6, safeTargetText, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 0, 7, "NOW", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 7, stageText, text_color = color.black, bgcolor = stageColor, text_size = 15)
        table.cell(coach, 0, 8, "SYSTEM", text_color = color.white, text_size = 14)
        string repairSuffix = lastRepairReplaced > 0 ? " | REPAIRED " + str.tostring(lastRepairReplaced) : ""
        table.cell(coach, 1, 8, runtimeReason + " | " + chartStatus + repairSuffix, text_color = runtimeReason == "TEST ENGINE RUNNING" ? color.lime : color.orange, text_size = 13)
    else
        for r = 0 to 8
            table.cell(coach, 0, r, "")
            table.cell(coach, 1, r, "")

plotshape(showDebugMarkers and eventBreak, title = "Break", text = "BREAK", style = shape.labelup, location = location.belowbar, size = size.tiny, color = YELLOW_GO, textcolor = color.black)
plotshape(showDebugMarkers and eventPush1, title = "Push 1", text = "P1", style = shape.labelup, location = location.belowbar, size = size.tiny, color = color.aqua, textcolor = color.black)
plotshape(showDebugMarkers and eventReady, title = "Ready", text = "READY", style = shape.labelup, location = location.belowbar, size = size.tiny, color = GREEN_UP, textcolor = color.white)
plotshape(showDebugMarkers and eventRecoil, title = "Recoil reset", text = "RESET", style = shape.labeldown, location = location.abovebar, size = size.tiny, color = RED_DOWN, textcolor = color.white)

alertcondition(eventBreak, "PARITY DEBUG — BREAK", "NON-ACTIONABLE parity event: BREAK")
alertcondition(eventPush1, "PARITY DEBUG — PUSH_1", "NON-ACTIONABLE parity event: PUSH_1")
alertcondition(eventReady, "PARITY DEBUG — ENTRY_READY", "NON-ACTIONABLE parity event: ENTRY_READY")
alertcondition(eventRecoil, "PARITY DEBUG — RECOIL_RESET", "NON-ACTIONABLE parity event: RECOIL_RESET")