//@version=6
indicator("Slumdawg traders indicator", shorttitle = "SLUMDAWG", overlay = true, scale = scale.none, behind_chart = true, max_labels_count = 100, max_lines_count = 200, max_boxes_count = 20, calc_bars_count = 1000, dynamic_requests = true)

// v0.10.4 BUFFER-SAFE CANONICAL BOARD
// PLATFORM PARITY / RESEARCH ONLY. NOT LIVE-DECISION-SUPPORT APPROVED.
// Fixes v0.10.3 runtime history-buffer failure by explicitly sizing only the
// built-in series that dynamic geometry offsets access inside requested contexts.
const bool LIVE_DECISION_SUPPORT_APPROVED = false
const float EXPECTED_TICK = 0.25
const float HUGE_DISTANCE = 1e12
const int NORMAL_CLOSED_GAP_MS = 72 * 60 * 60 * 1000
const int FREEZE_PADDING = 320
const int SAFE_HISTORY_BUFFER = 1000
const int MAX_B_CANDIDATES = 12
const int RECENT_5M_AUDIT_BARS = 600

// -----------------------------------------------------------------------------
// DATA TYPES
// -----------------------------------------------------------------------------
type TlPair
    bool gV
    int gAT
    float gAP
    int gBT
    float gBP
    bool rV
    int rAT
    float rAP
    int rBT
    float rBP

type Board
    float pdh
    float pdl
    float pwh
    float pwl
    bool levelsVerify
    TlPair m
    TlPair w
    TlPair d
    TlPair h4
    TlPair h1
    TlPair m15
    TlPair m5

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
string gSetup = "1 - SETUP"
string bigDirection = input.string("NOT SET", "BIG DIRECTION", options = ["UP", "DOWN", "NOT SET"], group = gSetup, display = display.none)
string planSide = input.string("LONG", "PLAN", options = ["LONG", "SHORT"], group = gSetup, display = display.none)
float goLine = input.price(0.0, "GO LINE (yellow)", group = gSetup, display = display.none)
float safeTargetLow = input.price(0.0, "SAFE TARGET lower edge", group = gSetup, display = display.none)
float safeTargetHigh = input.price(0.0, "SAFE TARGET upper edge", group = gSetup, display = display.none)

string gView = "2 - DISPLAY"
bool showCoach = input.bool(true, "Show Slumdawg coach", group = gView)
bool showWeeklyLevels = input.bool(true, "Show PWH/PWL when near", group = gView)
bool showGoLine = input.bool(true, "Show yellow GO LINE", group = gView)
bool showSafeTarget = input.bool(true, "Show blue SAFE TARGET", group = gView)

string gBoard = "2A - FROZEN TRENDLINE BOARD"
int boardFreezeTime = input.time(0, "Build/freeze board at", group = gBoard, confirm = true, tooltip = "Choose the current bar once. The board is reconstructed in a canonical 5-minute engine so changing chart timeframe cannot rebuild it.", display = display.none)
bool showMGreen = input.bool(true, "Monthly GREEN", inline = "M", group = gBoard)
bool showMRed = input.bool(true, "Monthly RED", inline = "M", group = gBoard)
bool showWGreen = input.bool(true, "Weekly GREEN", inline = "W", group = gBoard)
bool showWRed = input.bool(true, "Weekly RED", inline = "W", group = gBoard)
bool showDGreen = input.bool(true, "Daily GREEN", inline = "D", group = gBoard)
bool showDRed = input.bool(true, "Daily RED", inline = "D", group = gBoard)
bool show4HGreen = input.bool(true, "4H GREEN", inline = "4H", group = gBoard)
bool show4HRed = input.bool(true, "4H RED", inline = "4H", group = gBoard)
bool show1HGreen = input.bool(true, "1H GREEN", inline = "1H", group = gBoard)
bool show1HRed = input.bool(true, "1H RED", inline = "1H", group = gBoard)
bool show15MGreen = input.bool(true, "15M GREEN", inline = "15M", group = gBoard)
bool show15MRed = input.bool(true, "15M RED", inline = "15M", group = gBoard)
bool show5MGreen = input.bool(true, "5M GREEN", inline = "5M", group = gBoard)
bool show5MRed = input.bool(true, "5M RED", inline = "5M", group = gBoard)

string gResearch = "2B - TRENDLINE RESEARCH GUARDS"
int monthlyLookback = input.int(60, "Monthly structural bars", minval = 12, maxval = 120, group = gResearch, display = display.none)
int weeklyLookback = input.int(104, "Weekly structural bars", minval = 20, maxval = 260, group = gResearch, display = display.none)
int dailyLookback = input.int(180, "Daily structural bars", minval = 30, maxval = 500, group = gResearch, display = display.none)
int h4Lookback = input.int(240, "4H structural bars", minval = 40, maxval = 600, group = gResearch, display = display.none)
int h1Lookback = input.int(320, "1H structural bars", minval = 60, maxval = 600, group = gResearch, display = display.none)
int m15Lookback = input.int(400, "15M structural bars", minval = 80, maxval = 600, group = gResearch, display = display.none)
int m5Lookback = input.int(600, "5M structural bars", minval = 100, maxval = 600, group = gResearch, display = display.none)
int touchToleranceTicks = input.int(1, "Fresh-ray tolerance (ticks)", minval = 0, maxval = 20, group = gResearch, tooltip = "Research placeholder; not production calibrated.", display = display.none)
int overlapTicks = input.int(8, "Parent/child separation (ticks)", minval = 0, maxval = 100, group = gResearch, tooltip = "Research placeholder; not production calibrated.", display = display.none)

// -----------------------------------------------------------------------------
// COLORS / CONTEXT
// -----------------------------------------------------------------------------
color GREEN_UP = color.rgb(0, 205, 105)
color RED_DOWN = color.rgb(230, 55, 70)
color BLUE_DAY = color.rgb(35, 112, 255)
color BLUE_WEEK = color.rgb(91, 82, 230)
color BLUE_TARGET = color.rgb(42, 118, 255)
color YELLOW_GO = color.rgb(255, 215, 0)
color ORANGE_WAIT = color.rgb(255, 155, 35)
color PANEL_DARK = color.rgb(18, 20, 25)
color PANEL_MID = color.rgb(37, 41, 49)
color GOLD_ACCENT = color.rgb(205, 165, 70)

bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool isNqMnq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool tickGridExpected = math.abs(syminfo.mintick - EXPECTED_TICK) < 1e-6
float touchTolerance = touchToleranceTicks * syminfo.mintick
float overlapTolerance = overlapTicks * syminfo.mintick

// -----------------------------------------------------------------------------
// GEOMETRY HELPERS - evaluated inside source-timeframe requests.
// -----------------------------------------------------------------------------
f_line_at(int t1, float p1, int t2, float p2, int atTime) =>
    not na(t1) and not na(t2) and t2 > t1 ? p1 + (float(atTime - t1) / float(t2 - t1)) * (p2 - p1) : na

f_is_swing(int off, bool bullish) =>
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    off >= 2 and (bullish ? (low[off] <= low[off + 1] and low[off] <= low[off + 2] and low[off] < low[off - 1] and low[off] < low[off - 2]) : (high[off] >= high[off + 1] and high[off] >= high[off + 2] and high[off] > high[off - 1] and high[off] > high[off - 2]))

f_find_freeze_off(int freezeTs, int scanBars) =>
    max_bars_back(time_close, SAFE_HISTORY_BUFFER)
    int out = na
    if freezeTs > 0 and scanBars > 0
        for i = 0 to scanBars - 1
            if na(out) and not na(time_close[i]) and time_close[i] <= freezeTs
                out := i
    out

f_ray_clean(bool bullish, int aT, float aP, int bT, float bP, int newestOff, int oldestOff, float tol) =>
    max_bars_back(time, SAFE_HISTORY_BUFFER)
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    bool clean = true
    if not na(aT) and not na(bT) and bT > aT and oldestOff >= newestOff
        for k = newestOff to oldestOff
            int kt = time[k]
            if not na(kt) and kt >= aT
                float lp = f_line_at(aT, aP, bT, bP, kt)
                if not na(lp)
                    if bullish and low[k] < lp - tol
                        clean := false
                    if not bullish and high[k] > lp + tol
                        clean := false
    clean

f_root_from_a(bool bullish, int freezeOff, int maxOff, int aOff, float aP, float tol) =>
    max_bars_back(time, SAFE_HISTORY_BUFFER)
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    bool valid = false
    int outAT = na
    float outAP = na
    int outBT = na
    float outBP = na
    int tested = 0
    int newestConfirmed = freezeOff + 2
    if not na(aOff) and aOff > newestConfirmed and aOff <= maxOff
        int aT = time[aOff]
        int span = aOff - newestConfirmed
        for step = 1 to span
            int j = aOff - step
            bool swingOk = j >= newestConfirmed and j + 2 <= maxOff and f_is_swing(j, bullish)
            float bP = bullish ? low[j] : high[j]
            bool directional = bullish ? bP > aP : bP < aP
            if not valid and swingOk and directional
                tested += 1
                bool clean = f_ray_clean(bullish, aT, aP, time[j], bP, freezeOff, aOff, tol)
                if clean
                    valid := true
                    outAT := aT
                    outAP := aP
                    outBT := time[j]
                    outBP := bP
                    break
                if tested >= MAX_B_CANDIDATES
                    break
    [valid, outAT, outAP, outBT, outBP]

f_child_from_parent(bool parentValid, int parentAT, float parentAP, int parentBT, float parentBP, bool bullish, int freezeOff, int maxOff, float tol, float separation) =>
    max_bars_back(time, SAFE_HISTORY_BUFFER)
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    bool valid = false
    int outAT = na
    float outAP = na
    int outBT = na
    float outBP = na
    int tested = 0
    int newestConfirmed = freezeOff + 2
    int oldestCandidate = maxOff - 2
    if parentValid and not na(parentBT) and not na(parentBP) and oldestCandidate >= newestConfirmed
        int span = oldestCandidate - newestConfirmed
        for step = 0 to span
            int j = oldestCandidate - step
            int jt = time[j]
            bool afterParent = not na(jt) and jt > parentBT
            bool swingOk = afterParent and f_is_swing(j, bullish)
            float bP = bullish ? low[j] : high[j]
            bool directional = bullish ? bP > parentBP : bP < parentBP
            if not valid and swingOk and directional
                float parentProjected = f_line_at(parentAT, parentAP, parentBT, parentBP, jt)
                bool distinct = na(parentProjected) or math.abs(bP - parentProjected) >= separation
                if distinct
                    tested += 1
                    bool clean = f_ray_clean(bullish, parentBT, parentBP, jt, bP, freezeOff, maxOff, tol)
                    if clean
                        valid := true
                        outAT := parentBT
                        outAP := parentBP
                        outBT := jt
                        outBP := bP
                        break
                    if tested >= MAX_B_CANDIDATES
                        break
    [valid, outAT, outAP, outBT, outBP]

f_root_pair_fast(int freezeTs, int lookbackBars, float tol) =>
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    bool gV = false
    int gAT = na
    float gAP = na
    int gBT = na
    float gBP = na
    bool rV = false
    int rAT = na
    float rAP = na
    int rBT = na
    float rBP = na
    if barstate.islast and freezeTs > 0
        int scanBars = math.min(lookbackBars + FREEZE_PADDING, bar_index + 1)
        int freezeOff = f_find_freeze_off(freezeTs, scanBars)
        if not na(freezeOff)
            int maxOff = math.min(freezeOff + lookbackBars - 1, scanBars - 1)
            int gAOff = na
            float gExtreme = 1e20
            int rAOff = na
            float rExtreme = -1e20
            for i = freezeOff to maxOff
                if not na(low[i]) and low[i] < gExtreme
                    gExtreme := low[i]
                    gAOff := i
                if not na(high[i]) and high[i] > rExtreme
                    rExtreme := high[i]
                    rAOff := i
            [gV0, gAT0, gAP0, gBT0, gBP0] = f_root_from_a(true, freezeOff, maxOff, gAOff, gExtreme, tol)
            [rV0, rAT0, rAP0, rBT0, rBP0] = f_root_from_a(false, freezeOff, maxOff, rAOff, rExtreme, tol)
            gV := gV0
            gAT := gAT0
            gAP := gAP0
            gBT := gBT0
            gBP := gBP0
            rV := rV0
            rAT := rAT0
            rAP := rAP0
            rBT := rBT0
            rBP := rBP0
    TlPair.new(gV, gAT, gAP, gBT, gBP, rV, rAT, rAP, rBT, rBP)

f_family_pair_fast(bool gParentValid, int gParentAT, float gParentAP, int gParentBT, float gParentBP, bool rParentValid, int rParentAT, float rParentAP, int rParentBT, float rParentBP, int freezeTs, int lookbackBars, float tol, float separation) =>
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    bool gV = false
    int gAT = na
    float gAP = na
    int gBT = na
    float gBP = na
    bool rV = false
    int rAT = na
    float rAP = na
    int rBT = na
    float rBP = na
    if barstate.islast and freezeTs > 0
        int scanBars = math.min(lookbackBars + FREEZE_PADDING, bar_index + 1)
        int freezeOff = f_find_freeze_off(freezeTs, scanBars)
        if not na(freezeOff)
            int maxOff = math.min(freezeOff + lookbackBars - 1, scanBars - 1)
            if gParentValid
                [gv, gat, gap, gbt, gbp] = f_child_from_parent(true, gParentAT, gParentAP, gParentBT, gParentBP, true, freezeOff, maxOff, tol, separation)
                gV := gv
                gAT := gat
                gAP := gap
                gBT := gbt
                gBP := gbp
            else
                int gAOff = na
                float gExtreme = 1e20
                for i = freezeOff to maxOff
                    if not na(low[i]) and low[i] < gExtreme
                        gExtreme := low[i]
                        gAOff := i
                [gv, gat, gap, gbt, gbp] = f_root_from_a(true, freezeOff, maxOff, gAOff, gExtreme, tol)
                gV := gv
                gAT := gat
                gAP := gap
                gBT := gbt
                gBP := gbp
            if rParentValid
                [rv, rat, rap, rbt, rbp] = f_child_from_parent(true, rParentAT, rParentAP, rParentBT, rParentBP, false, freezeOff, maxOff, tol, separation)
                rV := rv
                rAT := rat
                rAP := rap
                rBT := rbt
                rBP := rbp
            else
                int rAOff = na
                float rExtreme = -1e20
                for i = freezeOff to maxOff
                    if not na(high[i]) and high[i] > rExtreme
                        rExtreme := high[i]
                        rAOff := i
                [rv, rat, rap, rbt, rbp] = f_root_from_a(false, freezeOff, maxOff, rAOff, rExtreme, tol)
                rV := rv
                rAT := rat
                rAP := rap
                rBT := rbt
                rBP := rbp
    TlPair.new(gV, gAT, gAP, gBT, gBP, rV, rAT, rAP, rBT, rBP)

// Canonical 5-minute audit. The buffer sizing calls are deliberately inside this
// function because it executes in the requested 5m context, where v0.10.3 failed.
f_recent_clean_one(bool valid, bool bullish, int aT, float aP, int bT, float bP, int freezeTs, float tol) =>
    max_bars_back(time, SAFE_HISTORY_BUFFER)
    max_bars_back(time_close, SAFE_HISTORY_BUFFER)
    max_bars_back(low, SAFE_HISTORY_BUFFER)
    max_bars_back(high, SAFE_HISTORY_BUFFER)
    bool clean = valid
    if valid and barstate.islast
        int scanBars = math.min(RECENT_5M_AUDIT_BARS + FREEZE_PADDING, bar_index + 1)
        int freezeOff = f_find_freeze_off(freezeTs, scanBars)
        if na(freezeOff)
            clean := false
        else
            int oldestOff = math.min(freezeOff + RECENT_5M_AUDIT_BARS - 1, scanBars - 1)
            for k = freezeOff to oldestOff
                int kt = time[k]
                if not na(kt) and kt >= aT
                    float lp = f_line_at(aT, aP, bT, bP, kt)
                    if not na(lp)
                        if bullish and low[k] < lp - tol
                            clean := false
                        if not bullish and high[k] > lp + tol
                            clean := false
    clean

f_gate_pair_5m(TlPair raw, int freezeTs, float tol) =>
    bool gv = f_recent_clean_one(raw.gV, true, raw.gAT, raw.gAP, raw.gBT, raw.gBP, freezeTs, tol)
    bool rv = f_recent_clean_one(raw.rV, false, raw.rAT, raw.rAP, raw.rBT, raw.rBP, freezeTs, tol)
    TlPair.new(gv, gv ? raw.gAT : na, gv ? raw.gAP : na, gv ? raw.gBT : na, gv ? raw.gBP : na, rv, rv ? raw.rAT : na, rv ? raw.rAP : na, rv ? raw.rBT : na, rv ? raw.rBP : na)

// -----------------------------------------------------------------------------
// CANONICAL 5-MINUTE BOARD ENGINE
// -----------------------------------------------------------------------------
f_build_board(int freezeTs, int mLb, int wLb, int dLb, int h4Lb, int h1Lb, int m15Lb, int m5Lb, float tol, float separation) =>
    [dHighCurrent, dLowCurrent, dCloseTimeCurrent] = request.security(syminfo.tickerid, "D", [high, low, time_close], lookahead = barmerge.lookahead_off, calc_bars_count = 3)
    [dHighPrev, dLowPrev] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on, calc_bars_count = 3)
    [wHighCurrent, wLowCurrent, wCloseTimeCurrent] = request.security(syminfo.tickerid, "W", [high, low, time_close], lookahead = barmerge.lookahead_off, calc_bars_count = 3)
    [wHighPrev, wLowPrev] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on, calc_bars_count = 3)

    int closedGapMs = timenow - time_close
    bool recentClosedGap = not barstate.isrealtime and closedGapMs >= 0 and closedGapMs <= NORMAL_CLOSED_GAP_MS
    bool extendedClosedGap = not barstate.isrealtime and closedGapMs > NORMAL_CLOSED_GAP_MS
    bool dailyCurrentCompletedNow = recentClosedGap and not na(dCloseTimeCurrent) and timenow >= dCloseTimeCurrent
    bool weeklyCurrentCompletedNow = recentClosedGap and not na(wCloseTimeCurrent) and timenow >= wCloseTimeCurrent
    float pdh0 = dailyCurrentCompletedNow ? dHighCurrent : dHighPrev
    float pdl0 = dailyCurrentCompletedNow ? dLowCurrent : dLowPrev
    float pwh0 = weeklyCurrentCompletedNow ? wHighCurrent : wHighPrev
    float pwl0 = weeklyCurrentCompletedNow ? wLowCurrent : wLowPrev

    TlPair mRaw = request.security(syminfo.tickerid, "M", f_root_pair_fast(freezeTs, mLb, tol), lookahead = barmerge.lookahead_off, calc_bars_count = mLb + FREEZE_PADDING)
    TlPair m = f_gate_pair_5m(mRaw, freezeTs, tol)

    TlPair wRaw = request.security(syminfo.tickerid, "W", f_family_pair_fast(m.gV, m.gAT, m.gAP, m.gBT, m.gBP, m.rV, m.rAT, m.rAP, m.rBT, m.rBP, freezeTs, wLb, tol, separation), lookahead = barmerge.lookahead_off, calc_bars_count = wLb + FREEZE_PADDING)
    TlPair w = f_gate_pair_5m(wRaw, freezeTs, tol)

    bool gpWV = w.gV or m.gV
    int gpWAT = w.gV ? w.gAT : m.gAT
    float gpWAP = w.gV ? w.gAP : m.gAP
    int gpWBT = w.gV ? w.gBT : m.gBT
    float gpWBP = w.gV ? w.gBP : m.gBP
    bool rpWV = w.rV or m.rV
    int rpWAT = w.rV ? w.rAT : m.rAT
    float rpWAP = w.rV ? w.rAP : m.rAP
    int rpWBT = w.rV ? w.rBT : m.rBT
    float rpWBP = w.rV ? w.rBP : m.rBP

    TlPair dRaw = request.security(syminfo.tickerid, "D", f_family_pair_fast(gpWV, gpWAT, gpWAP, gpWBT, gpWBP, rpWV, rpWAT, rpWAP, rpWBT, rpWBP, freezeTs, dLb, tol, separation), lookahead = barmerge.lookahead_off, calc_bars_count = dLb + FREEZE_PADDING)
    TlPair d = f_gate_pair_5m(dRaw, freezeTs, tol)

    bool gpDV = d.gV or gpWV
    int gpDAT = d.gV ? d.gAT : gpWAT
    float gpDAP = d.gV ? d.gAP : gpWAP
    int gpDBT = d.gV ? d.gBT : gpWBT
    float gpDBP = d.gV ? d.gBP : gpWBP
    bool rpDV = d.rV or rpWV
    int rpDAT = d.rV ? d.rAT : rpWAT
    float rpDAP = d.rV ? d.rAP : rpWAP
    int rpDBT = d.rV ? d.rBT : rpWBT
    float rpDBP = d.rV ? d.rBP : rpWBP

    TlPair h4Raw = request.security(syminfo.tickerid, "240", f_family_pair_fast(gpDV, gpDAT, gpDAP, gpDBT, gpDBP, rpDV, rpDAT, rpDAP, rpDBT, rpDBP, freezeTs, h4Lb, tol, separation), lookahead = barmerge.lookahead_off, calc_bars_count = h4Lb + FREEZE_PADDING)
    TlPair h4 = f_gate_pair_5m(h4Raw, freezeTs, tol)

    bool gp4V = h4.gV or gpDV
    int gp4AT = h4.gV ? h4.gAT : gpDAT
    float gp4AP = h4.gV ? h4.gAP : gpDAP
    int gp4BT = h4.gV ? h4.gBT : gpDBT
    float gp4BP = h4.gV ? h4.gBP : gpDBP
    bool rp4V = h4.rV or rpDV
    int rp4AT = h4.rV ? h4.rAT : rpDAT
    float rp4AP = h4.rV ? h4.rAP : rpDAP
    int rp4BT = h4.rV ? h4.rBT : rpDBT
    float rp4BP = h4.rV ? h4.rBP : rpDBP

    TlPair h1Raw = request.security(syminfo.tickerid, "60", f_family_pair_fast(gp4V, gp4AT, gp4AP, gp4BT, gp4BP, rp4V, rp4AT, rp4AP, rp4BT, rp4BP, freezeTs, h1Lb, tol, separation), lookahead = barmerge.lookahead_off, calc_bars_count = h1Lb + FREEZE_PADDING)
    TlPair h1 = f_gate_pair_5m(h1Raw, freezeTs, tol)

    bool gp1V = h1.gV or gp4V
    int gp1AT = h1.gV ? h1.gAT : gp4AT
    float gp1AP = h1.gV ? h1.gAP : gp4AP
    int gp1BT = h1.gV ? h1.gBT : gp4BT
    float gp1BP = h1.gV ? h1.gBP : gp4BP
    bool rp1V = h1.rV or rp4V
    int rp1AT = h1.rV ? h1.rAT : rp4AT
    float rp1AP = h1.rV ? h1.rAP : rp4AP
    int rp1BT = h1.rV ? h1.rBT : rp4BT
    float rp1BP = h1.rV ? h1.rBP : rp4BP

    TlPair m15Raw = request.security(syminfo.tickerid, "15", f_family_pair_fast(gp1V, gp1AT, gp1AP, gp1BT, gp1BP, rp1V, rp1AT, rp1AP, rp1BT, rp1BP, freezeTs, m15Lb, tol, separation), lookahead = barmerge.lookahead_off, calc_bars_count = m15Lb + FREEZE_PADDING)
    TlPair m15 = f_gate_pair_5m(m15Raw, freezeTs, tol)

    bool gp15V = m15.gV or gp1V
    int gp15AT = m15.gV ? m15.gAT : gp1AT
    float gp15AP = m15.gV ? m15.gAP : gp1AP
    int gp15BT = m15.gV ? m15.gBT : gp1BT
    float gp15BP = m15.gV ? m15.gBP : gp1BP
    bool rp15V = m15.rV or rp1V
    int rp15AT = m15.rV ? m15.rAT : rp1AT
    float rp15AP = m15.rV ? m15.rAP : rp1AP
    int rp15BT = m15.rV ? m15.rBT : rp1BT
    float rp15BP = m15.rV ? m15.rBP : rp1BP

    TlPair m5Raw = f_family_pair_fast(gp15V, gp15AT, gp15AP, gp15BT, gp15BP, rp15V, rp15AT, rp15AP, rp15BT, rp15BP, freezeTs, m5Lb, tol, separation)
    TlPair m5 = f_gate_pair_5m(m5Raw, freezeTs, tol)

    Board.new(pdh0, pdl0, pwh0, pwl0, extendedClosedGap, m, w, d, h4, h1, m15, m5)

Board board = request.security(syminfo.tickerid, "5", f_build_board(boardFreezeTime, monthlyLookback, weeklyLookback, dailyLookback, h4Lookback, h1Lookback, m15Lookback, m5Lookback, touchTolerance, overlapTolerance), lookahead = barmerge.lookahead_off, calc_bars_count = SAFE_HISTORY_BUFFER)

float pdh = board.pdh
float pdl = board.pdl
float pwh = board.pwh
float pwl = board.pwl
bool dayValuesValid = not na(pdh) and not na(pdl)
bool weekValuesValid = not na(pwh) and not na(pwl)
float dailyEnvelope = dayValuesValid ? math.max(math.abs(pdh - close), math.abs(pdl - close)) : na
bool showPdh = dayValuesValid
bool showPdl = dayValuesValid
bool showPwh = showWeeklyLevels and weekValuesValid and not na(dailyEnvelope) and math.abs(pwh - close) <= dailyEnvelope
bool showPwl = showWeeklyLevels and weekValuesValid and not na(dailyEnvelope) and math.abs(pwl - close) <= dailyEnvelope

// -----------------------------------------------------------------------------
// PROJECTED VALUES / NEXT WALL
// -----------------------------------------------------------------------------
int projectionTime = time_close
f_now(bool valid, int at, float ap, int bt, float bp) => valid ? f_line_at(at, ap, bt, bp, projectionTime) : na
float mGreenNow = f_now(board.m.gV, board.m.gAT, board.m.gAP, board.m.gBT, board.m.gBP)
float mRedNow = f_now(board.m.rV, board.m.rAT, board.m.rAP, board.m.rBT, board.m.rBP)
float wGreenNow = f_now(board.w.gV, board.w.gAT, board.w.gAP, board.w.gBT, board.w.gBP)
float wRedNow = f_now(board.w.rV, board.w.rAT, board.w.rAP, board.w.rBT, board.w.rBP)
float dGreenNow = f_now(board.d.gV, board.d.gAT, board.d.gAP, board.d.gBT, board.d.gBP)
float dRedNow = f_now(board.d.rV, board.d.rAT, board.d.rAP, board.d.rBT, board.d.rBP)
float h4GreenNow = f_now(board.h4.gV, board.h4.gAT, board.h4.gAP, board.h4.gBT, board.h4.gBP)
float h4RedNow = f_now(board.h4.rV, board.h4.rAT, board.h4.rAP, board.h4.rBT, board.h4.rBP)
float h1GreenNow = f_now(board.h1.gV, board.h1.gAT, board.h1.gAP, board.h1.gBT, board.h1.gBP)
float h1RedNow = f_now(board.h1.rV, board.h1.rAT, board.h1.rAP, board.h1.rBT, board.h1.rBP)
float m15GreenNow = f_now(board.m15.gV, board.m15.gAT, board.m15.gAP, board.m15.gBT, board.m15.gBP)
float m15RedNow = f_now(board.m15.rV, board.m15.rAT, board.m15.rAP, board.m15.rBT, board.m15.rBP)
float m5GreenNow = f_now(board.m5.gV, board.m5.gAT, board.m5.gAP, board.m5.gBT, board.m5.gBP)
float m5RedNow = f_now(board.m5.rV, board.m5.rAT, board.m5.rAP, board.m5.rBT, board.m5.rBP)

int activeTlCount = (board.m.gV ? 1 : 0) + (board.m.rV ? 1 : 0) + (board.w.gV ? 1 : 0) + (board.w.rV ? 1 : 0) + (board.d.gV ? 1 : 0) + (board.d.rV ? 1 : 0) + (board.h4.gV ? 1 : 0) + (board.h4.rV ? 1 : 0) + (board.h1.gV ? 1 : 0) + (board.h1.rV ? 1 : 0) + (board.m15.gV ? 1 : 0) + (board.m15.rV ? 1 : 0) + (board.m5.gV ? 1 : 0) + (board.m5.rV ? 1 : 0)

array<string> wallNames = array.new_string()
array<float> wallPrices = array.new_float()
f_add_wall(bool condition, string name, float price) =>
    if condition and not na(price)
        array.push(wallNames, name)
        array.push(wallPrices, price)

if planSide == "LONG"
    f_add_wall(board.m.rV and mRedNow > close, "M RED", mRedNow)
    f_add_wall(board.w.rV and wRedNow > close, "W RED", wRedNow)
    f_add_wall(board.d.rV and dRedNow > close, "D RED", dRedNow)
    f_add_wall(board.h4.rV and h4RedNow > close, "4H RED", h4RedNow)
    f_add_wall(board.h1.rV and h1RedNow > close, "1H RED", h1RedNow)
    f_add_wall(board.m15.rV and m15RedNow > close, "15M RED", m15RedNow)
    f_add_wall(board.m5.rV and m5RedNow > close, "5M RED", m5RedNow)
    f_add_wall(showPdh and pdh > close, "PDH", pdh)
    f_add_wall(showPwh and pwh > close, "PWH", pwh)
else
    f_add_wall(board.m.gV and mGreenNow < close, "M GREEN", mGreenNow)
    f_add_wall(board.w.gV and wGreenNow < close, "W GREEN", wGreenNow)
    f_add_wall(board.d.gV and dGreenNow < close, "D GREEN", dGreenNow)
    f_add_wall(board.h4.gV and h4GreenNow < close, "4H GREEN", h4GreenNow)
    f_add_wall(board.h1.gV and h1GreenNow < close, "1H GREEN", h1GreenNow)
    f_add_wall(board.m15.gV and m15GreenNow < close, "15M GREEN", m15GreenNow)
    f_add_wall(board.m5.gV and m5GreenNow < close, "5M GREEN", m5GreenNow)
    f_add_wall(showPdl and pdl < close, "PDL", pdl)
    f_add_wall(showPwl and pwl < close, "PWL", pwl)

string nextWallName = "NONE AHEAD"
float nextWallPrice = na
float nextWallDistance = HUGE_DISTANCE
if array.size(wallPrices) > 0
    for i = 0 to array.size(wallPrices) - 1
        float p = array.get(wallPrices, i)
        float dist = math.abs(p - close)
        if dist < nextWallDistance
            nextWallDistance := dist
            nextWallName := array.get(wallNames, i)
            nextWallPrice := p
string nextWallText = na(nextWallPrice) ? nextWallName : nextWallName + " @ " + str.tostring(nextWallPrice, format.mintick)

// -----------------------------------------------------------------------------
// DRAWINGS
// -----------------------------------------------------------------------------
var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pwhLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pwlLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var label pdhLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pdlLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pwhLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pwlLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)

f_sync_level(line id, label lid, float price, string name, color c, bool visible) =>
    if visible and not na(price) and price > 0
        line.set_xy1(id, time, price)
        line.set_xy2(id, time_close, price)
        line.set_extend(id, extend.both)
        line.set_color(id, c)
        line.set_width(id, 2)
        label.set_xy(lid, time_close, price)
        label.set_text(lid, name + "  " + str.tostring(price, format.mintick))
        label.set_color(lid, c)
        label.set_textcolor(lid, color.white)
        label.set_size(lid, size.large)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

var line mGreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line mRedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line wGreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line wRedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line dGreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line dRedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)

f_sync_trend(line id, bool valid, bool visible, int aT, float aP, int bT, float bP, color c) =>
    if valid and visible and not na(aT) and not na(bT) and aP > 0 and bP > 0 and bT > aT
        line.set_xy1(id, aT, aP)
        line.set_xy2(id, bT, bP)
        line.set_extend(id, extend.right)
        line.set_color(id, c)
        line.set_width(id, 2)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)

var line goDraw = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var label goLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var box targetBox = na
var label targetLabel = na
bool goSet = goLine > 0
bool targetSet = safeTargetLow > 0 and safeTargetHigh > safeTargetLow

if barstate.islast
    f_sync_level(pdhLine, pdhLabel, pdh, "PDH", BLUE_DAY, showPdh)
    f_sync_level(pdlLine, pdlLabel, pdl, "PDL", BLUE_DAY, showPdl)
    f_sync_level(pwhLine, pwhLabel, pwh, "PWH", BLUE_WEEK, showPwh)
    f_sync_level(pwlLine, pwlLabel, pwl, "PWL", BLUE_WEEK, showPwl)

    f_sync_trend(mGreenLine, board.m.gV, showMGreen, board.m.gAT, board.m.gAP, board.m.gBT, board.m.gBP, GREEN_UP)
    f_sync_trend(mRedLine, board.m.rV, showMRed, board.m.rAT, board.m.rAP, board.m.rBT, board.m.rBP, RED_DOWN)
    f_sync_trend(wGreenLine, board.w.gV, showWGreen, board.w.gAT, board.w.gAP, board.w.gBT, board.w.gBP, GREEN_UP)
    f_sync_trend(wRedLine, board.w.rV, showWRed, board.w.rAT, board.w.rAP, board.w.rBT, board.w.rBP, RED_DOWN)
    f_sync_trend(dGreenLine, board.d.gV, showDGreen, board.d.gAT, board.d.gAP, board.d.gBT, board.d.gBP, GREEN_UP)
    f_sync_trend(dRedLine, board.d.rV, showDRed, board.d.rAT, board.d.rAP, board.d.rBT, board.d.rBP, RED_DOWN)
    f_sync_trend(h4GreenLine, board.h4.gV, show4HGreen, board.h4.gAT, board.h4.gAP, board.h4.gBT, board.h4.gBP, GREEN_UP)
    f_sync_trend(h4RedLine, board.h4.rV, show4HRed, board.h4.rAT, board.h4.rAP, board.h4.rBT, board.h4.rBP, RED_DOWN)
    f_sync_trend(h1GreenLine, board.h1.gV, show1HGreen, board.h1.gAT, board.h1.gAP, board.h1.gBT, board.h1.gBP, GREEN_UP)
    f_sync_trend(h1RedLine, board.h1.rV, show1HRed, board.h1.rAT, board.h1.rAP, board.h1.rBT, board.h1.rBP, RED_DOWN)
    f_sync_trend(m15GreenLine, board.m15.gV, show15MGreen, board.m15.gAT, board.m15.gAP, board.m15.gBT, board.m15.gBP, GREEN_UP)
    f_sync_trend(m15RedLine, board.m15.rV, show15MRed, board.m15.rAT, board.m15.rAP, board.m15.rBT, board.m15.rBP, RED_DOWN)
    f_sync_trend(m5GreenLine, board.m5.gV, show5MGreen, board.m5.gAT, board.m5.gAP, board.m5.gBT, board.m5.gBP, GREEN_UP)
    f_sync_trend(m5RedLine, board.m5.rV, show5MRed, board.m5.rAT, board.m5.rAP, board.m5.rBT, board.m5.rBP, RED_DOWN)

    if showGoLine and goSet
        line.set_xy1(goDraw, time, goLine)
        line.set_xy2(goDraw, time_close, goLine)
        line.set_color(goDraw, YELLOW_GO)
        line.set_width(goDraw, 4)
        label.set_xy(goLabel, time_close, goLine)
        label.set_text(goLabel, "GO LINE  " + str.tostring(goLine, format.mintick))
        label.set_color(goLabel, YELLOW_GO)
        label.set_textcolor(goLabel, color.black)
        label.set_size(goLabel, size.large)
    else
        line.set_xy1(goDraw, na, na)
        line.set_xy2(goDraw, na, na)
        label.set_xy(goLabel, na, na)
        label.set_text(goLabel, "")

    if showSafeTarget and targetSet
        int leftTime = time
        int rightTime = time_close
        if na(targetBox)
            targetBox := box.new(leftTime, safeTargetHigh, rightTime, safeTargetLow, xloc = xloc.bar_time, extend = extend.right, border_color = BLUE_TARGET, bgcolor = color.new(BLUE_TARGET, 84), border_width = 2)
        else
            box.set_lefttop(targetBox, leftTime, safeTargetHigh)
            box.set_rightbottom(targetBox, rightTime, safeTargetLow)
        float targetMid = (safeTargetHigh + safeTargetLow) / 2.0
        if na(targetLabel)
            targetLabel := label.new(rightTime, targetMid, "SAFE TARGET", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = BLUE_TARGET, textcolor = color.white, size = size.large)
        else
            label.set_xy(targetLabel, rightTime, targetMid)
    else
        if not na(targetBox)
            box.delete(targetBox)
            targetBox := na
        if not na(targetLabel)
            label.delete(targetLabel)
            targetLabel := na

// -----------------------------------------------------------------------------
// COACH
// -----------------------------------------------------------------------------
bool directionKnown = bigDirection != "NOT SET"
bool planWithDirection = directionKnown and ((bigDirection == "UP" and planSide == "LONG") or (bigDirection == "DOWN" and planSide == "SHORT"))
string currentMoveText = not directionKnown ? "WAITING FOR DIRECTION" : planWithDirection ? (planSide == "LONG" ? "UP WITH BIG DIRECTION" : "DOWN WITH BIG DIRECTION") : (planSide == "LONG" ? "TEMPORARY UP MOVE" : "TEMPORARY DOWN MOVE")
string safeTargetText = targetSet ? str.tostring(safeTargetLow, format.mintick) + " - " + str.tostring(safeTargetHigh, format.mintick) : "NOT SET"
string trendlineText = boardFreezeTime <= 0 ? "SET FREEZE POINT" : str.tostring(activeTlCount) + " LOCKED | BUFFER SAFE"
string runtimeReason = boardFreezeTime <= 0 ? "SET BOARD FREEZE POINT" : not isNqMnq ? "USE NQ OR MNQ" : not tickGridExpected ? "CHECK CONTRACT TICK" : board.levelsVerify ? "D/W VERIFY AFTER LONG CLOSE" : isFiveMinute ? "CANONICAL BOARD | 5 MIN" : "SAME BOARD | VIEW ONLY"
color bigDirectionColor = bigDirection == "UP" ? GREEN_UP : bigDirection == "DOWN" ? RED_DOWN : color.gray
color moveColor = not directionKnown ? color.gray : planSide == "LONG" ? GREEN_UP : RED_DOWN

var table coach = table.new(position.top_right, 2, 9, border_width = 2, frame_width = 2, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)
if barstate.islast
    if showCoach
        table.cell(coach, 0, 0, "SLUMDAWG", text_color = color.lime, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 1, 0, "COACH", text_color = color.white, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 0, 1, "BIG DIRECTION", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 1, bigDirection, text_color = color.white, bgcolor = bigDirectionColor, text_size = 16)
        table.cell(coach, 0, 2, "CURRENT MOVE", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 2, currentMoveText, text_color = color.white, bgcolor = moveColor, text_size = 15)
        table.cell(coach, 0, 3, "TRENDLINES", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 3, trendlineText, text_color = activeTlCount > 0 ? color.lime : color.orange, text_size = 13)
        table.cell(coach, 0, 4, "NEXT WALL", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 4, nextWallText, text_color = color.orange, text_size = 14)
        table.cell(coach, 0, 5, "GO LINE", text_color = color.black, bgcolor = YELLOW_GO, text_size = 15)
        table.cell(coach, 1, 5, goSet ? str.tostring(goLine, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 16)
        table.cell(coach, 0, 6, "SAFE TARGET", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 1, 6, safeTargetText, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 0, 7, "NOW", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 7, "BOARD VALIDATION", text_color = color.black, bgcolor = ORANGE_WAIT, text_size = 15)
        table.cell(coach, 0, 8, "SYSTEM", text_color = color.white, text_size = 14)
        table.cell(coach, 1, 8, runtimeReason, text_color = color.orange, text_size = 13)
    else
        for r = 0 to 8
            table.cell(coach, 0, r, "")
            table.cell(coach, 1, r, "")

alertcondition(false, "V0.10.4 buffer-safe canonical-board research build", "NON-ACTIONABLE research build")