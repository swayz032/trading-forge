//@version=6
indicator("Slumdawg NQ/MNQ v0.5.1 — Trendline Ladder", shorttitle = "Slumdawg v0.5.1", overlay = true, behind_chart = true, max_labels_count = 160, max_lines_count = 160, max_boxes_count = 30)

// =============================================================================
// SAFETY / RELEASE CLASSIFICATION
// =============================================================================
const string BUILD_CLASSIFICATION = "PLATFORM_PARITY_ONLY"
const bool LIVE_DECISION_SUPPORT_APPROVED = false
const float EXPECTED_TICK = 0.25
const int NORMAL_CLOSED_GAP_MS = 72 * 60 * 60 * 1000
const float HUGE_DISTANCE = 1e12

// v0.5.1 preserves the script-owned GREEN/RED top-down trendline ladder.
// Trendlines remain CONTEXT / REACTION-WALL geometry only.
// A trendline cross NEVER flips BIG DIRECTION and NEVER creates GO or READY.
// Automatic GO LINE and SAFE TARGET selection remain uncertified.
// PDH/PDL now span the full chart. Near PWH/PWL do the same when displayed.

// =============================================================================
// BEGINNER INPUTS
// =============================================================================
string gPlan = "1 — BEGINNER SETUP"
string bigDirection = input.string("NOT SET", "BIG DIRECTION", options = ["UP", "DOWN", "NOT SET"], group = gPlan)
string planSide = input.string("LONG", "PLAN", options = ["LONG", "SHORT"], group = gPlan)
float goLine = input.price(0.0, "GO LINE (yellow)", group = gPlan, tooltip = "Manual proof line for platform-parity testing. Automatic selection is not certified yet.")
float safeTargetLow = input.price(0.0, "SAFE TARGET lower edge", group = gPlan, tooltip = "Optional manual target-zone edge for parity testing.")
float safeTargetHigh = input.price(0.0, "SAFE TARGET upper edge", group = gPlan, tooltip = "Optional manual target-zone edge for parity testing.")

// =============================================================================
// DISPLAY — PDH/PDL ALWAYS; WEEKLY ONLY WHEN VISUALLY NEAR
// =============================================================================
string gView = "2 — CLEAN CHART"
bool showWeeklyWhenNear = input.bool(true, "Show PWH/PWL when near", group = gView, tooltip = "Visual-only rule. PDH and PDL always show when valid. A weekly level shows only when its distance from current price is no greater than the farther of PDH/PDL.")
int trendlineVisibleCount = input.int(2, "Trendlines prominent", minval = 0, maxval = 4, group = gView, tooltip = "Shows the nearest active trendlines, plus NEXT WALL when it is a trendline. Full enabled ladder remains available to the coach logic.")
bool showCoach = input.bool(true, "Slumdawg coach", group = gView)
bool showGoLine = input.bool(true, "Yellow GO LINE", group = gView)
bool showSafeTarget = input.bool(true, "Blue SAFE TARGET", group = gView)
bool showEngineering = input.bool(false, "Engineering diagnostics", group = gView)
bool showDebugMarkers = input.bool(false, "Tiny parity markers", group = gView)

// =============================================================================
// SCRIPT-OWNED TOP-DOWN TRENDLINE LADDER
// Trendlines DO NOT auto-appear: enable a line and provide valid A/B time+price
// anchors. That keeps the user's discretionary top-down line placement authoritative.
// Paired input.time + input.price values share inline/group IDs so TradingView can
// expose each anchor as one interactive chart point.
// =============================================================================
string gDaily = "3A — DAILY TRENDLINES"
bool dGreenOn = input.bool(false, "GREEN bullish", group = gDaily, tooltip = "Enable this line, then set A/B anchors to the two Daily swing lows you choose.")
int dGreenT1 = input.time(0, "A time", inline = "DG_A", group = gDaily, active = dGreenOn)
float dGreenP1 = input.price(0.0, "A price", inline = "DG_A", group = gDaily, active = dGreenOn)
int dGreenT2 = input.time(0, "B time", inline = "DG_B", group = gDaily, active = dGreenOn)
float dGreenP2 = input.price(0.0, "B price", inline = "DG_B", group = gDaily, active = dGreenOn)
bool dRedOn = input.bool(false, "RED bearish", group = gDaily, tooltip = "Enable this line, then set A/B anchors to the two Daily swing highs you choose.")
int dRedT1 = input.time(0, "A time", inline = "DR_A", group = gDaily, active = dRedOn)
float dRedP1 = input.price(0.0, "A price", inline = "DR_A", group = gDaily, active = dRedOn)
int dRedT2 = input.time(0, "B time", inline = "DR_B", group = gDaily, active = dRedOn)
float dRedP2 = input.price(0.0, "B price", inline = "DR_B", group = gDaily, active = dRedOn)

string g4H = "3B — 4H TRENDLINES"
bool h4GreenOn = input.bool(false, "GREEN bullish", group = g4H)
int h4GreenT1 = input.time(0, "A time", inline = "4G_A", group = g4H, active = h4GreenOn)
float h4GreenP1 = input.price(0.0, "A price", inline = "4G_A", group = g4H, active = h4GreenOn)
int h4GreenT2 = input.time(0, "B time", inline = "4G_B", group = g4H, active = h4GreenOn)
float h4GreenP2 = input.price(0.0, "B price", inline = "4G_B", group = g4H, active = h4GreenOn)
bool h4RedOn = input.bool(false, "RED bearish", group = g4H)
int h4RedT1 = input.time(0, "A time", inline = "4R_A", group = g4H, active = h4RedOn)
float h4RedP1 = input.price(0.0, "A price", inline = "4R_A", group = g4H, active = h4RedOn)
int h4RedT2 = input.time(0, "B time", inline = "4R_B", group = g4H, active = h4RedOn)
float h4RedP2 = input.price(0.0, "B price", inline = "4R_B", group = g4H, active = h4RedOn)

string g1H = "3C — 1H TRENDLINES"
bool h1GreenOn = input.bool(false, "GREEN bullish", group = g1H)
int h1GreenT1 = input.time(0, "A time", inline = "1G_A", group = g1H, active = h1GreenOn)
float h1GreenP1 = input.price(0.0, "A price", inline = "1G_A", group = g1H, active = h1GreenOn)
int h1GreenT2 = input.time(0, "B time", inline = "1G_B", group = g1H, active = h1GreenOn)
float h1GreenP2 = input.price(0.0, "B price", inline = "1G_B", group = g1H, active = h1GreenOn)
bool h1RedOn = input.bool(false, "RED bearish", group = g1H)
int h1RedT1 = input.time(0, "A time", inline = "1R_A", group = g1H, active = h1RedOn)
float h1RedP1 = input.price(0.0, "A price", inline = "1R_A", group = g1H, active = h1RedOn)
int h1RedT2 = input.time(0, "B time", inline = "1R_B", group = g1H, active = h1RedOn)
float h1RedP2 = input.price(0.0, "B price", inline = "1R_B", group = g1H, active = h1RedOn)

string g15M = "3D — 15M TRENDLINES"
bool m15GreenOn = input.bool(false, "GREEN bullish", group = g15M)
int m15GreenT1 = input.time(0, "A time", inline = "15G_A", group = g15M, active = m15GreenOn)
float m15GreenP1 = input.price(0.0, "A price", inline = "15G_A", group = g15M, active = m15GreenOn)
int m15GreenT2 = input.time(0, "B time", inline = "15G_B", group = g15M, active = m15GreenOn)
float m15GreenP2 = input.price(0.0, "B price", inline = "15G_B", group = g15M, active = m15GreenOn)
bool m15RedOn = input.bool(false, "RED bearish", group = g15M)
int m15RedT1 = input.time(0, "A time", inline = "15R_A", group = g15M, active = m15RedOn)
float m15RedP1 = input.price(0.0, "A price", inline = "15R_A", group = g15M, active = m15RedOn)
int m15RedT2 = input.time(0, "B time", inline = "15R_B", group = g15M, active = m15RedOn)
float m15RedP2 = input.price(0.0, "B price", inline = "15R_B", group = g15M, active = m15RedOn)

string g5M = "3E — 5M TRENDLINES"
bool m5GreenOn = input.bool(false, "GREEN bullish", group = g5M)
int m5GreenT1 = input.time(0, "A time", inline = "5G_A", group = g5M, active = m5GreenOn)
float m5GreenP1 = input.price(0.0, "A price", inline = "5G_A", group = g5M, active = m5GreenOn)
int m5GreenT2 = input.time(0, "B time", inline = "5G_B", group = g5M, active = m5GreenOn)
float m5GreenP2 = input.price(0.0, "B price", inline = "5G_B", group = g5M, active = m5GreenOn)
bool m5RedOn = input.bool(false, "RED bearish", group = g5M)
int m5RedT1 = input.time(0, "A time", inline = "5R_A", group = g5M, active = m5RedOn)
float m5RedP1 = input.price(0.0, "A price", inline = "5R_A", group = g5M, active = m5RedOn)
int m5RedT2 = input.time(0, "B time", inline = "5R_B", group = g5M, active = m5RedOn)
float m5RedP2 = input.price(0.0, "B price", inline = "5R_B", group = g5M, active = m5RedOn)

// =============================================================================
// TEST-ONLY RUNTIME / CALIBRATION — NOT APPROVED MARKET SETTINGS
// =============================================================================
string gTest = "4 — PARITY TEST ONLY"
bool enableParityEngine = input.bool(false, "Enable test engine", group = gTest)
string runtimeMode = input.string("STUDY", "Runtime", options = ["STUDY", "LIVE_DECISION_SUPPORT"], group = gTest)
string feedAttestation = input.string("UNKNOWN", "Feed", options = ["UNKNOWN", "REALTIME", "DELAYED"], group = gTest)
float minBreak = input.float(0.25, "BREAK distance", minval = 0.25, step = 0.25, group = gTest)
float minPush = input.float(0.25, "PUSH distance", minval = 0.25, step = 0.25, group = gTest)
float maxRecoil = input.float(2.00, "Max recoil", minval = 0.0, step = 0.25, group = gTest)
float maxPushSeconds = input.float(60.0, "Max seconds per push", minval = 0.1, step = 0.1, group = gTest)
float dojiBodyFraction = input.float(0.10, "Doji body/range", minval = 0.0, maxval = 1.0, step = 0.01, group = gTest)

// =============================================================================
// COLORS
// =============================================================================
color GREEN_UP = color.rgb(0, 205, 105)
color RED_DOWN = color.rgb(230, 55, 70)
color BLUE_DAY = color.rgb(35, 112, 255)
color BLUE_WEEK = color.rgb(91, 82, 230)
color BLUE_TARGET = color.rgb(42, 118, 255)
color YELLOW_GO = color.rgb(255, 215, 0)
color ORANGE_WAIT = color.rgb(255, 155, 35)
color PANEL_DARK = color.rgb(18, 20, 25)
color PANEL_MID = color.rgb(37, 41, 49)
color GOLD_ACCENT = color.rgb(205, 165, 70)

// =============================================================================
// PLATFORM CONTEXT
// =============================================================================
bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool isNqMnq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool tickGridExpected = math.abs(syminfo.mintick - EXPECTED_TICK) < 1e-6
bool exactIntrabarAvailable = barstate.isrealtime
string chartTfText = timeframe.period
string chartStatus = isFiveMinute ? "5 MIN ✓" : chartTfText + " — USE 5 MIN"

// =============================================================================
// D/W LEVEL BRIDGE
// =============================================================================
[dHighCurrent, dLowCurrent, dCloseTimeCurrent] = request.security(syminfo.tickerid, "D", [high, low, time_close], lookahead = barmerge.lookahead_off)
[dHighPrev, dLowPrev] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wHighCurrent, wLowCurrent, wCloseTimeCurrent] = request.security(syminfo.tickerid, "W", [high, low, time_close], lookahead = barmerge.lookahead_off)
[wHighPrev, wLowPrev] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

int lastChartCloseTime = time_close
int closedGapMs = timenow - lastChartCloseTime
bool recentClosedGap = not barstate.isrealtime and closedGapMs >= 0 and closedGapMs <= NORMAL_CLOSED_GAP_MS
bool extendedClosedGap = not barstate.isrealtime and closedGapMs > NORMAL_CLOSED_GAP_MS
bool dailyCurrentCompletedNow = recentClosedGap and not na(dCloseTimeCurrent) and timenow >= dCloseTimeCurrent
bool weeklyCurrentCompletedNow = recentClosedGap and not na(wCloseTimeCurrent) and timenow >= wCloseTimeCurrent

float pdh = dailyCurrentCompletedNow ? dHighCurrent : dHighPrev
float pdl = dailyCurrentCompletedNow ? dLowCurrent : dLowPrev
float pwh = weeklyCurrentCompletedNow ? wHighCurrent : wHighPrev
float pwl = weeklyCurrentCompletedNow ? wLowCurrent : wLowPrev

bool dayValuesValid = not na(pdh) and not na(pdl)
bool weekValuesValid = not na(pwh) and not na(pwl)
bool dwValuesValid = dayValuesValid and weekValuesValid
string dwStatus = extendedClosedGap ? "EXTENDED CLOSE — D/W VERIFY" : recentClosedGap ? "CLOSED — LAST COMPLETED D/W" : barstate.isrealtime ? "LIVE — PRIOR COMPLETED D/W" : "HISTORICAL / STUDY"

plot(pdh, "PDH data", display = display.none)
plot(pdl, "PDL data", display = display.none)
plot(pwh, "PWH data", display = display.none)
plot(pwl, "PWL data", display = display.none)

// User visual contract: PDH + PDL are always on whenever valid.
// Weekly levels are visual-only contextual extras. "Near" is deliberately defined
// without an arbitrary point/ATR threshold: a weekly level is near when it is no
// farther from current price than the farther of the two always-visible daily levels.
float dailyVisualEnvelope = dayValuesValid ? math.max(math.abs(pdh - close), math.abs(pdl - close)) : na
bool showPdh = dayValuesValid
bool showPdl = dayValuesValid
bool showPwh = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwh - close) <= dailyVisualEnvelope
bool showPwl = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwl - close) <= dailyVisualEnvelope

// =============================================================================
// GRID VALIDATION
// =============================================================================
bool goSet = goLine > 0
float goTicks = goSet ? goLine / syminfo.mintick : na
bool goOnGrid = goSet and math.abs(goTicks - math.round(goTicks)) < 1e-7
bool targetEdgesPositive = safeTargetLow > 0 and safeTargetHigh > 0
bool targetSet = targetEdgesPositive and safeTargetHigh > safeTargetLow
float targetLowTicks = targetSet ? safeTargetLow / syminfo.mintick : na
float targetHighTicks = targetSet ? safeTargetHigh / syminfo.mintick : na
bool targetOnGrid = targetSet and math.abs(targetLowTicks - math.round(targetLowTicks)) < 1e-7 and math.abs(targetHighTicks - math.round(targetHighTicks)) < 1e-7

// =============================================================================
// TRENDLINE GEOMETRY
// =============================================================================
f_tl_valid(bool enabled, int t1, float p1, int t2, float p2) =>
    enabled and t1 > 0 and t2 > t1 and p1 > 0 and p2 > 0

f_tl_project(bool valid, int t1, float p1, int t2, float p2, int atTime) =>
    valid ? p2 + (float(atTime - t2) / float(t2 - t1)) * (p2 - p1) : na

int projectionTime = time_close
bool dGreenValid = f_tl_valid(dGreenOn, dGreenT1, dGreenP1, dGreenT2, dGreenP2)
bool dRedValid = f_tl_valid(dRedOn, dRedT1, dRedP1, dRedT2, dRedP2)
bool h4GreenValid = f_tl_valid(h4GreenOn, h4GreenT1, h4GreenP1, h4GreenT2, h4GreenP2)
bool h4RedValid = f_tl_valid(h4RedOn, h4RedT1, h4RedP1, h4RedT2, h4RedP2)
bool h1GreenValid = f_tl_valid(h1GreenOn, h1GreenT1, h1GreenP1, h1GreenT2, h1GreenP2)
bool h1RedValid = f_tl_valid(h1RedOn, h1RedT1, h1RedP1, h1RedT2, h1RedP2)
bool m15GreenValid = f_tl_valid(m15GreenOn, m15GreenT1, m15GreenP1, m15GreenT2, m15GreenP2)
bool m15RedValid = f_tl_valid(m15RedOn, m15RedT1, m15RedP1, m15RedT2, m15RedP2)
bool m5GreenValid = f_tl_valid(m5GreenOn, m5GreenT1, m5GreenP1, m5GreenT2, m5GreenP2)
bool m5RedValid = f_tl_valid(m5RedOn, m5RedT1, m5RedP1, m5RedT2, m5RedP2)

float dGreenNow = f_tl_project(dGreenValid, dGreenT1, dGreenP1, dGreenT2, dGreenP2, projectionTime)
float dRedNow = f_tl_project(dRedValid, dRedT1, dRedP1, dRedT2, dRedP2, projectionTime)
float h4GreenNow = f_tl_project(h4GreenValid, h4GreenT1, h4GreenP1, h4GreenT2, h4GreenP2, projectionTime)
float h4RedNow = f_tl_project(h4RedValid, h4RedT1, h4RedP1, h4RedT2, h4RedP2, projectionTime)
float h1GreenNow = f_tl_project(h1GreenValid, h1GreenT1, h1GreenP1, h1GreenT2, h1GreenP2, projectionTime)
float h1RedNow = f_tl_project(h1RedValid, h1RedT1, h1RedP1, h1RedT2, h1RedP2, projectionTime)
float m15GreenNow = f_tl_project(m15GreenValid, m15GreenT1, m15GreenP1, m15GreenT2, m15GreenP2, projectionTime)
float m15RedNow = f_tl_project(m15RedValid, m15RedT1, m15RedP1, m15RedT2, m15RedP2, projectionTime)
float m5GreenNow = f_tl_project(m5GreenValid, m5GreenT1, m5GreenP1, m5GreenT2, m5GreenP2, projectionTime)
float m5RedNow = f_tl_project(m5RedValid, m5RedT1, m5RedP1, m5RedT2, m5RedP2, projectionTime)

int activeTlCount = (dGreenValid ? 1 : 0) + (dRedValid ? 1 : 0) + (h4GreenValid ? 1 : 0) + (h4RedValid ? 1 : 0) + (h1GreenValid ? 1 : 0) + (h1RedValid ? 1 : 0) + (m15GreenValid ? 1 : 0) + (m15RedValid ? 1 : 0) + (m5GreenValid ? 1 : 0) + (m5RedValid ? 1 : 0)

array<float> tlDistances = array.from(
     dGreenValid ? math.abs(dGreenNow - close) : HUGE_DISTANCE,
     dRedValid ? math.abs(dRedNow - close) : HUGE_DISTANCE,
     h4GreenValid ? math.abs(h4GreenNow - close) : HUGE_DISTANCE,
     h4RedValid ? math.abs(h4RedNow - close) : HUGE_DISTANCE,
     h1GreenValid ? math.abs(h1GreenNow - close) : HUGE_DISTANCE,
     h1RedValid ? math.abs(h1RedNow - close) : HUGE_DISTANCE,
     m15GreenValid ? math.abs(m15GreenNow - close) : HUGE_DISTANCE,
     m15RedValid ? math.abs(m15RedNow - close) : HUGE_DISTANCE,
     m5GreenValid ? math.abs(m5GreenNow - close) : HUGE_DISTANCE,
     m5RedValid ? math.abs(m5RedNow - close) : HUGE_DISTANCE)
array<int> tlOrder = array.sort_indices(tlDistances, order.ascending)

f_tl_rank_visible(int idx) =>
    bool visible = false
    if trendlineVisibleCount > 0
        for k = 0 to trendlineVisibleCount - 1
            if array.get(tlOrder, k) == idx and array.get(tlDistances, idx) < HUGE_DISTANCE
                visible := true
    visible

// =============================================================================
// NEXT WALL — first deterministic vertical slice
// LONG scans RED trendlines overhead; SHORT scans GREEN trendlines below.
// PDH/PDL are always candidates in the plan direction. PWH/PWL join only when
// they satisfy the same weekly-near visual contract. This is route awareness,
// not an entry trigger and not a claim that price must react.
// =============================================================================
array<string> wallNames = array.new_string()
array<float> wallPrices = array.new_float()
array<int> wallTlIndices = array.new_int()

if planSide == "LONG"
    if dRedValid and dRedNow > close
        array.push(wallNames, "D RED")
        array.push(wallPrices, dRedNow)
        array.push(wallTlIndices, 1)
    if h4RedValid and h4RedNow > close
        array.push(wallNames, "4H RED")
        array.push(wallPrices, h4RedNow)
        array.push(wallTlIndices, 3)
    if h1RedValid and h1RedNow > close
        array.push(wallNames, "1H RED")
        array.push(wallPrices, h1RedNow)
        array.push(wallTlIndices, 5)
    if m15RedValid and m15RedNow > close
        array.push(wallNames, "15M RED")
        array.push(wallPrices, m15RedNow)
        array.push(wallTlIndices, 7)
    if m5RedValid and m5RedNow > close
        array.push(wallNames, "5M RED")
        array.push(wallPrices, m5RedNow)
        array.push(wallTlIndices, 9)
    if showPdh and pdh > close
        array.push(wallNames, "PDH")
        array.push(wallPrices, pdh)
        array.push(wallTlIndices, -1)
    if showPdl and pdl > close
        array.push(wallNames, "PDL")
        array.push(wallPrices, pdl)
        array.push(wallTlIndices, -1)
    if showPwh and pwh > close
        array.push(wallNames, "PWH")
        array.push(wallPrices, pwh)
        array.push(wallTlIndices, -1)
    if showPwl and pwl > close
        array.push(wallNames, "PWL")
        array.push(wallPrices, pwl)
        array.push(wallTlIndices, -1)
else
    if dGreenValid and dGreenNow < close
        array.push(wallNames, "D GREEN")
        array.push(wallPrices, dGreenNow)
        array.push(wallTlIndices, 0)
    if h4GreenValid and h4GreenNow < close
        array.push(wallNames, "4H GREEN")
        array.push(wallPrices, h4GreenNow)
        array.push(wallTlIndices, 2)
    if h1GreenValid and h1GreenNow < close
        array.push(wallNames, "1H GREEN")
        array.push(wallPrices, h1GreenNow)
        array.push(wallTlIndices, 4)
    if m15GreenValid and m15GreenNow < close
        array.push(wallNames, "15M GREEN")
        array.push(wallPrices, m15GreenNow)
        array.push(wallTlIndices, 6)
    if m5GreenValid and m5GreenNow < close
        array.push(wallNames, "5M GREEN")
        array.push(wallPrices, m5GreenNow)
        array.push(wallTlIndices, 8)
    if showPdh and pdh < close
        array.push(wallNames, "PDH")
        array.push(wallPrices, pdh)
        array.push(wallTlIndices, -1)
    if showPdl and pdl < close
        array.push(wallNames, "PDL")
        array.push(wallPrices, pdl)
        array.push(wallTlIndices, -1)
    if showPwh and pwh < close
        array.push(wallNames, "PWH")
        array.push(wallPrices, pwh)
        array.push(wallTlIndices, -1)
    if showPwl and pwl < close
        array.push(wallNames, "PWL")
        array.push(wallPrices, pwl)
        array.push(wallTlIndices, -1)

string nextWallName = "NONE LOADED AHEAD"
float nextWallPrice = na
int nextWallTlIndex = -1
float nextWallDistance = HUGE_DISTANCE
if array.size(wallPrices) > 0
    for i = 0 to array.size(wallPrices) - 1
        float candidatePrice = array.get(wallPrices, i)
        float candidateDistance = math.abs(candidatePrice - close)
        if candidateDistance < nextWallDistance
            nextWallDistance := candidateDistance
            nextWallName := array.get(wallNames, i)
            nextWallPrice := candidatePrice
            nextWallTlIndex := array.get(wallTlIndices, i)

string nextWallText = na(nextWallPrice) ? nextWallName : nextWallName + " @ " + str.tostring(nextWallPrice, format.mintick)

f_tl_show(int idx) =>
    f_tl_rank_visible(idx) or nextWallTlIndex == idx

// =============================================================================
// SCALE-SAFE PRICE DRAWINGS
// Daily/weekly horizontal levels use extend.both so the visible level spans the
// entire chart left and right. Inactive geometry remains NA to preserve reset view.
// =============================================================================
var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pwhLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pwlLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line goDraw = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.right)
var label pdhLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pdlLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pwhLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pwlLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label goLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var box targetBox = na
var label targetLabel = na

f_sync_level(line id, label lid, float price, string name, color c, bool visible, int width, bool fullSpan) =>
    bool valid = visible and not na(price) and price > 0
    if valid
        line.set_xy1(id, math.max(0, bar_index - 1), price)
        line.set_xy2(id, bar_index + 1, price)
        line.set_extend(id, fullSpan ? extend.both : extend.right)
        line.set_color(id, c)
        line.set_width(id, width)
        label.set_xy(lid, bar_index + 3, price)
        label.set_text(lid, name + "  " + str.tostring(price, format.mintick))
        label.set_color(lid, c)
        label.set_textcolor(lid, name == "GO LINE" ? color.black : color.white)
        label.set_size(lid, size.large)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

// Trendline drawing IDs. xloc.bar_time preserves anchor geometry across timeframe changes.
var line dGreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line dRedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)

var label dGreenLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label dRedLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label h4GreenLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label h4RedLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label h1GreenLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label h1RedLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label m15GreenLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label m15RedLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label m5GreenLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label m5RedLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)

f_sync_trend(line id, label lid, bool valid, bool visible, int t1, float p1, int t2, float p2, float projected, string name, color c) =>
    if valid and visible and not na(projected) and projected > 0
        line.set_xy1(id, t1, p1)
        line.set_xy2(id, t2, p2)
        line.set_color(id, c)
        line.set_width(id, nextWallName == name ? 3 : 2)
        label.set_xy(lid, projectionTime, projected)
        label.set_text(lid, name)
        label.set_color(lid, color.new(c, 10))
        label.set_textcolor(lid, color.white)
        label.set_size(lid, size.small)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

if barstate.islast
    f_sync_level(pdhLine, pdhLabel, pdh, "PDH", BLUE_DAY, showPdh, 2, true)
    f_sync_level(pdlLine, pdlLabel, pdl, "PDL", BLUE_DAY, showPdl, 2, true)
    f_sync_level(pwhLine, pwhLabel, pwh, "PWH", BLUE_WEEK, showPwh, 2, true)
    f_sync_level(pwlLine, pwlLabel, pwl, "PWL", BLUE_WEEK, showPwl, 2, true)
    f_sync_level(goDraw, goLabel, goLine, "GO LINE", YELLOW_GO, showGoLine and goSet and goOnGrid, 4, false)

    f_sync_trend(dGreenLine, dGreenLabel, dGreenValid, f_tl_show(0), dGreenT1, dGreenP1, dGreenT2, dGreenP2, dGreenNow, "D GREEN", GREEN_UP)
    f_sync_trend(dRedLine, dRedLabel, dRedValid, f_tl_show(1), dRedT1, dRedP1, dRedT2, dRedP2, dRedNow, "D RED", RED_DOWN)
    f_sync_trend(h4GreenLine, h4GreenLabel, h4GreenValid, f_tl_show(2), h4GreenT1, h4GreenP1, h4GreenT2, h4GreenP2, h4GreenNow, "4H GREEN", GREEN_UP)
    f_sync_trend(h4RedLine, h4RedLabel, h4RedValid, f_tl_show(3), h4RedT1, h4RedP1, h4RedT2, h4RedP2, h4RedNow, "4H RED", RED_DOWN)
    f_sync_trend(h1GreenLine, h1GreenLabel, h1GreenValid, f_tl_show(4), h1GreenT1, h1GreenP1, h1GreenT2, h1GreenP2, h1GreenNow, "1H GREEN", GREEN_UP)
    f_sync_trend(h1RedLine, h1RedLabel, h1RedValid, f_tl_show(5), h1RedT1, h1RedP1, h1RedT2, h1RedP2, h1RedNow, "1H RED", RED_DOWN)
    f_sync_trend(m15GreenLine, m15GreenLabel, m15GreenValid, f_tl_show(6), m15GreenT1, m15GreenP1, m15GreenT2, m15GreenP2, m15GreenNow, "15M GREEN", GREEN_UP)
    f_sync_trend(m15RedLine, m15RedLabel, m15RedValid, f_tl_show(7), m15RedT1, m15RedP1, m15RedT2, m15RedP2, m15RedNow, "15M RED", RED_DOWN)
    f_sync_trend(m5GreenLine, m5GreenLabel, m5GreenValid, f_tl_show(8), m5GreenT1, m5GreenP1, m5GreenT2, m5GreenP2, m5GreenNow, "5M GREEN", GREEN_UP)
    f_sync_trend(m5RedLine, m5RedLabel, m5RedValid, f_tl_show(9), m5RedT1, m5RedP1, m5RedT2, m5RedP2, m5RedNow, "5M RED", RED_DOWN)

    bool targetVisible = showSafeTarget and targetSet and targetOnGrid
    if targetVisible
        int boxLeft = math.max(0, bar_index - 35)
        int boxRight = bar_index + 10
        if na(targetBox)
            targetBox := box.new(boxLeft, safeTargetHigh, boxRight, safeTargetLow, xloc = xloc.bar_index, border_color = BLUE_TARGET, bgcolor = color.new(BLUE_TARGET, 84), border_width = 2)
        else
            box.set_lefttop(targetBox, boxLeft, safeTargetHigh)
            box.set_rightbottom(targetBox, boxRight, safeTargetLow)
            box.set_border_color(targetBox, BLUE_TARGET)
            box.set_bgcolor(targetBox, color.new(BLUE_TARGET, 84))
        float targetMid = (safeTargetHigh + safeTargetLow) / 2.0
        if na(targetLabel)
            targetLabel := label.new(bar_index + 3, targetMid, "SAFE TARGET", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = BLUE_TARGET, textcolor = color.white, size = size.large)
        else
            label.set_xy(targetLabel, bar_index + 3, targetMid)
            label.set_text(targetLabel, "SAFE TARGET")
            label.set_color(targetLabel, BLUE_TARGET)
            label.set_textcolor(targetLabel, color.white)
            label.set_size(targetLabel, size.large)
    else
        if not na(targetBox)
            box.delete(targetBox)
            targetBox := na
        if not na(targetLabel)
            label.delete(targetLabel)
            targetLabel := na

// =============================================================================
// BEGINNER SEMANTICS
// =============================================================================
bool directionKnown = bigDirection != "NOT SET"
bool planWithDirection = directionKnown and ((bigDirection == "UP" and planSide == "LONG") or (bigDirection == "DOWN" and planSide == "SHORT"))
string currentMoveText = not directionKnown ? "WAITING FOR DIRECTION" : planWithDirection ? (planSide == "LONG" ? "UP WITH BIG DIRECTION" : "DOWN WITH BIG DIRECTION") : (planSide == "LONG" ? "TEMPORARY UP MOVE" : "TEMPORARY DOWN MOVE")
string safeTargetText = targetSet and targetOnGrid ? str.tostring(safeTargetLow, format.mintick) + " – " + str.tostring(safeTargetHigh, format.mintick) : "NOT SET"
string trendlineLoadText = activeTlCount == 0 ? "NO TRENDLINES — SET A/B" : "TRENDLINES " + str.tostring(activeTlCount) + " LOADED"

// =============================================================================
// RUNTIME GUARDS
// =============================================================================
bool liveFeedAttested = feedAttestation == "REALTIME"
bool delayedLiveBlock = runtimeMode == "LIVE_DECISION_SUPPORT" and not liveFeedAttested
bool contextValid = isFiveMinute and isNqMnq and tickGridExpected and goSet and goOnGrid and not extendedClosedGap
bool engineRuntimeAllowed = enableParityEngine and contextValid and not delayedLiveBlock
bool actionableAllowed = LIVE_DECISION_SUPPORT_APPROVED and runtimeMode == "LIVE_DECISION_SUPPORT" and engineRuntimeAllowed and exactIntrabarAvailable

string runtimeReason =
     not isNqMnq ? "USE NQ OR MNQ" :
     not isFiveMinute ? "CHANGE CHART TO 5 MIN" :
     not tickGridExpected ? "TICK DATA CHECK NEEDED" :
     extendedClosedGap ? "EXTENDED CLOSE — VERIFY LEVELS" :
     not goSet ? "SET YELLOW GO LINE" :
     not goOnGrid ? "GO LINE MUST BE .00/.25/.50/.75" :
     targetEdgesPositive and not targetSet ? "SAFE TARGET EDGES INVALID" :
     targetSet and not targetOnGrid ? "SAFE TARGET MUST USE VALID TICKS" :
     delayedLiveBlock ? "LIVE FEED NOT CONFIRMED" :
     not enableParityEngine ? "TEST ENGINE OFF" :
     not exactIntrabarAvailable ? "WAITING FOR LIVE 5M CANDLE" :
     "TEST ENGINE RUNNING"

// =============================================================================
// 5M PARITY STATE MACHINE — TEST ONLY
// =============================================================================
f_is_doji_like(float o, float h, float l, float c, float threshold) =>
    float r = h - l
    r <= 0.0 ? true : math.abs(c - o) / r <= threshold

bool currentDojiLike = f_is_doji_like(open, high, low, close, dojiBodyFraction)
const string WAIT_REFERENCE = "WAIT_REFERENCE"
const string WAIT_BREAK = "WAIT_BREAK"
const string BREAK_STAGE = "BREAK"
const string PUSH_1 = "PUSH_1"
const string ENTRY_READY = "ENTRY_READY"

varip string stage = WAIT_REFERENCE
varip bool referenceArmed = false
varip float reference = na
varip float anchor = na
varip int referenceSourceBar = na
varip int lastStageTimeMs = na
varip int entryCount = 0
varip string lastTransition = "NONE"

bool eventReference = false
bool eventDojiVeto = false
bool eventBreak = false
bool eventPush1 = false
bool eventReady = false
bool eventRecoil = false
bool eventBarReset = false

float direction = planSide == "LONG" ? 1.0 : -1.0
float favorable = direction * close
float referenceFav = direction * reference
float anchorFav = direction * anchor

if engineRuntimeAllowed and exactIntrabarAvailable and referenceArmed and bar_index > referenceSourceBar and stage != ENTRY_READY
    bool recoilEligible = stage == BREAK_STAGE or stage == PUSH_1
    float recoil = recoilEligible and not na(anchor) ? anchorFav - favorable : 0.0
    if recoilEligible and recoil >= maxRecoil
        stage := WAIT_BREAK
        anchor := reference
        lastStageTimeMs := na
        lastTransition := "RECOIL — START OVER"
        eventRecoil := true
    else if stage == WAIT_BREAK
        if favorable >= referenceFav + minBreak
            stage := BREAK_STAGE
            anchor := close
            lastStageTimeMs := timenow
            lastTransition := "BREAK"
            eventBreak := true
    else if stage == BREAK_STAGE
        if favorable >= anchorFav + minPush
            float sec1 = na(lastStageTimeMs) ? 0.0 : (timenow - lastStageTimeMs) / 1000.0
            if sec1 <= maxPushSeconds
                stage := PUSH_1
                anchor := close
                lastStageTimeMs := timenow
                lastTransition := "PUSH 1"
                eventPush1 := true
            else
                lastTransition := "PUSH TOO SLOW — TEST RULE"
    else if stage == PUSH_1
        if favorable >= anchorFav + minPush
            float sec2 = na(lastStageTimeMs) ? 0.0 : (timenow - lastStageTimeMs) / 1000.0
            if sec2 <= maxPushSeconds
                stage := ENTRY_READY
                anchor := close
                lastStageTimeMs := timenow
                entryCount += 1
                lastTransition := "READY — TEST ONLY"
                eventReady := true
            else
                lastTransition := "PUSH 2 TOO SLOW — TEST RULE"

if engineRuntimeAllowed and exactIntrabarAvailable and barstate.isconfirmed
    bool beyondGo = planSide == "LONG" ? close > goLine : close < goLine
    if not referenceArmed
        if beyondGo
            if currentDojiLike
                stage := WAIT_REFERENCE
                lastTransition := "DOJI — NO ENTRY"
                eventDojiVeto := true
            else
                reference := planSide == "LONG" ? high : low
                anchor := reference
                referenceSourceBar := bar_index
                referenceArmed := true
                stage := WAIT_BREAK
                lastStageTimeMs := na
                lastTransition := "REFERENCE CANDLE SET"
                eventReference := true
    else if bar_index > referenceSourceBar and stage != ENTRY_READY
        reference := planSide == "LONG" ? high : low
        anchor := reference
        referenceSourceBar := bar_index
        stage := WAIT_BREAK
        lastStageTimeMs := na
        lastTransition := "NEW CANDLE — RESET TEST"
        eventBarReset := true

if not contextValid or delayedLiveBlock or not enableParityEngine
    stage := WAIT_REFERENCE
    referenceArmed := false
    reference := na
    anchor := na
    referenceSourceBar := na
    lastStageTimeMs := na
    lastTransition := runtimeReason

string stageText =
     stage == WAIT_REFERENCE ? "1  WAIT FOR CANDLE PAST GO LINE" :
     stage == WAIT_BREAK ? "2  REFERENCE SET — WAIT FOR BREAK" :
     stage == BREAK_STAGE ? "3  BREAK — WATCH PUSH 1" :
     stage == PUSH_1 ? "4  PUSH 1 — WATCH PUSH 2" :
     "5  READY — TEST ONLY"

color bigDirectionColor = bigDirection == "UP" ? GREEN_UP : bigDirection == "DOWN" ? RED_DOWN : color.gray
color moveColor = not directionKnown ? color.gray : planSide == "LONG" ? GREEN_UP : RED_DOWN
color stageColor = stage == ENTRY_READY ? GREEN_UP : stage == PUSH_1 ? color.aqua : stage == BREAK_STAGE ? YELLOW_GO : ORANGE_WAIT

// =============================================================================
// COMPACT PREMIUM BEGINNER COACH
// =============================================================================
var table coach = table.new(position.top_right, 2, 8, border_width = 2, frame_width = 2, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)
if barstate.islast
    if showCoach
        table.cell(coach, 0, 0, "SLUMDAWG", text_color = color.lime, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 1, 0, "5M COACH", text_color = color.white, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 0, 1, "BIG DIRECTION", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 1, bigDirection, text_color = color.white, bgcolor = bigDirectionColor, text_size = 16)
        table.cell(coach, 0, 2, "CURRENT MOVE", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 2, currentMoveText, text_color = color.white, bgcolor = moveColor, text_size = 15)
        table.cell(coach, 0, 3, "NEXT WALL", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 3, nextWallText, text_color = color.orange, text_size = 14)
        table.cell(coach, 0, 4, "GO LINE", text_color = color.black, bgcolor = YELLOW_GO, text_size = 15)
        table.cell(coach, 1, 4, goSet ? str.tostring(goLine, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 16)
        table.cell(coach, 0, 5, "SAFE TARGET", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 1, 5, safeTargetText, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 0, 6, "NOW", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 6, stageText, text_color = color.black, bgcolor = stageColor, text_size = 15)
        table.cell(coach, 0, 7, "SYSTEM", text_color = color.white, text_size = 14)
        table.cell(coach, 1, 7, trendlineLoadText + " | " + runtimeReason + " | " + chartStatus, text_color = activeTlCount == 0 ? color.orange : color.lime, text_size = 13)
    else
        for r = 0 to 7
            table.cell(coach, 0, r, "")
            table.cell(coach, 1, r, "")

// =============================================================================
// ENGINEERING DIAGNOSTICS — OFF BY DEFAULT
// =============================================================================
var table eng = table.new(position.bottom_left, 2, 12, border_width = 1, bgcolor = PANEL_DARK)
if barstate.islast
    if showEngineering
        table.cell(eng, 0, 0, "BUILD")
        table.cell(eng, 1, 0, BUILD_CLASSIFICATION)
        table.cell(eng, 0, 1, "LIVE APPROVED")
        table.cell(eng, 1, 1, LIVE_DECISION_SUPPORT_APPROVED ? "YES" : "NO")
        table.cell(eng, 0, 2, "ROOT / CONTRACT")
        table.cell(eng, 1, 2, syminfo.root + " / " + syminfo.ticker)
        table.cell(eng, 0, 3, "CHART TF")
        table.cell(eng, 1, 3, timeframe.period)
        table.cell(eng, 0, 4, "D/W STATUS")
        table.cell(eng, 1, 4, dwStatus)
        table.cell(eng, 0, 5, "PDH / PDL")
        table.cell(eng, 1, 5, str.tostring(pdh, format.mintick) + " / " + str.tostring(pdl, format.mintick))
        table.cell(eng, 0, 6, "PWH / PWL")
        table.cell(eng, 1, 6, str.tostring(pwh, format.mintick) + " / " + str.tostring(pwl, format.mintick))
        table.cell(eng, 0, 7, "WEEKLY VISIBLE")
        table.cell(eng, 1, 7, (showPwh ? "PWH " : "") + (showPwl ? "PWL" : ""))
        table.cell(eng, 0, 8, "NEXT WALL")
        table.cell(eng, 1, 8, nextWallText)
        table.cell(eng, 0, 9, "ACTIVE TL COUNT")
        table.cell(eng, 1, 9, str.tostring(activeTlCount))
        table.cell(eng, 0, 10, "REFERENCE")
        table.cell(eng, 1, 10, na(reference) ? "NA" : str.tostring(reference, format.mintick))
        table.cell(eng, 0, 11, "LAST RAW")
        table.cell(eng, 1, 11, lastTransition)
    else
        for r = 0 to 11
            table.cell(eng, 0, r, "")
            table.cell(eng, 1, r, "")

// =============================================================================
// OPTIONAL PARITY MARKERS / ALERTS — NON-ACTIONABLE
// =============================================================================
plotshape(showDebugMarkers and eventReference, title = "Reference", text = "REF", style = shape.labelup, location = location.belowbar, size = size.tiny, color = color.orange, textcolor = color.black)
plotshape(showDebugMarkers and eventDojiVeto, title = "Doji veto", text = "DOJI", style = shape.labeldown, location = location.abovebar, size = size.tiny, color = color.gray, textcolor = color.white)
plotshape(showDebugMarkers and eventBreak, title = "Break", text = "BREAK", style = shape.labelup, location = location.belowbar, size = size.tiny, color = YELLOW_GO, textcolor = color.black)
plotshape(showDebugMarkers and eventPush1, title = "Push 1", text = "P1", style = shape.labelup, location = location.belowbar, size = size.tiny, color = color.aqua, textcolor = color.black)
plotshape(showDebugMarkers and eventReady, title = "Ready", text = "READY", style = shape.labelup, location = location.belowbar, size = size.tiny, color = GREEN_UP, textcolor = color.white)
plotshape(showDebugMarkers and eventRecoil, title = "Recoil reset", text = "RESET", style = shape.labeldown, location = location.abovebar, size = size.tiny, color = RED_DOWN, textcolor = color.white)
plotshape(showDebugMarkers and eventBarReset, title = "New candle reset", text = "NEW\nCANDLE", style = shape.labeldown, location = location.abovebar, size = size.tiny, color = color.purple, textcolor = color.white)

alertcondition(eventBreak, "PARITY DEBUG — BREAK", "NON-ACTIONABLE parity event: BREAK")
alertcondition(eventPush1, "PARITY DEBUG — PUSH_1", "NON-ACTIONABLE parity event: PUSH_1")
alertcondition(eventReady, "PARITY DEBUG — ENTRY_READY", "NON-ACTIONABLE parity event: ENTRY_READY")
alertcondition(eventRecoil, "PARITY DEBUG — RECOIL_RESET", "NON-ACTIONABLE parity event: RECOIL_RESET")
