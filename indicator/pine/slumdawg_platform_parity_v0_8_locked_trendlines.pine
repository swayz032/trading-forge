//@version=6
indicator("Slumdawg traders indicator", shorttitle = "Slumdawg traders indicator", overlay = true, behind_chart = true, max_labels_count = 80, max_lines_count = 120, max_boxes_count = 20)

// PLATFORM PARITY / RESEARCH ONLY. NOT LIVE-DECISION-SUPPORT APPROVED.
const string BUILD_CLASSIFICATION = "PLATFORM_PARITY_ONLY"
const bool LIVE_DECISION_SUPPORT_APPROVED = false
const float EXPECTED_TICK = 0.25
const int NORMAL_CLOSED_GAP_MS = 72 * 60 * 60 * 1000
const float HUGE_DISTANCE = 1e12

// -----------------------------------------------------------------------------
// USER-FACING INPUTS
// -----------------------------------------------------------------------------
string gSetup = "1 — SETUP"
string bigDirection = input.string("NOT SET", "BIG DIRECTION", options = ["UP", "DOWN", "NOT SET"], group = gSetup, display = display.none)
string planSide = input.string("LONG", "PLAN", options = ["LONG", "SHORT"], group = gSetup, display = display.none)
float goLine = input.price(0.0, "GO LINE (yellow)", group = gSetup, display = display.none)
float safeTargetLow = input.price(0.0, "SAFE TARGET lower edge", group = gSetup, display = display.none)
float safeTargetHigh = input.price(0.0, "SAFE TARGET upper edge", group = gSetup, display = display.none)

string gView = "2 — CLEAN CHART"
bool autoTrendlines = input.bool(true, "Structural GREEN/RED trendlines", group = gView, tooltip = "Research/parity only. The engine chooses structural swing pairs, then LOCKS their anchors so they do not chase price.")
bool showWeeklyWhenNear = input.bool(true, "Show PWH/PWL when near", group = gView)
bool showCoach = input.bool(true, "Slumdawg coach", group = gView)
bool showGoLine = input.bool(true, "Yellow GO LINE", group = gView)
bool showSafeTarget = input.bool(true, "Blue SAFE TARGET", group = gView)
bool showDebugMarkers = input.bool(false, "Tiny parity markers", group = gView)

string gPicker = "2B — TRENDLINE PICKER"
int trendlineSet = input.int(1, "Trendline set", minval = 1, group = gPicker, tooltip = "Lines stay locked while this number is unchanged. Increase it by 1 only when you want the indicator to recapture the latest structural lines.")
bool showDGreen = input.bool(true, "Daily GREEN", inline = "D", group = gPicker)
bool showDRed = input.bool(true, "Daily RED", inline = "D", group = gPicker)
bool show4HGreen = input.bool(true, "4H GREEN", inline = "4H", group = gPicker)
bool show4HRed = input.bool(true, "4H RED", inline = "4H", group = gPicker)
bool show1HGreen = input.bool(true, "1H GREEN", inline = "1H", group = gPicker)
bool show1HRed = input.bool(true, "1H RED", inline = "1H", group = gPicker)
bool show15MGreen = input.bool(true, "15M GREEN", inline = "15M", group = gPicker)
bool show15MRed = input.bool(true, "15M RED", inline = "15M", group = gPicker)
bool show5MGreen = input.bool(true, "5M GREEN", inline = "5M", group = gPicker)
bool show5MRed = input.bool(true, "5M RED", inline = "5M", group = gPicker)

string gTest = "3 — PARITY TEST ONLY"
bool enableParityEngine = input.bool(false, "Enable test engine", group = gTest, display = display.none)
string runtimeMode = input.string("STUDY", "Runtime", options = ["STUDY", "LIVE_DECISION_SUPPORT"], group = gTest, display = display.none)
string feedAttestation = input.string("UNKNOWN", "Feed", options = ["UNKNOWN", "REALTIME", "DELAYED"], group = gTest, display = display.none)
float minBreak = input.float(0.25, "BREAK distance", minval = 0.25, step = 0.25, group = gTest, display = display.none)
float minPush = input.float(0.25, "PUSH distance", minval = 0.25, step = 0.25, group = gTest, display = display.none)
float maxRecoil = input.float(2.00, "Max recoil", minval = 0.0, step = 0.25, group = gTest, display = display.none)
float maxPushSeconds = input.float(60.0, "Max seconds per push", minval = 0.1, step = 0.1, group = gTest, display = display.none)
float dojiBodyFraction = input.float(0.10, "Doji body/range", minval = 0.0, maxval = 1.0, step = 0.01, group = gTest, display = display.none)

// -----------------------------------------------------------------------------
// COLORS
// -----------------------------------------------------------------------------
color GREEN_UP = color.rgb(0, 205, 105)
color RED_DOWN = color.rgb(230, 55, 70)
color BLUE_DAY = color.rgb(35, 112, 255)
color BLUE_WEEK = color.rgb(91, 82, 230)
color BLUE_TARGET = color.rgb(42, 118, 255)
color YELLOW_GO = color.rgb(255, 215, 0)
color ORANGE_WAIT = color.rgb(255, 155, 35)
color PANEL_DARK = color.rgb(18, 20, 25)
color PANEL_MID = color.rgb(37, 41, 49)
color GOLD_ACCENT = color.rgb(205, 165, 70)

// -----------------------------------------------------------------------------
// PLATFORM CONTEXT
// -----------------------------------------------------------------------------
bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool isNqMnq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool tickGridExpected = math.abs(syminfo.mintick - EXPECTED_TICK) < 1e-6
bool exactIntrabarAvailable = barstate.isrealtime
string chartStatus = isFiveMinute ? "5 MIN ✓" : timeframe.period + " — USE 5 MIN"

// -----------------------------------------------------------------------------
// PDH / PDL / PWH / PWL
// -----------------------------------------------------------------------------
[dHighCurrent, dLowCurrent, dCloseTimeCurrent] = request.security(syminfo.tickerid, "D", [high, low, time_close], lookahead = barmerge.lookahead_off)
[dHighPrev, dLowPrev] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wHighCurrent, wLowCurrent, wCloseTimeCurrent] = request.security(syminfo.tickerid, "W", [high, low, time_close], lookahead = barmerge.lookahead_off)
[wHighPrev, wLowPrev] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

int closedGapMs = timenow - time_close
bool recentClosedGap = not barstate.isrealtime and closedGapMs >= 0 and closedGapMs <= NORMAL_CLOSED_GAP_MS
bool extendedClosedGap = not barstate.isrealtime and closedGapMs > NORMAL_CLOSED_GAP_MS
bool dailyCurrentCompletedNow = recentClosedGap and not na(dCloseTimeCurrent) and timenow >= dCloseTimeCurrent
bool weeklyCurrentCompletedNow = recentClosedGap and not na(wCloseTimeCurrent) and timenow >= wCloseTimeCurrent

float pdh = dailyCurrentCompletedNow ? dHighCurrent : dHighPrev
float pdl = dailyCurrentCompletedNow ? dLowCurrent : dLowPrev
float pwh = weeklyCurrentCompletedNow ? wHighCurrent : wHighPrev
float pwl = weeklyCurrentCompletedNow ? wLowCurrent : wLowPrev
bool dayValuesValid = not na(pdh) and not na(pdl)
bool weekValuesValid = not na(pwh) and not na(pwl)
float dailyVisualEnvelope = dayValuesValid ? math.max(math.abs(pdh - close), math.abs(pdl - close)) : na
bool showPdh = dayValuesValid
bool showPdl = dayValuesValid
bool showPwh = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwh - close) <= dailyVisualEnvelope
bool showPwl = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwl - close) <= dailyVisualEnvelope

plot(pdh, "PDH data", display = display.none)
plot(pdl, "PDL data", display = display.none)
plot(pwh, "PWH data", display = display.none)
plot(pwl, "PWL data", display = display.none)

// -----------------------------------------------------------------------------
// STRUCTURAL TRENDLINE CANDIDATE ENGINE
// Prefer the widest clean pair among the last four confirmed swing points.
// Lower-timeframe close-up lines require a connected same-color bigger parent.
// Candidate discovery may update internally, but the DISPLAY/LOGIC anchor snapshot
// below is immutable until the operator increments Trendline set.
// -----------------------------------------------------------------------------
f_line_at(int t1, float p1, int t2, float p2, int atTime) =>
    t2 > t1 ? p1 + (float(atTime - t1) / float(t2 - t1)) * (p2 - p1) : na

f_structural_pack() =>
    float pl = ta.pivotlow(low, 2, 2)
    float ph = ta.pivothigh(high, 2, 2)
    bool hasPl = not na(pl)
    bool hasPh = not na(ph)
    int plT = hasPl ? time[2] : na
    int phT = hasPh ? time[2] : na

    float g0 = ta.valuewhen(hasPl, pl, 0)
    float g1 = ta.valuewhen(hasPl, pl, 1)
    float g2 = ta.valuewhen(hasPl, pl, 2)
    float g3 = ta.valuewhen(hasPl, pl, 3)
    int gt0 = ta.valuewhen(hasPl, plT, 0)
    int gt1 = ta.valuewhen(hasPl, plT, 1)
    int gt2 = ta.valuewhen(hasPl, plT, 2)
    int gt3 = ta.valuewhen(hasPl, plT, 3)

    bool g30Base = not na(g3) and not na(g0) and gt0 > gt3 and g0 > g3
    float g30At2 = g30Base ? f_line_at(gt3, g3, gt0, g0, gt2) : na
    float g30At1 = g30Base ? f_line_at(gt3, g3, gt0, g0, gt1) : na
    bool g30 = g30Base and g2 >= g30At2 - syminfo.mintick and g1 >= g30At1 - syminfo.mintick

    bool g20Base = not na(g2) and not na(g0) and gt0 > gt2 and g0 > g2
    float g20At1 = g20Base ? f_line_at(gt2, g2, gt0, g0, gt1) : na
    bool g20 = g20Base and g1 >= g20At1 - syminfo.mintick

    bool g10 = not na(g1) and not na(g0) and gt0 > gt1 and g0 > g1

    bool gValid = g30 or g20 or g10
    int gT1 = g30 ? gt3 : g20 ? gt2 : g10 ? gt1 : na
    float gP1 = g30 ? g3 : g20 ? g2 : g10 ? g1 : na
    int gT2 = gValid ? gt0 : na
    float gP2 = gValid ? g0 : na

    float r0 = ta.valuewhen(hasPh, ph, 0)
    float r1 = ta.valuewhen(hasPh, ph, 1)
    float r2 = ta.valuewhen(hasPh, ph, 2)
    float r3 = ta.valuewhen(hasPh, ph, 3)
    int rt0 = ta.valuewhen(hasPh, phT, 0)
    int rt1 = ta.valuewhen(hasPh, phT, 1)
    int rt2 = ta.valuewhen(hasPh, phT, 2)
    int rt3 = ta.valuewhen(hasPh, phT, 3)

    bool r30Base = not na(r3) and not na(r0) and rt0 > rt3 and r0 < r3
    float r30At2 = r30Base ? f_line_at(rt3, r3, rt0, r0, rt2) : na
    float r30At1 = r30Base ? f_line_at(rt3, r3, rt0, r0, rt1) : na
    bool r30 = r30Base and r2 <= r30At2 + syminfo.mintick and r1 <= r30At1 + syminfo.mintick

    bool r20Base = not na(r2) and not na(r0) and rt0 > rt2 and r0 < r2
    float r20At1 = r20Base ? f_line_at(rt2, r2, rt0, r0, rt1) : na
    bool r20 = r20Base and r1 <= r20At1 + syminfo.mintick

    bool r10 = not na(r1) and not na(r0) and rt0 > rt1 and r0 < r1

    bool rValid = r30 or r20 or r10
    int rT1 = r30 ? rt3 : r20 ? rt2 : r10 ? rt1 : na
    float rP1 = r30 ? r3 : r20 ? r2 : r10 ? r1 : na
    int rT2 = rValid ? rt0 : na
    float rP2 = rValid ? r0 : na

    [gValid, gT1, gP1, gT2, gP2, rValid, rT1, rP1, rT2, rP2]

[dGRaw, dGT1C, dGP1C, dGT2C, dGP2C, dRRaw, dRT1C, dRP1C, dRT2C, dRP2C] = request.security(syminfo.tickerid, "D", f_structural_pack(), lookahead = barmerge.lookahead_off)
[h4GRaw, h4GT1C, h4GP1C, h4GT2C, h4GP2C, h4RRaw, h4RT1C, h4RP1C, h4RT2C, h4RP2C] = request.security(syminfo.tickerid, "240", f_structural_pack(), lookahead = barmerge.lookahead_off)
[h1GRaw, h1GT1C, h1GP1C, h1GT2C, h1GP2C, h1RRaw, h1RT1C, h1RP1C, h1RT2C, h1RP2C] = request.security(syminfo.tickerid, "60", f_structural_pack(), lookahead = barmerge.lookahead_off)
[m15GRaw, m15GT1C, m15GP1C, m15GT2C, m15GP2C, m15RRaw, m15RT1C, m15RP1C, m15RT2C, m15RP2C] = request.security(syminfo.tickerid, "15", f_structural_pack(), lookahead = barmerge.lookahead_off)
[m5GRaw, m5GT1C, m5GP1C, m5GT2C, m5GP2C, m5RRaw, m5RT1C, m5RP1C, m5RT2C, m5RP2C] = request.security(syminfo.tickerid, "5", f_structural_pack(), lookahead = barmerge.lookahead_off)

f_anchor_connects(bool parentValid, int pt1, float pp1, int pt2, float pp2, int ct1, float cp1, int ct2, float cp2) =>
    bool a = false
    bool b = false
    if parentValid and not na(ct1) and not na(ct2)
        float py1 = f_line_at(pt1, pp1, pt2, pp2, ct1)
        float py2 = f_line_at(pt1, pp1, pt2, pp2, ct2)
        a := ct1 >= pt1 and not na(py1) and math.abs(py1 - cp1) <= syminfo.mintick
        b := ct2 >= pt1 and not na(py2) and math.abs(py2 - cp2) <= syminfo.mintick
    a or b

bool dGreenCandidate = autoTrendlines and dGRaw
bool dRedCandidate = autoTrendlines and dRRaw
bool h4GreenCandidate = autoTrendlines and h4GRaw and (not dGreenCandidate or f_anchor_connects(dGreenCandidate, dGT1C, dGP1C, dGT2C, dGP2C, h4GT1C, h4GP1C, h4GT2C, h4GP2C))
bool h4RedCandidate = autoTrendlines and h4RRaw and (not dRedCandidate or f_anchor_connects(dRedCandidate, dRT1C, dRP1C, dRT2C, dRP2C, h4RT1C, h4RP1C, h4RT2C, h4RP2C))

bool h1GreenHasParent = dGreenCandidate or h4GreenCandidate
bool h1RedHasParent = dRedCandidate or h4RedCandidate
bool h1GreenConnected =
     f_anchor_connects(h4GreenCandidate, h4GT1C, h4GP1C, h4GT2C, h4GP2C, h1GT1C, h1GP1C, h1GT2C, h1GP2C) or
     f_anchor_connects(dGreenCandidate, dGT1C, dGP1C, dGT2C, dGP2C, h1GT1C, h1GP1C, h1GT2C, h1GP2C)
bool h1RedConnected =
     f_anchor_connects(h4RedCandidate, h4RT1C, h4RP1C, h4RT2C, h4RP2C, h1RT1C, h1RP1C, h1RT2C, h1RP2C) or
     f_anchor_connects(dRedCandidate, dRT1C, dRP1C, dRT2C, dRP2C, h1RT1C, h1RP1C, h1RT2C, h1RP2C)
bool h1GreenCandidate = autoTrendlines and h1GRaw and (not h1GreenHasParent or h1GreenConnected)
bool h1RedCandidate = autoTrendlines and h1RRaw and (not h1RedHasParent or h1RedConnected)

bool m15GreenHasParent = dGreenCandidate or h4GreenCandidate or h1GreenCandidate
bool m15RedHasParent = dRedCandidate or h4RedCandidate or h1RedCandidate
bool m15GreenConnected =
     f_anchor_connects(h1GreenCandidate, h1GT1C, h1GP1C, h1GT2C, h1GP2C, m15GT1C, m15GP1C, m15GT2C, m15GP2C) or
     f_anchor_connects(h4GreenCandidate, h4GT1C, h4GP1C, h4GT2C, h4GP2C, m15GT1C, m15GP1C, m15GT2C, m15GP2C) or
     f_anchor_connects(dGreenCandidate, dGT1C, dGP1C, dGT2C, dGP2C, m15GT1C, m15GP1C, m15GT2C, m15GP2C)
bool m15RedConnected =
     f_anchor_connects(h1RedCandidate, h1RT1C, h1RP1C, h1RT2C, h1RP2C, m15RT1C, m15RP1C, m15RT2C, m15RP2C) or
     f_anchor_connects(h4RedCandidate, h4RT1C, h4RP1C, h4RT2C, h4RP2C, m15RT1C, m15RP1C, m15RT2C, m15RP2C) or
     f_anchor_connects(dRedCandidate, dRT1C, dRP1C, dRT2C, dRP2C, m15RT1C, m15RP1C, m15RT2C, m15RP2C)
bool m15GreenCandidate = autoTrendlines and m15GRaw and m15GreenHasParent and m15GreenConnected
bool m15RedCandidate = autoTrendlines and m15RRaw and m15RedHasParent and m15RedConnected

bool m5GreenHasParent = dGreenCandidate or h4GreenCandidate or h1GreenCandidate or m15GreenCandidate
bool m5RedHasParent = dRedCandidate or h4RedCandidate or h1RedCandidate or m15RedCandidate
bool m5GreenConnected =
     f_anchor_connects(m15GreenCandidate, m15GT1C, m15GP1C, m15GT2C, m15GP2C, m5GT1C, m5GP1C, m5GT2C, m5GP2C) or
     f_anchor_connects(h1GreenCandidate, h1GT1C, h1GP1C, h1GT2C, h1GP2C, m5GT1C, m5GP1C, m5GT2C, m5GP2C) or
     f_anchor_connects(h4GreenCandidate, h4GT1C, h4GP1C, h4GT2C, h4GP2C, m5GT1C, m5GP1C, m5GT2C, m5GP2C) or
     f_anchor_connects(dGreenCandidate, dGT1C, dGP1C, dGT2C, dGP2C, m5GT1C, m5GP1C, m5GT2C, m5GP2C)
bool m5RedConnected =
     f_anchor_connects(m15RedCandidate, m15RT1C, m15RP1C, m15RT2C, m15RP2C, m5RT1C, m5RP1C, m5RT2C, m5RP2C) or
     f_anchor_connects(h1RedCandidate, h1RT1C, h1RP1C, h1RT2C, h1RP2C, m5RT1C, m5RP1C, m5RT2C, m5RP2C) or
     f_anchor_connects(h4RedCandidate, h4RT1C, h4RP1C, h4RT2C, h4RP2C, m5RT1C, m5RP1C, m5RT2C, m5RP2C) or
     f_anchor_connects(dRedCandidate, dRT1C, dRP1C, dRT2C, dRP2C, m5RT1C, m5RP1C, m5RT2C, m5RP2C)
bool m5GreenCandidate = autoTrendlines and m5GRaw and m5GreenHasParent and m5GreenConnected
bool m5RedCandidate = autoTrendlines and m5RRaw and m5RedHasParent and m5RedConnected

// -----------------------------------------------------------------------------
// LOCKED ANCHOR SNAPSHOT
// This is the critical v0.8 correction: once captured, A/B timestamps and prices
// never change just because a new pivot prints or current price moves.
// Increment Trendline set to deliberately recapture all current structural lines.
// -----------------------------------------------------------------------------
var int capturedTrendlineSet = na
var bool dGreenValid = false
var bool dRedValid = false
var bool h4GreenValid = false
var bool h4RedValid = false
var bool h1GreenValid = false
var bool h1RedValid = false
var bool m15GreenValid = false
var bool m15RedValid = false
var bool m5GreenValid = false
var bool m5RedValid = false

var int dGT1 = na
var int dGT2 = na
var int dRT1 = na
var int dRT2 = na
var int h4GT1 = na
var int h4GT2 = na
var int h4RT1 = na
var int h4RT2 = na
var int h1GT1 = na
var int h1GT2 = na
var int h1RT1 = na
var int h1RT2 = na
var int m15GT1 = na
var int m15GT2 = na
var int m15RT1 = na
var int m15RT2 = na
var int m5GT1 = na
var int m5GT2 = na
var int m5RT1 = na
var int m5RT2 = na

var float dGP1 = na
var float dGP2 = na
var float dRP1 = na
var float dRP2 = na
var float h4GP1 = na
var float h4GP2 = na
var float h4RP1 = na
var float h4RP2 = na
var float h1GP1 = na
var float h1GP2 = na
var float h1RP1 = na
var float h1RP2 = na
var float m15GP1 = na
var float m15GP2 = na
var float m15RP1 = na
var float m15RP2 = na
var float m5GP1 = na
var float m5GP2 = na
var float m5RP1 = na
var float m5RP2 = na

if barstate.islast and (na(capturedTrendlineSet) or capturedTrendlineSet != trendlineSet)
    capturedTrendlineSet := trendlineSet

    dGreenValid := dGreenCandidate
    dRedValid := dRedCandidate
    h4GreenValid := h4GreenCandidate
    h4RedValid := h4RedCandidate
    h1GreenValid := h1GreenCandidate
    h1RedValid := h1RedCandidate
    m15GreenValid := m15GreenCandidate
    m15RedValid := m15RedCandidate
    m5GreenValid := m5GreenCandidate
    m5RedValid := m5RedCandidate

    dGT1 := dGT1C
    dGP1 := dGP1C
    dGT2 := dGT2C
    dGP2 := dGP2C
    dRT1 := dRT1C
    dRP1 := dRP1C
    dRT2 := dRT2C
    dRP2 := dRP2C

    h4GT1 := h4GT1C
    h4GP1 := h4GP1C
    h4GT2 := h4GT2C
    h4GP2 := h4GP2C
    h4RT1 := h4RT1C
    h4RP1 := h4RP1C
    h4RT2 := h4RT2C
    h4RP2 := h4RP2C

    h1GT1 := h1GT1C
    h1GP1 := h1GP1C
    h1GT2 := h1GT2C
    h1GP2 := h1GP2C
    h1RT1 := h1RT1C
    h1RP1 := h1RP1C
    h1RT2 := h1RT2C
    h1RP2 := h1RP2C

    m15GT1 := m15GT1C
    m15GP1 := m15GP1C
    m15GT2 := m15GT2C
    m15GP2 := m15GP2C
    m15RT1 := m15RT1C
    m15RP1 := m15RP1C
    m15RT2 := m15RT2C
    m15RP2 := m15RP2C

    m5GT1 := m5GT1C
    m5GP1 := m5GP1C
    m5GT2 := m5GT2C
    m5GP2 := m5GP2C
    m5RT1 := m5RT1C
    m5RP1 := m5RP1C
    m5RT2 := m5RT2C
    m5RP2 := m5RP2C

int projectionTime = time_close
float dGreenNow = dGreenValid ? f_line_at(dGT1, dGP1, dGT2, dGP2, projectionTime) : na
float dRedNow = dRedValid ? f_line_at(dRT1, dRP1, dRT2, dRP2, projectionTime) : na
float h4GreenNow = h4GreenValid ? f_line_at(h4GT1, h4GP1, h4GT2, h4GP2, projectionTime) : na
float h4RedNow = h4RedValid ? f_line_at(h4RT1, h4RP1, h4RT2, h4RP2, projectionTime) : na
float h1GreenNow = h1GreenValid ? f_line_at(h1GT1, h1GP1, h1GT2, h1GP2, projectionTime) : na
float h1RedNow = h1RedValid ? f_line_at(h1RT1, h1RP1, h1RT2, h1RP2, projectionTime) : na
float m15GreenNow = m15GreenValid ? f_line_at(m15GT1, m15GP1, m15GT2, m15GP2, projectionTime) : na
float m15RedNow = m15RedValid ? f_line_at(m15RT1, m15RP1, m15RT2, m15RP2, projectionTime) : na
float m5GreenNow = m5GreenValid ? f_line_at(m5GT1, m5GP1, m5GT2, m5GP2, projectionTime) : na
float m5RedNow = m5RedValid ? f_line_at(m5RT1, m5RP1, m5RT2, m5RP2, projectionTime) : na

int activeTlCount = (dGreenValid ? 1 : 0) + (dRedValid ? 1 : 0) + (h4GreenValid ? 1 : 0) + (h4RedValid ? 1 : 0) + (h1GreenValid ? 1 : 0) + (h1RedValid ? 1 : 0) + (m15GreenValid ? 1 : 0) + (m15RedValid ? 1 : 0) + (m5GreenValid ? 1 : 0) + (m5RedValid ? 1 : 0)

// -----------------------------------------------------------------------------
// NEXT WALL
// -----------------------------------------------------------------------------
array<string> wallNames = array.new_string()
array<float> wallPrices = array.new_float()

f_add_wall(bool condition, string name, float price) =>
    if condition and not na(price)
        array.push(wallNames, name)
        array.push(wallPrices, price)

if planSide == "LONG"
    f_add_wall(dRedValid and dRedNow > close, "D RED", dRedNow)
    f_add_wall(h4RedValid and h4RedNow > close, "4H RED", h4RedNow)
    f_add_wall(h1RedValid and h1RedNow > close, "1H RED", h1RedNow)
    f_add_wall(m15RedValid and m15RedNow > close, "15M RED", m15RedNow)
    f_add_wall(m5RedValid and m5RedNow > close, "5M RED", m5RedNow)
    f_add_wall(showPdh and pdh > close, "PDH", pdh)
    f_add_wall(showPwh and pwh > close, "PWH", pwh)
else
    f_add_wall(dGreenValid and dGreenNow < close, "D GREEN", dGreenNow)
    f_add_wall(h4GreenValid and h4GreenNow < close, "4H GREEN", h4GreenNow)
    f_add_wall(h1GreenValid and h1GreenNow < close, "1H GREEN", h1GreenNow)
    f_add_wall(m15GreenValid and m15GreenNow < close, "15M GREEN", m15GreenNow)
    f_add_wall(m5GreenValid and m5GreenNow < close, "5M GREEN", m5GreenNow)
    f_add_wall(showPdl and pdl < close, "PDL", pdl)
    f_add_wall(showPwl and pwl < close, "PWL", pwl)

string nextWallName = "NONE AHEAD"
float nextWallPrice = na
float nextWallDistance = HUGE_DISTANCE
if array.size(wallPrices) > 0
    for i = 0 to array.size(wallPrices) - 1
        float p = array.get(wallPrices, i)
        float dist = math.abs(p - close)
        if dist < nextWallDistance
            nextWallDistance := dist
            nextWallName := array.get(wallNames, i)
            nextWallPrice := p
string nextWallText = na(nextWallPrice) ? nextWallName : nextWallName + " @ " + str.tostring(nextWallPrice, format.mintick)

// -----------------------------------------------------------------------------
// DRAWINGS
// -----------------------------------------------------------------------------
var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pwhLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line pwlLine = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.both)
var line goDraw = line.new(na, na, na, na, xloc = xloc.bar_index, extend = extend.right)
var label pdhLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pdlLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pwhLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label pwlLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var label goLabel = label.new(na, na, "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left)
var box targetBox = na
var label targetLabel = na

f_sync_level(line id, label lid, float price, string name, color c, bool visible, int width, bool fullSpan) =>
    if visible and not na(price) and price > 0
        line.set_xy1(id, math.max(0, bar_index - 1), price)
        line.set_xy2(id, bar_index + 1, price)
        line.set_extend(id, fullSpan ? extend.both : extend.right)
        line.set_color(id, c)
        line.set_width(id, width)
        label.set_xy(lid, bar_index + 3, price)
        label.set_text(lid, name + "  " + str.tostring(price, format.mintick))
        label.set_color(lid, c)
        label.set_textcolor(lid, name == "GO LINE" ? color.black : color.white)
        label.set_size(lid, size.large)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

var line dGreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line dRedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h4RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line h1RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m15RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5GreenLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
var line m5RedLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)

f_sync_trend(line id, bool valid, bool visible, int t1, float p1, int t2, float p2, color c) =>
    if valid and visible and not na(t1) and not na(t2) and p1 > 0 and p2 > 0
        line.set_xy1(id, t1, p1)
        line.set_xy2(id, t2, p2)
        line.set_extend(id, extend.right)
        line.set_color(id, c)
        line.set_width(id, 2)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)

bool goSet = goLine > 0
float goTicks = goSet ? goLine / syminfo.mintick : na
bool goOnGrid = goSet and math.abs(goTicks - math.round(goTicks)) < 1e-7
bool targetSet = safeTargetLow > 0 and safeTargetHigh > safeTargetLow
float targetLowTicks = targetSet ? safeTargetLow / syminfo.mintick : na
float targetHighTicks = targetSet ? safeTargetHigh / syminfo.mintick : na
bool targetOnGrid = targetSet and math.abs(targetLowTicks - math.round(targetLowTicks)) < 1e-7 and math.abs(targetHighTicks - math.round(targetHighTicks)) < 1e-7

if barstate.islast
    f_sync_level(pdhLine, pdhLabel, pdh, "PDH", BLUE_DAY, showPdh, 2, true)
    f_sync_level(pdlLine, pdlLabel, pdl, "PDL", BLUE_DAY, showPdl, 2, true)
    f_sync_level(pwhLine, pwhLabel, pwh, "PWH", BLUE_WEEK, showPwh, 2, true)
    f_sync_level(pwlLine, pwlLabel, pwl, "PWL", BLUE_WEEK, showPwl, 2, true)
    f_sync_level(goDraw, goLabel, goLine, "GO LINE", YELLOW_GO, showGoLine and goSet and goOnGrid, 4, false)

    // Picker toggles only hide/show frozen lines; they never change A/B anchors.
    f_sync_trend(dGreenLine, dGreenValid, showDGreen, dGT1, dGP1, dGT2, dGP2, GREEN_UP)
    f_sync_trend(dRedLine, dRedValid, showDRed, dRT1, dRP1, dRT2, dRP2, RED_DOWN)
    f_sync_trend(h4GreenLine, h4GreenValid, show4HGreen, h4GT1, h4GP1, h4GT2, h4GP2, GREEN_UP)
    f_sync_trend(h4RedLine, h4RedValid, show4HRed, h4RT1, h4RP1, h4RT2, h4RP2, RED_DOWN)
    f_sync_trend(h1GreenLine, h1GreenValid, show1HGreen, h1GT1, h1GP1, h1GT2, h1GP2, GREEN_UP)
    f_sync_trend(h1RedLine, h1RedValid, show1HRed, h1RT1, h1RP1, h1RT2, h1RP2, RED_DOWN)
    f_sync_trend(m15GreenLine, m15GreenValid, show15MGreen, m15GT1, m15GP1, m15GT2, m15GP2, GREEN_UP)
    f_sync_trend(m15RedLine, m15RedValid, show15MRed, m15RT1, m15RP1, m15RT2, m15RP2, RED_DOWN)
    f_sync_trend(m5GreenLine, m5GreenValid, show5MGreen, m5GT1, m5GP1, m5GT2, m5GP2, GREEN_UP)
    f_sync_trend(m5RedLine, m5RedValid, show5MRed, m5RT1, m5RP1, m5RT2, m5RP2, RED_DOWN)

    bool targetVisible = showSafeTarget and targetSet and targetOnGrid
    if targetVisible
        int boxLeft = math.max(0, bar_index - 35)
        int boxRight = bar_index + 10
        if na(targetBox)
            targetBox := box.new(boxLeft, safeTargetHigh, boxRight, safeTargetLow, xloc = xloc.bar_index, border_color = BLUE_TARGET, bgcolor = color.new(BLUE_TARGET, 84), border_width = 2)
        else
            box.set_lefttop(targetBox, boxLeft, safeTargetHigh)
            box.set_rightbottom(targetBox, boxRight, safeTargetLow)
        float targetMid = (safeTargetHigh + safeTargetLow) / 2.0
        if na(targetLabel)
            targetLabel := label.new(bar_index + 3, targetMid, "SAFE TARGET", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = BLUE_TARGET, textcolor = color.white, size = size.large)
        else
            label.set_xy(targetLabel, bar_index + 3, targetMid)
    else
        if not na(targetBox)
            box.delete(targetBox)
            targetBox := na
        if not na(targetLabel)
            label.delete(targetLabel)
            targetLabel := na

// -----------------------------------------------------------------------------
// BEGINNER SEMANTICS / RUNTIME GUARDS
// -----------------------------------------------------------------------------
bool directionKnown = bigDirection != "NOT SET"
bool planWithDirection = directionKnown and ((bigDirection == "UP" and planSide == "LONG") or (bigDirection == "DOWN" and planSide == "SHORT"))
string currentMoveText = not directionKnown ? "WAITING FOR DIRECTION" : planWithDirection ? (planSide == "LONG" ? "UP WITH BIG DIRECTION" : "DOWN WITH BIG DIRECTION") : (planSide == "LONG" ? "TEMPORARY UP MOVE" : "TEMPORARY DOWN MOVE")
string safeTargetText = targetSet and targetOnGrid ? str.tostring(safeTargetLow, format.mintick) + " – " + str.tostring(safeTargetHigh, format.mintick) : "NOT SET"
string trendlineText = autoTrendlines ? (activeTlCount > 0 ? str.tostring(activeTlCount) + " LOCKED LINES" : "NO CONNECTED LINE YET") : "TRENDLINES OFF"

bool liveFeedAttested = feedAttestation == "REALTIME"
bool delayedLiveBlock = runtimeMode == "LIVE_DECISION_SUPPORT" and not liveFeedAttested
bool contextValid = isFiveMinute and isNqMnq and tickGridExpected and goSet and goOnGrid and not extendedClosedGap
bool engineRuntimeAllowed = enableParityEngine and contextValid and not delayedLiveBlock
string runtimeReason =
     not isNqMnq ? "USE NQ OR MNQ" :
     not isFiveMinute ? "CHANGE CHART TO 5 MIN" :
     not tickGridExpected ? "TICK DATA CHECK NEEDED" :
     extendedClosedGap ? "EXTENDED CLOSE — VERIFY LEVELS" :
     not goSet ? "SET YELLOW GO LINE" :
     not goOnGrid ? "GO LINE MUST BE .00/.25/.50/.75" :
     targetSet and not targetOnGrid ? "SAFE TARGET TICK CHECK" :
     delayedLiveBlock ? "LIVE FEED NOT CONFIRMED" :
     not enableParityEngine ? "TEST ENGINE OFF" :
     not exactIntrabarAvailable ? "WAITING FOR LIVE 5M CANDLE" :
     "TEST ENGINE RUNNING"

// -----------------------------------------------------------------------------
// TEST-ONLY 5M MOMENTUM STATE MACHINE
// -----------------------------------------------------------------------------
f_is_doji_like(float o, float h, float l, float c, float threshold) =>
    float r = h - l
    r <= 0.0 ? true : math.abs(c - o) / r <= threshold

const string WAIT_REFERENCE = "WAIT_REFERENCE"
const string WAIT_BREAK = "WAIT_BREAK"
const string BREAK_STAGE = "BREAK"
const string PUSH_1 = "PUSH_1"
const string ENTRY_READY = "ENTRY_READY"
varip string stage = WAIT_REFERENCE
varip bool referenceArmed = false
varip float reference = na
varip float anchor = na
varip int referenceSourceBar = na
varip int lastStageTimeMs = na
varip string lastTransition = "NONE"

bool eventBreak = false
bool eventPush1 = false
bool eventReady = false
bool eventRecoil = false
float direction = planSide == "LONG" ? 1.0 : -1.0
float favorable = direction * close
float referenceFav = direction * reference
float anchorFav = direction * anchor

if engineRuntimeAllowed and exactIntrabarAvailable and referenceArmed and bar_index > referenceSourceBar and stage != ENTRY_READY
    bool recoilEligible = stage == BREAK_STAGE or stage == PUSH_1
    float recoil = recoilEligible and not na(anchor) ? anchorFav - favorable : 0.0
    if recoilEligible and recoil >= maxRecoil
        stage := WAIT_BREAK
        anchor := reference
        lastStageTimeMs := na
        lastTransition := "RECOIL — START OVER"
        eventRecoil := true
    else if stage == WAIT_BREAK
        if favorable >= referenceFav + minBreak
            stage := BREAK_STAGE
            anchor := close
            lastStageTimeMs := timenow
            lastTransition := "BREAK"
            eventBreak := true
    else if stage == BREAK_STAGE
        if favorable >= anchorFav + minPush
            float sec1 = na(lastStageTimeMs) ? 0.0 : (timenow - lastStageTimeMs) / 1000.0
            if sec1 <= maxPushSeconds
                stage := PUSH_1
                anchor := close
                lastStageTimeMs := timenow
                lastTransition := "PUSH 1"
                eventPush1 := true
    else if stage == PUSH_1
        if favorable >= anchorFav + minPush
            float sec2 = na(lastStageTimeMs) ? 0.0 : (timenow - lastStageTimeMs) / 1000.0
            if sec2 <= maxPushSeconds
                stage := ENTRY_READY
                anchor := close
                lastStageTimeMs := timenow
                lastTransition := "READY — TEST ONLY"
                eventReady := true

if engineRuntimeAllowed and exactIntrabarAvailable and barstate.isconfirmed
    bool beyondGo = planSide == "LONG" ? close > goLine : close < goLine
    if not referenceArmed and beyondGo
        if not f_is_doji_like(open, high, low, close, dojiBodyFraction)
            reference := planSide == "LONG" ? high : low
            anchor := reference
            referenceSourceBar := bar_index
            referenceArmed := true
            stage := WAIT_BREAK
            lastStageTimeMs := na
            lastTransition := "REFERENCE CANDLE SET"
    else if referenceArmed and bar_index > referenceSourceBar and stage != ENTRY_READY
        reference := planSide == "LONG" ? high : low
        anchor := reference
        referenceSourceBar := bar_index
        stage := WAIT_BREAK
        lastStageTimeMs := na
        lastTransition := "NEW CANDLE — RESET TEST"

if not contextValid or delayedLiveBlock or not enableParityEngine
    stage := WAIT_REFERENCE
    referenceArmed := false
    reference := na
    anchor := na
    referenceSourceBar := na
    lastStageTimeMs := na
    lastTransition := runtimeReason

string stageText =
     stage == WAIT_REFERENCE ? "1  WAIT FOR CANDLE PAST GO LINE" :
     stage == WAIT_BREAK ? "2  REFERENCE SET — WAIT FOR BREAK" :
     stage == BREAK_STAGE ? "3  BREAK — WATCH PUSH 1" :
     stage == PUSH_1 ? "4  PUSH 1 — WATCH PUSH 2" :
     "5  READY — TEST ONLY"

// -----------------------------------------------------------------------------
// PREMIUM BEGINNER COACH
// -----------------------------------------------------------------------------
color bigDirectionColor = bigDirection == "UP" ? GREEN_UP : bigDirection == "DOWN" ? RED_DOWN : color.gray
color moveColor = not directionKnown ? color.gray : planSide == "LONG" ? GREEN_UP : RED_DOWN
color stageColor = stage == ENTRY_READY ? GREEN_UP : stage == PUSH_1 ? color.aqua : stage == BREAK_STAGE ? YELLOW_GO : ORANGE_WAIT
var table coach = table.new(position.top_right, 2, 9, border_width = 2, frame_width = 2, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)
if barstate.islast
    if showCoach
        table.cell(coach, 0, 0, "SLUMDAWG", text_color = color.lime, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 1, 0, "5M COACH", text_color = color.white, bgcolor = PANEL_MID, text_size = 18)
        table.cell(coach, 0, 1, "BIG DIRECTION", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 1, bigDirection, text_color = color.white, bgcolor = bigDirectionColor, text_size = 16)
        table.cell(coach, 0, 2, "CURRENT MOVE", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 2, currentMoveText, text_color = color.white, bgcolor = moveColor, text_size = 15)
        table.cell(coach, 0, 3, "TRENDLINES", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 3, trendlineText, text_color = activeTlCount > 0 ? color.lime : color.orange, text_size = 13)
        table.cell(coach, 0, 4, "NEXT WALL", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 4, nextWallText, text_color = color.orange, text_size = 14)
        table.cell(coach, 0, 5, "GO LINE", text_color = color.black, bgcolor = YELLOW_GO, text_size = 15)
        table.cell(coach, 1, 5, goSet ? str.tostring(goLine, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 16)
        table.cell(coach, 0, 6, "SAFE TARGET", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 1, 6, safeTargetText, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 15)
        table.cell(coach, 0, 7, "NOW", text_color = color.white, text_size = 15)
        table.cell(coach, 1, 7, stageText, text_color = color.black, bgcolor = stageColor, text_size = 15)
        table.cell(coach, 0, 8, "SYSTEM", text_color = color.white, text_size = 14)
        table.cell(coach, 1, 8, runtimeReason + " | " + chartStatus, text_color = runtimeReason == "TEST ENGINE RUNNING" ? color.lime : color.orange, text_size = 13)
    else
        for r = 0 to 8
            table.cell(coach, 0, r, "")
            table.cell(coach, 1, r, "")

plotshape(showDebugMarkers and eventBreak, title = "Break", text = "BREAK", style = shape.labelup, location = location.belowbar, size = size.tiny, color = YELLOW_GO, textcolor = color.black)
plotshape(showDebugMarkers and eventPush1, title = "Push 1", text = "P1", style = shape.labelup, location = location.belowbar, size = size.tiny, color = color.aqua, textcolor = color.black)
plotshape(showDebugMarkers and eventReady, title = "Ready", text = "READY", style = shape.labelup, location = location.belowbar, size = size.tiny, color = GREEN_UP, textcolor = color.white)
plotshape(showDebugMarkers and eventRecoil, title = "Recoil reset", text = "RESET", style = shape.labeldown, location = location.abovebar, size = size.tiny, color = RED_DOWN, textcolor = color.white)

alertcondition(eventBreak, "PARITY DEBUG — BREAK", "NON-ACTIONABLE parity event: BREAK")
alertcondition(eventPush1, "PARITY DEBUG — PUSH_1", "NON-ACTIONABLE parity event: PUSH_1")
alertcondition(eventReady, "PARITY DEBUG — ENTRY_READY", "NON-ACTIONABLE parity event: ENTRY_READY")
alertcondition(eventRecoil, "PARITY DEBUG — RECOIL_RESET", "NON-ACTIONABLE parity event: RECOIL_RESET")
