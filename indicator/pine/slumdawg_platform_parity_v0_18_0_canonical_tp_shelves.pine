//@version=6
indicator("Slumdawg traders indicator", shorttitle = "SLUMDAWG", overlay = true, behind_chart = true, max_bars_back = 2200, max_labels_count = 140, max_lines_count = 90, max_boxes_count = 10)

// v0.18.0 — CANONICAL TP SHELVES + SAFE-INTERIOR TARGETS
// PLATFORM PARITY / RESEARCH ONLY. NOT LIVE-DECISION-SUPPORT APPROVED.
//
// Aug-10 operator correction / upgrade:
// - Preserve v0.17.3 BIG DIRECTION, CURRENT MOVE, entry-state, and ENTRY CONFIRMATION semantics.
// - TP candidates from 5m/15m/1H/4H are NOT ranked directly anymore.
// - First, every overlapping/adjacent candidate is expanded transitively into ONE canonical
//   physical reaction shelf. A 5m and 15m description of the same shelf can consume only one TP.
// - TP1/TP2/TP3 are ranked from canonical shelf bounds, never from lane target-price spacing.
// - The displayed TP is recomputed from the FULL canonical shelf after fusion.
// - Auto TP must be strictly inside the canonical shelf by at least one valid tick on each side;
//   a shelf too narrow to contain an interior tick fails closed instead of placing TP on the edge.
// - Penetration remains an explicitly research/calibration parameter; no edge-hugging fallback.

const bool LIVE_DECISION_SUPPORT_APPROVED = false
const float EXPECTED_TICK = 0.25
const int NORMAL_CLOSED_GAP_MS = 72 * 60 * 60 * 1000
const float HUGE_DISTANCE = 1e12
const int LEVEL_LABEL_OFFSET_BARS = 16
const int FALLBACK_BAR_MS = 5 * 60 * 1000
const int ENTRY_PIVOT_LEFT = 2
const int ENTRY_PIVOT_RIGHT = 2
const int MOVE_PIVOT_LEFT = 2
const int MOVE_PIVOT_RIGHT = 2
const int BIG_4H_PIVOT_LEFT = 6
const int BIG_4H_PIVOT_RIGHT = 6
const int BIG_D_PIVOT_LEFT = 2
const int BIG_D_PIVOT_RIGHT = 2

string gSetup = "1 - SETUP"
string directionMode = input.string("AUTO", "BIG DIRECTION MODE", options = ["AUTO", "MANUAL"], group = gSetup, display = display.none)
string manualBigDirection = input.string("DOWN", "MANUAL BIG DIRECTION", options = ["UP", "DOWN"], group = gSetup, display = display.none)
string planMode = input.string("AUTO", "PLAN MODE", options = ["AUTO", "MANUAL"], group = gSetup, display = display.none)
string manualPlanSide = input.string("SHORT", "MANUAL PLAN", options = ["LONG", "SHORT"], group = gSetup, display = display.none)
string entryMode = input.string("AUTO", "ENTRY LEVEL MODE", options = ["AUTO", "MANUAL"], group = gSetup, display = display.none)
float manualLongEntry = input.price(0.0, "MANUAL LONG ENTRY", group = gSetup, display = display.none)
float manualShortEntry = input.price(0.0, "MANUAL SHORT ENTRY", group = gSetup, display = display.none)
string targetMode = input.string("AUTO", "TAKE PROFIT MODE", options = ["AUTO", "MANUAL"], group = gSetup, display = display.none)
float manualTargetLow = input.price(0.0, "MANUAL TAKE PROFIT lower edge", group = gSetup, display = display.none)
float manualTargetHigh = input.price(0.0, "MANUAL TAKE PROFIT upper edge", group = gSetup, display = display.none)

string gView = "2 - DISPLAY"
bool showCoach = input.bool(true, "Show Slumdawg Traders panel", group = gView)
bool showWeeklyWhenNear = input.bool(true, "Show PWH/PWL when near", group = gView)
bool showEntryLines = input.bool(true, "Show LONG/SHORT entry zones", group = gView)
bool showTakeProfitZones = input.bool(true, "Show Take Profit Zones", group = gView)
bool showBothTpSides = input.bool(true, "Show both LONG/SHORT TP ladders", group = gView)

string gTpResearch = "3 - TP RESEARCH (CALIBRATION REQUIRED)"
int tpMinTouches15 = input.int(2, "15m minimum reactions", minval = 2, maxval = 4, group = gTpResearch)
int tpMinTouches5 = input.int(3, "5m fallback minimum reactions", minval = 2, maxval = 6, group = gTpResearch)
float tpClusterToleranceAtr = input.float(0.25, "15m cluster tolerance × ATR", minval = 0.05, maxval = 0.75, step = 0.05, group = gTpResearch)
float tpEntrySeparationAtr = input.float(0.35, "Entry separation × 15m ATR", minval = 0.10, maxval = 1.50, step = 0.05, group = gTpResearch)
float tpZoneSeparationAtr = input.float(0.15, "TP-to-TP separation × 15m ATR", minval = 0.05, maxval = 0.75, step = 0.05, group = gTpResearch)
float tpCanonicalFusionAtr = input.float(0.25, "Cross-TF canonical shelf fusion × 15m ATR", minval = 0.05, maxval = 1.00, step = 0.05, group = gTpResearch, tooltip = "Experimental. Candidate zones within this structural allowance are transitively fused into one physical shelf before TP numbering.")
float tpPenetrationFraction = input.float(0.25, "Safe TP penetration into canonical shelf", minval = 0.05, maxval = 0.45, step = 0.05, group = gTpResearch, tooltip = "Applied AFTER cross-timeframe shelf fusion. Auto target must remain at least one valid tick inside both shelf edges.")

string gMomentum = "4 - ENTRY MOMENTUM (CALIBRATION REQUIRED)"
int momentumMinBreakTicks = input.int(1, "Minimum break ticks", minval = 1, maxval = 20, group = gMomentum)
float momentumPushAtr = input.float(0.08, "PUSH distance × 5m ATR", minval = 0.02, maxval = 0.50, step = 0.01, group = gMomentum)
float momentumRecoilAtr = input.float(0.20, "Hard recoil × 5m ATR", minval = 0.05, maxval = 1.00, step = 0.05, group = gMomentum)
float referenceMinBodyFraction = input.float(0.15, "Minimum proof-candle body/range", minval = 0.0, maxval = 0.50, step = 0.05, group = gMomentum)

string gCandle = "5 - CANDLE QUALITY RESEARCH"
float candleDojiBodyMax = input.float(0.15, "Doji max body/range", minval = 0.02, maxval = 0.35, step = 0.01, group = gCandle)
float candleRejectWickMin = input.float(0.45, "Rejection wick min fraction", minval = 0.20, maxval = 0.80, step = 0.05, group = gCandle)
float candleStrongBodyMin = input.float(0.60, "Strong engulf body/range", minval = 0.30, maxval = 0.90, step = 0.05, group = gCandle)
float candleStrongRangeAtr = input.float(0.80, "Strong engulf range × 5m ATR", minval = 0.30, maxval = 2.00, step = 0.05, group = gCandle)
float candleCloseQualityMin = input.float(0.75, "Close near favorable extreme", minval = 0.55, maxval = 0.95, step = 0.05, group = gCandle)
float candleOppWickMax = input.float(0.20, "Max rejection wick against continuation", minval = 0.05, maxval = 0.50, step = 0.05, group = gCandle)
float candleMinRoomAtr = input.float(1.0, "Minimum room to TP1 × 5m ATR", minval = 0.25, maxval = 4.0, step = 0.25, group = gCandle)

color GREEN_UP = color.rgb(0, 205, 105)
color RED_DOWN = color.rgb(230, 55, 70)
color BLUE_DAY = color.rgb(35, 112, 255)
color BLUE_WEEK = color.rgb(91, 82, 230)
color BLUE_TARGET = color.rgb(42, 118, 255)
color YELLOW_GO = color.rgb(255, 190, 25)
color ORANGE_WAIT = color.rgb(255, 155, 35)
color PANEL_DARK = color.rgb(18, 20, 25)
color PANEL_MID = color.rgb(37, 41, 49)
color GOLD_ACCENT = color.rgb(205, 165, 70)

bool isNqMnq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool tickGridExpected = math.abs(syminfo.mintick - EXPECTED_TICK) < 1e-6
bool planningViewSupported = timeframe.isminutes and timeframe.multiplier <= 15
bool entryEngineSupported = timeframe.isminutes and timeframe.multiplier == 5

// -----------------------------------------------------------------------------
// FROZEN D/W KEY LEVELS
// -----------------------------------------------------------------------------
[dHighCurrent, dLowCurrent, dCloseTimeCurrent] = request.security(syminfo.tickerid, "D", [high, low, time_close], lookahead = barmerge.lookahead_off)
[dHighPrev, dLowPrev] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wHighCurrent, wLowCurrent, wCloseTimeCurrent] = request.security(syminfo.tickerid, "W", [high, low, time_close], lookahead = barmerge.lookahead_off)
[wHighPrev, wLowPrev] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

int closedGapMs = timenow - time_close
bool recentClosedGap = not barstate.isrealtime and closedGapMs >= 0 and closedGapMs <= NORMAL_CLOSED_GAP_MS
bool extendedClosedGap = not barstate.isrealtime and closedGapMs > NORMAL_CLOSED_GAP_MS
bool dailyCurrentCompletedNow = recentClosedGap and not na(dCloseTimeCurrent) and timenow >= dCloseTimeCurrent
bool weeklyCurrentCompletedNow = recentClosedGap and not na(wCloseTimeCurrent) and timenow >= wCloseTimeCurrent

float pdh = dailyCurrentCompletedNow ? dHighCurrent : dHighPrev
float pdl = dailyCurrentCompletedNow ? dLowCurrent : dLowPrev
float pwh = weeklyCurrentCompletedNow ? wHighCurrent : wHighPrev
float pwl = weeklyCurrentCompletedNow ? wLowCurrent : wLowPrev

bool dayValuesValid = not na(pdh) and not na(pdl)
bool weekValuesValid = not na(pwh) and not na(pwl)
float dailyVisualEnvelope = dayValuesValid ? math.max(math.abs(pdh - close), math.abs(pdl - close)) : na
bool showPdh = dayValuesValid
bool showPdl = dayValuesValid
bool showPwh = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwh - close) <= dailyVisualEnvelope
bool showPwl = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwl - close) <= dailyVisualEnvelope

plot(pdh, "PDH data", display = display.none)
plot(pdl, "PDL data", display = display.none)
plot(pwh, "PWH data", display = display.none)
plot(pwl, "PWL data", display = display.none)

// -----------------------------------------------------------------------------
// CANONICAL MACRO CONTEXT
// Daily = macro authority when clear. Major 4H = fallback when Daily is unclear.
// -----------------------------------------------------------------------------
f_structure_snapshot(int leftBars, int rightBars) =>
    float ph = ta.pivothigh(high, leftBars, rightBars)
    float pl = ta.pivotlow(low, leftBars, rightBars)
    float h0 = ta.valuewhen(not na(ph), ph, 0)
    float h1 = ta.valuewhen(not na(ph), ph, 1)
    float l0 = ta.valuewhen(not na(pl), pl, 0)
    float l1 = ta.valuewhen(not na(pl), pl, 1)
    [close[1], h0[1], h1[1], l0[1], l1[1]]

f_clear_dir(float h0, float h1, float l0, float l1) =>
    bool enough = not na(h0) and not na(h1) and not na(l0) and not na(l1)
    enough and h0 > h1 and l0 > l1 ? 1 : enough and h0 < h1 and l0 < l1 ? -1 : 0

[dStructClose, dH0, dH1, dL0, dL1] = request.security(syminfo.tickerid, "D", f_structure_snapshot(BIG_D_PIVOT_LEFT, BIG_D_PIVOT_RIGHT), lookahead = barmerge.lookahead_off)
[h4StructClose, h4H0, h4H1, h4L0, h4L1] = request.security(syminfo.tickerid, "240", f_structure_snapshot(BIG_4H_PIVOT_LEFT, BIG_4H_PIVOT_RIGHT), lookahead = barmerge.lookahead_off)
[m15StructClose, m15H0, m15H1, m15L0, m15L1] = request.security(syminfo.tickerid, "15", f_structure_snapshot(MOVE_PIVOT_LEFT, MOVE_PIVOT_RIGHT), lookahead = barmerge.lookahead_off)

int dStructDir = f_clear_dir(dH0, dH1, dL0, dL1)
int h4StructDir = f_clear_dir(h4H0, h4H1, h4L0, h4L1)
int m15StructDir = f_clear_dir(m15H0, m15H1, m15L0, m15L1)

var int bigDirState = 0
var float bigProtectedLevel = na
var string bigAuthority = "NONE"
var string bigDirectionReason = "BUILDING STRUCTURE"

if directionMode == "AUTO"
    if bigDirState == 0
        if dStructDir != 0
            bigDirState := dStructDir
            bigProtectedLevel := dStructDir == 1 ? dL0 : dH0
            bigAuthority := "DAILY"
            bigDirectionReason := "DAILY MACRO STRUCTURE"
        else if h4StructDir != 0
            bigDirState := h4StructDir
            bigProtectedLevel := h4StructDir == 1 ? h4L0 : h4H0
            bigAuthority := "4H MAJOR"
            bigDirectionReason := "MAJOR 4H STRUCTURE / DAILY BUILDING"
        else
            bigDirectionReason := "HTF STRUCTURE BUILDING"
    else if bigDirState == -1
        if dStructDir == -1
            bigProtectedLevel := dH0
            bigAuthority := "DAILY"
            bigDirectionReason := "BEARISH DAILY MACRO INTACT"
        else if dStructDir == 0 and h4StructDir == -1 and bigAuthority != "DAILY"
            bigProtectedLevel := h4H0
            bigAuthority := "4H MAJOR"
            bigDirectionReason := "BEARISH MAJOR 4H STRUCTURE INTACT"
        else
            bool dailyBullBreak = dStructDir == 1 and not na(dStructClose) and not na(bigProtectedLevel) and dStructClose > bigProtectedLevel
            bool fallback4hBullBreak = bigAuthority != "DAILY" and dStructDir == 0 and h4StructDir == 1 and not na(h4StructClose) and not na(bigProtectedLevel) and h4StructClose > bigProtectedLevel
            if dailyBullBreak or fallback4hBullBreak
                bigDirState := 1
                bigProtectedLevel := dailyBullBreak ? dL0 : h4L0
                bigAuthority := dailyBullBreak ? "DAILY" : "4H MAJOR"
                bigDirectionReason := "BEARISH MACRO INVALIDATED + BULLISH STRUCTURE CONFIRMED"
            else
                bigDirectionReason := "BEARISH MACRO PERSISTS THROUGH BULLISH PULLBACK"
    else
        if dStructDir == 1
            bigProtectedLevel := dL0
            bigAuthority := "DAILY"
            bigDirectionReason := "BULLISH DAILY MACRO INTACT"
        else if dStructDir == 0 and h4StructDir == 1 and bigAuthority != "DAILY"
            bigProtectedLevel := h4L0
            bigAuthority := "4H MAJOR"
            bigDirectionReason := "BULLISH MAJOR 4H STRUCTURE INTACT"
        else
            bool dailyBearBreak = dStructDir == -1 and not na(dStructClose) and not na(bigProtectedLevel) and dStructClose < bigProtectedLevel
            bool fallback4hBearBreak = bigAuthority != "DAILY" and dStructDir == 0 and h4StructDir == -1 and not na(h4StructClose) and not na(bigProtectedLevel) and h4StructClose < bigProtectedLevel
            if dailyBearBreak or fallback4hBearBreak
                bigDirState := -1
                bigProtectedLevel := dailyBearBreak ? dH0 : h4H0
                bigAuthority := dailyBearBreak ? "DAILY" : "4H MAJOR"
                bigDirectionReason := "BULLISH MACRO INVALIDATED + BEARISH STRUCTURE CONFIRMED"
            else
                bigDirectionReason := "BULLISH MACRO PERSISTS THROUGH BEARISH PULLBACK"

int bigDir = directionMode == "MANUAL" ? (manualBigDirection == "UP" ? 1 : -1) : bigDirState

// 15m CURRENT MOVE is independent from macro direction.
var int currentMoveState = 0
var string currentMoveReason = "BUILDING 15M MOVE"
if currentMoveState == 0
    if m15StructDir != 0
        currentMoveState := m15StructDir
        currentMoveReason := "CONFIRMED 15M STRUCTURE"
    else if not na(m15StructClose) and not na(m15H0) and m15StructClose > m15H0
        currentMoveState := 1
        currentMoveReason := "BULLISH 15M BOS"
    else if not na(m15StructClose) and not na(m15L0) and m15StructClose < m15L0
        currentMoveState := -1
        currentMoveReason := "BEARISH 15M BOS"
else if currentMoveState == -1
    if not na(m15StructClose) and not na(m15H0) and m15StructClose > m15H0
        currentMoveState := 1
        currentMoveReason := "BULLISH 15M BOS"
    else
        currentMoveReason := "BEARISH LEG BELOW LOWER-HIGH PROTECTION"
else
    if not na(m15StructClose) and not na(m15L0) and m15StructClose < m15L0
        currentMoveState := -1
        currentMoveReason := "BEARISH 15M BOS"
    else
        currentMoveReason := "BULLISH LEG ABOVE HIGHER-LOW PROTECTION"

int currentMoveDir = currentMoveState
int autoPlanDir = currentMoveDir != 0 ? currentMoveDir : bigDir
int planDir = planMode == "MANUAL" ? (manualPlanSide == "LONG" ? 1 : -1) : autoPlanDir

// -----------------------------------------------------------------------------
// USER-APPROVED OUTER-SWING ENTRY SELECTOR (15m)
// -----------------------------------------------------------------------------
f_max_na(float a, float b) => na(a) ? b : na(b) ? a : math.max(a, b)
f_min_na(float a, float b) => na(a) ? b : na(b) ? a : math.min(a, b)

f_outer_entry_pair_local() =>
    float ph = ta.pivothigh(high, ENTRY_PIVOT_LEFT, ENTRY_PIVOT_RIGHT)
    float pl = ta.pivotlow(low, ENTRY_PIVOT_LEFT, ENTRY_PIVOT_RIGHT)
    float ph0 = ta.valuewhen(not na(ph), ph, 0)
    float ph1 = ta.valuewhen(not na(ph), ph, 1)
    float ph2 = ta.valuewhen(not na(ph), ph, 2)
    float ph3 = ta.valuewhen(not na(ph), ph, 3)
    float ph4 = ta.valuewhen(not na(ph), ph, 4)
    float ph5 = ta.valuewhen(not na(ph), ph, 5)
    float ph6 = ta.valuewhen(not na(ph), ph, 6)
    float ph7 = ta.valuewhen(not na(ph), ph, 7)
    float pl0 = ta.valuewhen(not na(pl), pl, 0)
    float pl1 = ta.valuewhen(not na(pl), pl, 1)
    float pl2 = ta.valuewhen(not na(pl), pl, 2)
    float pl3 = ta.valuewhen(not na(pl), pl, 3)
    float pl4 = ta.valuewhen(not na(pl), pl, 4)
    float pl5 = ta.valuewhen(not na(pl), pl, 5)
    float pl6 = ta.valuewhen(not na(pl), pl, 6)
    float pl7 = ta.valuewhen(not na(pl), pl, 7)
    float outerHigh = f_max_na(f_max_na(f_max_na(ph0, ph1), f_max_na(ph2, ph3)), f_max_na(f_max_na(ph4, ph5), f_max_na(ph6, ph7)))
    float outerLow = f_min_na(f_min_na(f_min_na(pl0, pl1), f_min_na(pl2, pl3)), f_min_na(f_min_na(pl4, pl5), f_min_na(pl6, pl7)))
    [outerHigh, outerLow]

[autoLongRaw, autoShortRaw] = request.security(syminfo.tickerid, "15", f_outer_entry_pair_local(), lookahead = barmerge.lookahead_off)

f_round_up_tick(float p) => na(p) ? na : math.ceil((p - 1e-10) / syminfo.mintick) * syminfo.mintick
f_round_down_tick(float p) => na(p) ? na : math.floor((p + 1e-10) / syminfo.mintick) * syminfo.mintick

float autoLongEntry = f_round_up_tick(autoLongRaw)
float autoShortEntry = f_round_down_tick(autoShortRaw)
float longEntry = entryMode == "MANUAL" and manualLongEntry > 0 ? manualLongEntry : autoLongEntry
float shortEntry = entryMode == "MANUAL" and manualShortEntry > 0 ? manualShortEntry : autoShortEntry
bool longEntrySet = not na(longEntry) and longEntry > 0
bool shortEntrySet = not na(shortEntry) and shortEntry > 0
float activeStructuralProof = planDir == 1 ? longEntry : planDir == -1 ? shortEntry : na
bool structuralProofSet = not na(activeStructuralProof) and activeStructuralProof > 0

plot(longEntry, "LONG structural proof data", display = display.none)
plot(shortEntry, "SHORT structural proof data", display = display.none)

// -----------------------------------------------------------------------------
// REACTION-ZONE DISCOVERY LANES
// Each timeframe lane finds candidate reaction intervals. Final TP numbering is
// performed only AFTER cross-timeframe canonical physical-shelf fusion below.
// -----------------------------------------------------------------------------
f_pick_long_cluster(array<float> lows, array<float> highs, float floorPrice, float requiredGap, float tolerance, int minTouches) =>
    float bestLo = na
    float bestHi = na
    float bestDist = HUGE_DISTANCE
    int bestTouches = 0
    int n = array.size(lows)
    if n > 0
        for i = 0 to n - 1
            float seedLo = array.get(lows, i)
            int touches = 0
            float clusterLo = na
            float clusterHi = na
            for j = 0 to n - 1
                float lo = array.get(lows, j)
                float hi = array.get(highs, j)
                bool sameShelf = not na(lo) and not na(hi) and hi > lo and math.abs(lo - seedLo) <= tolerance
                if sameShelf
                    touches += 1
                    clusterLo := na(clusterLo) ? lo : math.min(clusterLo, lo)
                    clusterHi := na(clusterHi) ? hi : math.max(clusterHi, hi)
            bool separated = touches >= minTouches and not na(clusterLo) and clusterLo >= floorPrice + requiredGap
            if separated
                float dist = clusterLo - floorPrice
                if dist < bestDist or (math.abs(dist - bestDist) <= syminfo.mintick and touches > bestTouches)
                    bestDist := dist
                    bestLo := clusterLo
                    bestHi := clusterHi
                    bestTouches := touches
    [bestLo, bestHi, bestTouches]

f_pick_short_cluster(array<float> lows, array<float> highs, float ceilingPrice, float requiredGap, float tolerance, int minTouches) =>
    float bestLo = na
    float bestHi = na
    float bestDist = HUGE_DISTANCE
    int bestTouches = 0
    int n = array.size(lows)
    if n > 0
        for i = 0 to n - 1
            float seedHi = array.get(highs, i)
            int touches = 0
            float clusterLo = na
            float clusterHi = na
            for j = 0 to n - 1
                float lo = array.get(lows, j)
                float hi = array.get(highs, j)
                bool sameShelf = not na(lo) and not na(hi) and hi > lo and math.abs(hi - seedHi) <= tolerance
                if sameShelf
                    touches += 1
                    clusterLo := na(clusterLo) ? lo : math.min(clusterLo, lo)
                    clusterHi := na(clusterHi) ? hi : math.max(clusterHi, hi)
            bool separated = touches >= minTouches and not na(clusterHi) and clusterHi <= ceilingPrice - requiredGap
            if separated
                float dist = ceilingPrice - clusterHi
                if dist < bestDist or (math.abs(dist - bestDist) <= syminfo.mintick and touches > bestTouches)
                    bestDist := dist
                    bestLo := clusterLo
                    bestHi := clusterHi
                    bestTouches := touches
    [bestLo, bestHi, bestTouches]

f_tp_zone_ladder_local(int lookbackBars, int maxPerSide, int minTouches, float toleranceAtr, float entrySepAtr, float zoneSepAtr, bool includeBodyTurns) =>
    [outerHigh, outerLow] = f_outer_entry_pair_local()
    float atrLocal = ta.atr(14)
    float tolerance = math.max(syminfo.mintick * 4.0, nz(atrLocal, syminfo.mintick * 20.0) * toleranceAtr)
    float entryGap = math.max(syminfo.mintick * 4.0, nz(atrLocal, syminfo.mintick * 20.0) * entrySepAtr)
    float zoneGap = math.max(syminfo.mintick * 4.0, nz(atrLocal, syminfo.mintick * 20.0) * zoneSepAtr)
    array<float> longLos = array.new_float()
    array<float> longHis = array.new_float()
    array<float> shortLos = array.new_float()
    array<float> shortHis = array.new_float()

    for i = 3 to lookbackBars
        bool localLow = low[i] <= low[i - 1] and low[i] < low[i + 1]
        bool localHigh = high[i] >= high[i - 1] and high[i] > high[i + 1]
        bool bodyTurn = includeBodyTurns and not localLow and not localHigh and ((close[i] > open[i] and close[i - 1] < open[i - 1]) or (close[i] < open[i] and close[i - 1] > open[i - 1]))
        float zLo = na
        float zHi = na
        if localLow
            zLo := low[i]
            zHi := math.min(open[i], close[i])
        else if localHigh
            zLo := math.max(open[i], close[i])
            zHi := high[i]
        else if bodyTurn
            zLo := math.min(open[i], close[i])
            zHi := math.max(open[i], close[i])

        if not na(zLo) and not na(zHi) and zHi > zLo
            if not na(outerHigh) and zLo >= outerHigh + entryGap and array.size(longLos) < maxPerSide
                array.push(longLos, zLo)
                array.push(longHis, zHi)
            if not na(outerLow) and zHi <= outerLow - entryGap and array.size(shortLos) < maxPerSide
                array.push(shortLos, zLo)
                array.push(shortHis, zHi)

    [l1Lo, l1Hi, l1N] = f_pick_long_cluster(longLos, longHis, outerHigh, entryGap, tolerance, minTouches)
    [l2Lo, l2Hi, l2N] = f_pick_long_cluster(longLos, longHis, na(l1Hi) ? outerHigh : l1Hi, zoneGap, tolerance, minTouches)
    [l3Lo, l3Hi, l3N] = f_pick_long_cluster(longLos, longHis, na(l2Hi) ? (na(l1Hi) ? outerHigh : l1Hi) : l2Hi, zoneGap, tolerance, minTouches)
    [s1Lo, s1Hi, s1N] = f_pick_short_cluster(shortLos, shortHis, outerLow, entryGap, tolerance, minTouches)
    [s2Lo, s2Hi, s2N] = f_pick_short_cluster(shortLos, shortHis, na(s1Lo) ? outerLow : s1Lo, zoneGap, tolerance, minTouches)
    [s3Lo, s3Hi, s3N] = f_pick_short_cluster(shortLos, shortHis, na(s2Lo) ? (na(s1Lo) ? outerLow : s1Lo) : s2Lo, zoneGap, tolerance, minTouches)

    float long1 = l1N >= minTouches ? l1Lo + (l1Hi - l1Lo) * tpPenetrationFraction : na
    float long2 = l2N >= minTouches ? l2Lo + (l2Hi - l2Lo) * tpPenetrationFraction : na
    float long3 = l3N >= minTouches ? l3Lo + (l3Hi - l3Lo) * tpPenetrationFraction : na
    float short1 = s1N >= minTouches ? s1Hi - (s1Hi - s1Lo) * tpPenetrationFraction : na
    float short2 = s2N >= minTouches ? s2Hi - (s2Hi - s2Lo) * tpPenetrationFraction : na
    float short3 = s3N >= minTouches ? s3Hi - (s3Hi - s3Lo) * tpPenetrationFraction : na

    [l1Lo, l1Hi, long1, l2Lo, l2Hi, long2, l3Lo, l3Hi, long3, s1Lo, s1Hi, short1, s2Lo, s2Hi, short2, s3Lo, s3Hi, short3]

// Each lane returns zone LOW/HIGH plus a lane-local target used only as a validity witness.
// The final displayed target is recomputed from the canonical fused shelf below.
[l15_1lo, l15_1hi, l15_1, l15_2lo, l15_2hi, l15_2, l15_3lo, l15_3hi, l15_3, s15_1lo, s15_1hi, s15_1, s15_2lo, s15_2hi, s15_2, s15_3lo, s15_3hi, s15_3] = request.security(syminfo.tickerid, "15", f_tp_zone_ladder_local(320, 80, tpMinTouches15, tpClusterToleranceAtr, tpEntrySeparationAtr, tpZoneSeparationAtr, false), lookahead = barmerge.lookahead_off)
[l5_1lo, l5_1hi, l5_1, l5_2lo, l5_2hi, l5_2, l5_3lo, l5_3hi, l5_3, s5_1lo, s5_1hi, s5_1, s5_2lo, s5_2hi, s5_2, s5_3lo, s5_3hi, s5_3] = request.security(syminfo.tickerid, "5", f_tp_zone_ladder_local(600, 100, tpMinTouches5, 0.18, 0.25, 0.12, true), lookahead = barmerge.lookahead_off)
[l60_1lo, l60_1hi, l60_1, l60_2lo, l60_2hi, l60_2, l60_3lo, l60_3hi, l60_3, s60_1lo, s60_1hi, s60_1, s60_2lo, s60_2hi, s60_2, s60_3lo, s60_3hi, s60_3] = request.security(syminfo.tickerid, "60", f_tp_zone_ladder_local(180, 60, 1, 0.35, 0.20, 0.10, false), lookahead = barmerge.lookahead_off)
[l240_1lo, l240_1hi, l240_1, l240_2lo, l240_2hi, l240_2, l240_3lo, l240_3hi, l240_3, s240_1lo, s240_1hi, s240_1, s240_2lo, s240_2hi, s240_2, s240_3lo, s240_3hi, s240_3] = request.security(syminfo.tickerid, "240", f_tp_zone_ladder_local(120, 48, 1, 0.40, 0.15, 0.10, false), lookahead = barmerge.lookahead_off)

float atr15ForTp = request.security(syminfo.tickerid, "15", ta.atr(14), lookahead = barmerge.lookahead_off)
float mergedEntryGap = math.max(syminfo.mintick * 4.0, nz(atr15ForTp, syminfo.mintick * 20.0) * tpEntrySeparationAtr)
float mergedZoneGap = math.max(syminfo.mintick * 4.0, nz(atr15ForTp, syminfo.mintick * 20.0) * tpZoneSeparationAtr)
float crossTfFusionGap = math.max(syminfo.mintick * 4.0, nz(atr15ForTp, syminfo.mintick * 20.0) * tpCanonicalFusionAtr)
float canonicalShelfGap = math.max(mergedZoneGap, crossTfFusionGap)

f_add_zone_candidate(array<float> lows, array<float> highs, float lo, float hi, float validityTarget) =>
    if not na(lo) and not na(hi) and not na(validityTarget) and hi > lo and validityTarget >= lo and validityTarget <= hi
        array.push(lows, lo)
        array.push(highs, hi)

// Expand a seed to the full connected physical shelf. Repeated passes make the
// merge transitive: A can join C through B even when A and C are not directly close.
f_expand_canonical_zone(array<float> lows, array<float> highs, int seedIndex, float fusionGap) =>
    float zoneLo = array.get(lows, seedIndex)
    float zoneHi = array.get(highs, seedIndex)
    int n = array.size(lows)
    if n > 0
        for pass = 0 to n - 1
            float beforeLo = zoneLo
            float beforeHi = zoneHi
            for j = 0 to n - 1
                float lo = array.get(lows, j)
                float hi = array.get(highs, j)
                bool connects = not na(lo) and not na(hi) and hi > lo and lo <= zoneHi + fusionGap and hi >= zoneLo - fusionGap
                if connects
                    zoneLo := math.min(zoneLo, lo)
                    zoneHi := math.max(zoneHi, hi)
            if zoneLo == beforeLo and zoneHi == beforeHi
                break
    [zoneLo, zoneHi]

// Auto targets are never allowed to round back onto a canonical shelf edge.
// If the shelf cannot contain at least one valid interior tick, it fails closed.
f_safe_long_target_from_zone(float lo, float hi, float penetration) =>
    float minInside = lo + syminfo.mintick
    float maxInside = hi - syminfo.mintick
    float raw = lo + (hi - lo) * penetration
    float rounded = f_round_down_tick(raw)
    minInside <= maxInside ? math.min(math.max(rounded, minInside), maxInside) : na

f_safe_short_target_from_zone(float lo, float hi, float penetration) =>
    float minInside = lo + syminfo.mintick
    float maxInside = hi - syminfo.mintick
    float raw = hi - (hi - lo) * penetration
    float rounded = f_round_up_tick(raw)
    minInside <= maxInside ? math.min(math.max(rounded, minInside), maxInside) : na

f_next_long_canonical_zone(array<float> lows, array<float> highs, float boundaryHi, float requiredGap, float fusionGap, float penetration) =>
    float bestTarget = na
    float bestLo = na
    float bestHi = na
    float bestDist = HUGE_DISTANCE
    int n = array.size(lows)
    if n > 0 and not na(boundaryHi)
        for i = 0 to n - 1
            [lo, hi] = f_expand_canonical_zone(lows, highs, i, fusionGap)
            float target = f_safe_long_target_from_zone(lo, hi, penetration)
            bool distinct = not na(target) and lo >= boundaryHi + requiredGap
            if distinct
                float dist = lo - boundaryHi
                if dist < bestDist
                    bestDist := dist
                    bestTarget := target
                    bestLo := lo
                    bestHi := hi
    [bestTarget, bestLo, bestHi]

f_next_short_canonical_zone(array<float> lows, array<float> highs, float boundaryLo, float requiredGap, float fusionGap, float penetration) =>
    float bestTarget = na
    float bestLo = na
    float bestHi = na
    float bestDist = HUGE_DISTANCE
    int n = array.size(lows)
    if n > 0 and not na(boundaryLo)
        for i = 0 to n - 1
            [lo, hi] = f_expand_canonical_zone(lows, highs, i, fusionGap)
            float target = f_safe_short_target_from_zone(lo, hi, penetration)
            bool distinct = not na(target) and hi <= boundaryLo - requiredGap
            if distinct
                float dist = boundaryLo - hi
                if dist < bestDist
                    bestDist := dist
                    bestTarget := target
                    bestLo := lo
                    bestHi := hi
    [bestTarget, bestLo, bestHi]

array<float> longCandLo = array.new_float()
array<float> longCandHi = array.new_float()
array<float> shortCandLo = array.new_float()
array<float> shortCandHi = array.new_float()

f_add_zone_candidate(longCandLo, longCandHi, l15_1lo, l15_1hi, l15_1)
f_add_zone_candidate(longCandLo, longCandHi, l15_2lo, l15_2hi, l15_2)
f_add_zone_candidate(longCandLo, longCandHi, l15_3lo, l15_3hi, l15_3)
f_add_zone_candidate(longCandLo, longCandHi, l5_1lo, l5_1hi, l5_1)
f_add_zone_candidate(longCandLo, longCandHi, l5_2lo, l5_2hi, l5_2)
f_add_zone_candidate(longCandLo, longCandHi, l5_3lo, l5_3hi, l5_3)
f_add_zone_candidate(longCandLo, longCandHi, l60_1lo, l60_1hi, l60_1)
f_add_zone_candidate(longCandLo, longCandHi, l60_2lo, l60_2hi, l60_2)
f_add_zone_candidate(longCandLo, longCandHi, l60_3lo, l60_3hi, l60_3)
f_add_zone_candidate(longCandLo, longCandHi, l240_1lo, l240_1hi, l240_1)
f_add_zone_candidate(longCandLo, longCandHi, l240_2lo, l240_2hi, l240_2)
f_add_zone_candidate(longCandLo, longCandHi, l240_3lo, l240_3hi, l240_3)

f_add_zone_candidate(shortCandLo, shortCandHi, s15_1lo, s15_1hi, s15_1)
f_add_zone_candidate(shortCandLo, shortCandHi, s15_2lo, s15_2hi, s15_2)
f_add_zone_candidate(shortCandLo, shortCandHi, s15_3lo, s15_3hi, s15_3)
f_add_zone_candidate(shortCandLo, shortCandHi, s5_1lo, s5_1hi, s5_1)
f_add_zone_candidate(shortCandLo, shortCandHi, s5_2lo, s5_2hi, s5_2)
f_add_zone_candidate(shortCandLo, shortCandHi, s5_3lo, s5_3hi, s5_3)
f_add_zone_candidate(shortCandLo, shortCandHi, s60_1lo, s60_1hi, s60_1)
f_add_zone_candidate(shortCandLo, shortCandHi, s60_2lo, s60_2hi, s60_2)
f_add_zone_candidate(shortCandLo, shortCandHi, s60_3lo, s60_3hi, s60_3)
f_add_zone_candidate(shortCandLo, shortCandHi, s240_1lo, s240_1hi, s240_1)
f_add_zone_candidate(shortCandLo, shortCandHi, s240_2lo, s240_2hi, s240_2)
f_add_zone_candidate(shortCandLo, shortCandHi, s240_3lo, s240_3hi, s240_3)

// Canonical shelf selection: each seed expands to its full physical shelf first.
// Therefore another timeframe view of the same shelf cannot become TP2/TP3.
[longTp1Raw, longTp1Lo, longTp1Hi] = f_next_long_canonical_zone(longCandLo, longCandHi, longEntry, mergedEntryGap, canonicalShelfGap, tpPenetrationFraction)
[longTp2Raw, longTp2Lo, longTp2Hi] = f_next_long_canonical_zone(longCandLo, longCandHi, longTp1Hi, canonicalShelfGap, canonicalShelfGap, tpPenetrationFraction)
[longTp3Raw, longTp3Lo, longTp3Hi] = f_next_long_canonical_zone(longCandLo, longCandHi, longTp2Hi, canonicalShelfGap, canonicalShelfGap, tpPenetrationFraction)
[shortTp1Raw, shortTp1Lo, shortTp1Hi] = f_next_short_canonical_zone(shortCandLo, shortCandHi, shortEntry, mergedEntryGap, canonicalShelfGap, tpPenetrationFraction)
[shortTp2Raw, shortTp2Lo, shortTp2Hi] = f_next_short_canonical_zone(shortCandLo, shortCandHi, shortTp1Lo, canonicalShelfGap, canonicalShelfGap, tpPenetrationFraction)
[shortTp3Raw, shortTp3Lo, shortTp3Hi] = f_next_short_canonical_zone(shortCandLo, shortCandHi, shortTp2Lo, canonicalShelfGap, canonicalShelfGap, tpPenetrationFraction)

// f_safe_* already returns tick-grid-safe prices strictly inside canonical bounds.
float longTp1Price = longTp1Raw
float longTp2Price = longTp2Raw
float longTp3Price = longTp3Raw
float shortTp1Price = shortTp1Raw
float shortTp2Price = shortTp2Raw
float shortTp3Price = shortTp3Raw

bool longTp1Set = not na(longTp1Price)
bool longTp2Set = not na(longTp2Price)
bool longTp3Set = not na(longTp3Price)
bool shortTp1Set = not na(shortTp1Price)
bool shortTp2Set = not na(shortTp2Price)
bool shortTp3Set = not na(shortTp3Price)

bool manualTargetSet = manualTargetLow > 0 and manualTargetHigh > manualTargetLow
float manualTargetPrice = not manualTargetSet ? na : planDir == 1 ? f_round_down_tick(manualTargetLow) : f_round_up_tick(manualTargetHigh)
float activeTp1Price = targetMode == "MANUAL" ? manualTargetPrice : planDir == 1 ? longTp1Price : planDir == -1 ? shortTp1Price : na
float activeTp2Price = targetMode == "AUTO" ? (planDir == 1 ? longTp2Price : planDir == -1 ? shortTp2Price : na) : na
float activeTp3Price = targetMode == "AUTO" ? (planDir == 1 ? longTp3Price : planDir == -1 ? shortTp3Price : na) : na
bool activeTp1Set = not na(activeTp1Price) and activeTp1Price > 0
int activeCandidateCount = planDir == 1 ? array.size(longCandLo) : array.size(shortCandLo)
string tpDetectorReason = activeTp1Set ? "TP SET" : not structuralProofSet ? "ENTRY STRUCTURE UNAVAILABLE" : activeCandidateCount == 0 ? "TP DATA/DETECTOR UNAVAILABLE" : "NO QUALIFIED CANONICAL TP SHELF"

plot(longTp1Price, "LONG TP1 canonical shelf data", display = display.none)
plot(shortTp1Price, "SHORT TP1 canonical shelf data", display = display.none)
plot(longTp1Lo, "LONG TP1 canonical low", display = display.none)
plot(longTp1Hi, "LONG TP1 canonical high", display = display.none)
plot(shortTp1Lo, "SHORT TP1 canonical low", display = display.none)
plot(shortTp1Hi, "SHORT TP1 canonical high", display = display.none)

// -----------------------------------------------------------------------------
// CANDLE QUALITY — calculations run silently; panel is context-gated below.
// -----------------------------------------------------------------------------
float atr5 = ta.atr(14)
f_body_fraction(int i) =>
    float r = high[i] - low[i]
    r > 0 ? math.abs(close[i] - open[i]) / r : 0.0
f_upper_wick_fraction(int i) =>
    float r = high[i] - low[i]
    r > 0 ? (high[i] - math.max(open[i], close[i])) / r : 0.0
f_lower_wick_fraction(int i) =>
    float r = high[i] - low[i]
    r > 0 ? (math.min(open[i], close[i]) - low[i]) / r : 0.0
f_close_location(int i) =>
    float r = high[i] - low[i]
    r > 0 ? (close[i] - low[i]) / r : 0.5

bool enoughCandleHistory = bar_index >= 3
bool dojiTwoBack = enoughCandleHistory and f_body_fraction(2) <= candleDojiBodyMax
bool rejectionPrevious = enoughCandleHistory and math.max(f_upper_wick_fraction(1), f_lower_wick_fraction(1)) >= candleRejectWickMin
bool bullishEngulf = enoughCandleHistory and close > open and close >= math.max(open[1], close[1]) and open <= math.min(open[1], close[1])
bool bearishEngulf = enoughCandleHistory and close < open and open >= math.max(open[1], close[1]) and close <= math.min(open[1], close[1])
bool strongBody = f_body_fraction(0) >= candleStrongBodyMin
bool strongRange = (high - low) >= nz(atr5, syminfo.mintick * 20.0) * candleStrongRangeAtr
bool longCloseQuality = f_close_location(0) >= candleCloseQualityMin and f_upper_wick_fraction(0) <= candleOppWickMax
bool shortCloseQuality = (1.0 - f_close_location(0)) >= candleCloseQualityMin and f_lower_wick_fraction(0) <= candleOppWickMax
bool strongEngulfForPlan = planDir == 1 ? (bullishEngulf and strongBody and strongRange and longCloseQuality) : planDir == -1 ? (bearishEngulf and strongBody and strongRange and shortCloseQuality) : false
bool sequenceBreak = planDir == 1 ? close > math.max(high[1], high[2]) : planDir == -1 ? close < math.min(low[1], low[2]) : false
bool rejectionEngulfSequence = dojiTwoBack and rejectionPrevious and strongEngulfForPlan and sequenceBreak
bool candleProofCross = planDir == 1 ? (longEntrySet and close > longEntry) : planDir == -1 ? (shortEntrySet and close < shortEntry) : false
float roomToTp = activeTp1Set and structuralProofSet ? math.abs(activeStructuralProof - activeTp1Price) : na
bool candleRoomOk = not na(roomToTp) and roomToTp >= nz(atr5, syminfo.mintick * 20.0) * candleMinRoomAtr
bool momentumEntryCandidateLive = entryEngineSupported and strongEngulfForPlan and candleProofCross and candleRoomOk
bool qualifiedMomentumEntry = momentumEntryCandidateLive and barstate.isconfirmed

// -----------------------------------------------------------------------------
// STANDARD 5M ENTRY STATE MACHINE
// -----------------------------------------------------------------------------
float minBreakDistance = math.max(syminfo.mintick * momentumMinBreakTicks, syminfo.mintick)
float minPushDistance = math.max(syminfo.mintick * 2.0, nz(atr5, syminfo.mintick * 20.0) * momentumPushAtr)
float maxRecoilDistance = math.max(syminfo.mintick * 2.0, nz(atr5, syminfo.mintick * 20.0) * momentumRecoilAtr)

var string entryStage = "WAIT_PROOF"
var int armedSide = 0
var float armedStructuralProof = na
var float referencePrice = na
var int referenceBar = na
var float momentumAnchor = na
var string lastEntryEvent = "WAITING"

if not entryEngineSupported
    entryStage := "WAIT_PROOF"
    armedSide := 0
    armedStructuralProof := na
    referencePrice := na
    referenceBar := na
    momentumAnchor := na
else
    bool proofChanged = armedSide != 0 and structuralProofSet and not na(armedStructuralProof) and math.abs(activeStructuralProof - armedStructuralProof) >= syminfo.mintick
    bool contextChanged = armedSide != 0 and (planDir != armedSide or proofChanged or not structuralProofSet)
    if contextChanged
        entryStage := "WAIT_PROOF"
        armedSide := 0
        armedStructuralProof := na
        referencePrice := na
        referenceBar := na
        momentumAnchor := na
        lastEntryEvent := "CONTEXT RESET"

    float proofRange = high - low
    float proofBodyFraction = proofRange > 0 ? math.abs(close - open) / proofRange : 0.0
    bool proofCandleQuality = proofBodyFraction >= referenceMinBodyFraction
    bool proofCloseLong = planDir == 1 and longEntrySet and barstate.isconfirmed and close > longEntry
    bool proofCloseShort = planDir == -1 and shortEntrySet and barstate.isconfirmed and close < shortEntry

    if entryStage == "WAIT_PROOF"
        if proofCloseLong or proofCloseShort
            if proofCandleQuality
                armedSide := planDir
                armedStructuralProof := activeStructuralProof
                referencePrice := planDir == 1 ? high : low
                referenceBar := bar_index
                momentumAnchor := referencePrice
                entryStage := "WAIT_BREAK"
                lastEntryEvent := "REFERENCE ARMED"
            else
                lastEntryEvent := "DOJI PROOF REJECTED"
    else if entryStage == "WAIT_BREAK"
        bool breakLong = armedSide == 1 and bar_index > referenceBar and high >= referencePrice + minBreakDistance
        bool breakShort = armedSide == -1 and bar_index > referenceBar and low <= referencePrice - minBreakDistance
        if breakLong or breakShort
            momentumAnchor := armedSide == 1 ? high : low
            entryStage := "BREAK"
            lastEntryEvent := "BREAK"
        else if barstate.isconfirmed and bar_index > referenceBar
            referencePrice := armedSide == 1 ? high : low
            referenceBar := bar_index
            momentumAnchor := referencePrice
            lastEntryEvent := "REFERENCE ROLLED"
    else if entryStage == "BREAK"
        bool hardRecoil = armedSide == 1 ? close <= momentumAnchor - maxRecoilDistance : close >= momentumAnchor + maxRecoilDistance
        bool push1 = armedSide == 1 ? high >= momentumAnchor + minPushDistance : low <= momentumAnchor - minPushDistance
        if hardRecoil
            entryStage := "WAIT_BREAK"
            momentumAnchor := referencePrice
            lastEntryEvent := "RECOIL RESET"
        else if push1
            momentumAnchor := armedSide == 1 ? high : low
            entryStage := "PUSH_1"
            lastEntryEvent := "PUSH 1"
    else if entryStage == "PUSH_1"
        bool hardRecoil2 = armedSide == 1 ? close <= momentumAnchor - maxRecoilDistance : close >= momentumAnchor + maxRecoilDistance
        bool push2 = armedSide == 1 ? high >= momentumAnchor + minPushDistance : low <= momentumAnchor - minPushDistance
        if hardRecoil2
            entryStage := "WAIT_BREAK"
            momentumAnchor := referencePrice
            lastEntryEvent := "RECOIL RESET"
        else if push2
            momentumAnchor := armedSide == 1 ? high : low
            entryStage := "ENTRY_READY"
            lastEntryEvent := "ENTRY READY"

float displayedLongEntry = armedSide == 1 and entryStage != "WAIT_PROOF" and not na(referencePrice) ? referencePrice : longEntry
float displayedShortEntry = armedSide == -1 and entryStage != "WAIT_PROOF" and not na(referencePrice) ? referencePrice : shortEntry
bool standardEntryReady = entryStage == "ENTRY_READY"
bool anyEntryReady = standardEntryReady or qualifiedMomentumEntry

// Entry-confirmation UI gating. A random rejection candle away from the active
// Entry Zone is not surfaced as a setup. The box begins talking about candles
// only when price is engaging the active proof line or the entry sequence is armed.
bool proofInteractingLive = entryEngineSupported and structuralProofSet and (planDir == 1 ? high >= activeStructuralProof : low <= activeStructuralProof)
bool entryConfirmationActive = entryStage != "WAIT_PROOF" or proofInteractingLive or qualifiedMomentumEntry
string planWord = planDir == 1 ? "LONG" : planDir == -1 ? "SHORT" : "ENTRY"
string engulfWord = planDir == 1 ? "⚡ BULLISH ENGULF CONFIRMED" : "⚡ BEARISH ENGULF CONFIRMED"
string engulfBuildingWord = planDir == 1 ? "⚡ BULLISH ENGULF BUILDING" : "⚡ BEARISH ENGULF BUILDING"
string entryConfirmationText = not entryEngineSupported ? "USE 5M FOR ENTRY" : not entryConfirmationActive ? "NOT ACTIVE YET" : qualifiedMomentumEntry ? "✅ MOMENTUM CONFIRMED" : rejectionEngulfSequence and barstate.isconfirmed ? "✅ REJECTION → ENGULF CONFIRMED" : strongEngulfForPlan and barstate.isconfirmed ? engulfWord : strongEngulfForPlan ? engulfBuildingWord : entryStage == "WAIT_PROOF" ? "👀 WATCHING CANDLES" : entryStage == "WAIT_BREAK" ? "✅ ENTRY BREAK CONFIRMED" : entryStage == "BREAK" or entryStage == "PUSH_1" ? "⏳ CHECKING MOMENTUM" : entryStage == "ENTRY_READY" ? "✅ PASSED" : "👀 WATCHING CANDLES"

// -----------------------------------------------------------------------------
// DRAWINGS
// -----------------------------------------------------------------------------
var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pwhLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pwlLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longEntryLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortEntryLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longTp1Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longTp2Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longTp3Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortTp1Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortTp2Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortTp3Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line manualTpLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)

var label pdhLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pdlLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pwhLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pwlLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longEntryLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortEntryLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longTp1Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longTp2Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longTp3Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortTp1Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortTp2Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortTp3Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label manualTpLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)

int chartBarMs = not na(time_close) and time_close > time ? time_close - time : FALLBACK_BAR_MS
int levelLabelX = (not na(time_close) ? time_close : time) + chartBarMs * LEVEL_LABEL_OFFSET_BARS

f_sync_level(line id, label lid, float price, string name, color c, bool visible, int labelX, int width, color txtColor) =>
    if visible and not na(price) and price > 0
        line.set_xy1(id, time, price)
        line.set_xy2(id, time_close, price)
        line.set_extend(id, extend.both)
        line.set_color(id, c)
        line.set_width(id, width)
        label.set_xy(lid, labelX, price)
        label.set_text(lid, name)
        label.set_color(lid, c)
        label.set_textcolor(lid, txtColor)
        label.set_size(lid, size.normal)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

array<string> wallNames = array.new_string()
array<float> wallPrices = array.new_float()
f_add_wall(bool condition, string name, float price) =>
    if condition and not na(price)
        array.push(wallNames, name)
        array.push(wallPrices, price)

if planDir == 1
    f_add_wall(showPdh and pdh > close, "PDH", pdh)
    f_add_wall(showPwh and pwh > close, "PWH", pwh)
else if planDir == -1
    f_add_wall(showPdl and pdl < close, "PDL", pdl)
    f_add_wall(showPwl and pwl < close, "PWL", pwl)

string nextWallName = "NONE AHEAD"
float nextWallPrice = na
float nextWallDistance = HUGE_DISTANCE
if array.size(wallPrices) > 0
    for i = 0 to array.size(wallPrices) - 1
        float p = array.get(wallPrices, i)
        float dist = math.abs(p - close)
        if dist < nextWallDistance
            nextWallDistance := dist
            nextWallName := array.get(wallNames, i)
            nextWallPrice := p
string nextWallText = na(nextWallPrice) ? nextWallName : nextWallName + " @ " + str.tostring(nextWallPrice, format.mintick)

if barstate.islast
    f_sync_level(pdhLine, pdhLabel, pdh, "PDH", BLUE_DAY, showPdh, levelLabelX, 2, color.white)
    f_sync_level(pdlLine, pdlLabel, pdl, "PDL", BLUE_DAY, showPdl, levelLabelX, 2, color.white)
    f_sync_level(pwhLine, pwhLabel, pwh, "PWH", BLUE_WEEK, showPwh, levelLabelX, 2, color.white)
    f_sync_level(pwlLine, pwlLabel, pwl, "PWL", BLUE_WEEK, showPwl, levelLabelX, 2, color.white)
    bool showEntryGeometry = showEntryLines and planningViewSupported
    f_sync_level(longEntryLine, longEntryLabel, displayedLongEntry, "🟢 LONG - ENTRY ZONE", YELLOW_GO, showEntryGeometry and longEntrySet, levelLabelX, 3, color.black)
    f_sync_level(shortEntryLine, shortEntryLabel, displayedShortEntry, "🔴 SHORT - ENTRY ZONE", YELLOW_GO, showEntryGeometry and shortEntrySet, levelLabelX, 3, color.black)
    bool tpView = showTakeProfitZones and planningViewSupported
    bool drawLongTp = tpView and (showBothTpSides or planDir == 1) and targetMode == "AUTO"
    bool drawShortTp = tpView and (showBothTpSides or planDir == -1) and targetMode == "AUTO"
    f_sync_level(longTp1Line, longTp1Label, longTp1Price, "🎯 TAKE PROFIT ZONE 1", BLUE_TARGET, drawLongTp and longTp1Set, levelLabelX, 2, color.white)
    f_sync_level(longTp2Line, longTp2Label, longTp2Price, "🎯 TAKE PROFIT ZONE 2", BLUE_TARGET, drawLongTp and longTp2Set, levelLabelX, 2, color.white)
    f_sync_level(longTp3Line, longTp3Label, longTp3Price, "🎯 TAKE PROFIT ZONE 3", BLUE_TARGET, drawLongTp and longTp3Set, levelLabelX, 2, color.white)
    f_sync_level(shortTp1Line, shortTp1Label, shortTp1Price, "🎯 TAKE PROFIT ZONE 1", BLUE_TARGET, drawShortTp and shortTp1Set, levelLabelX, 2, color.white)
    f_sync_level(shortTp2Line, shortTp2Label, shortTp2Price, "🎯 TAKE PROFIT ZONE 2", BLUE_TARGET, drawShortTp and shortTp2Set, levelLabelX, 2, color.white)
    f_sync_level(shortTp3Line, shortTp3Label, shortTp3Price, "🎯 TAKE PROFIT ZONE 3", BLUE_TARGET, drawShortTp and shortTp3Set, levelLabelX, 2, color.white)
    bool drawManual = tpView and targetMode == "MANUAL" and manualTargetSet
    f_sync_level(manualTpLine, manualTpLabel, manualTargetPrice, "🎯 TAKE PROFIT ZONE", BLUE_TARGET, drawManual, levelLabelX, 2, color.white)

// -----------------------------------------------------------------------------
// 🤖 SLUMDAWG TRADERS PANEL — presentation only
// -----------------------------------------------------------------------------
string bigDirectionText = bigDir == 1 ? "📈 UP" : bigDir == -1 ? "📉 DOWN" : "BUILDING / UNCLEAR"
string currentMoveText = currentMoveDir == 0 ? "BUILDING 15M MOVE" : bigDir == 0 ? (currentMoveDir == 1 ? "📈 UP MOVE" : "📉 DOWN MOVE") : currentMoveDir == bigDir ? (currentMoveDir == 1 ? "📈 UP WITH DIRECTION" : "📉 DOWN WITH DIRECTION") : (currentMoveDir == 1 ? "📈 UP PULLBACK" : "📉 DOWN PULLBACK")
string activePlanText = planDir == 1 ? "🟢 LONG" : planDir == -1 ? "🔴 SHORT" : "WAIT / BUILDING"
color bigDirectionColor = bigDir == 1 ? GREEN_UP : bigDir == -1 ? RED_DOWN : color.gray
color currentMoveColor = currentMoveDir == 1 ? GREEN_UP : currentMoveDir == -1 ? RED_DOWN : color.gray
color planColor = planDir == 1 ? GREEN_UP : planDir == -1 ? RED_DOWN : color.gray
string tp1Text = activeTp1Set ? str.tostring(activeTp1Price, format.mintick) : tpDetectorReason
string tp2Text = not na(activeTp2Price) ? str.tostring(activeTp2Price, format.mintick) : activeTp1Set ? "NO DISTINCT TP2" : "—"
string tp3Text = not na(activeTp3Price) ? str.tostring(activeTp3Price, format.mintick) : activeTp1Set ? "NO DISTINCT TP3" : "—"
string nowText = not entryEngineSupported ? "USE 5M FOR ENTRY" : qualifiedMomentumEntry ? "✅ MOMENTUM ENTRY READY" : entryStage == "ENTRY_READY" ? "✅ " + planWord + " ENTRY READY" : entryStage == "WAIT_PROOF" ? "⏳ WAIT FOR PRICE TO BREAK " + planWord + " ENTRY" : entryStage == "WAIT_BREAK" ? "⏳ WAIT FOR NEXT CANDLE BREAK" : entryStage == "BREAK" ? "⚡ BREAK CONFIRMED — CHECK MOMENTUM" : entryStage == "PUSH_1" ? "⚡ MOMENTUM BUILDING" : "⏳ WAIT"
string runtimeReason = not isNqMnq ? "USE NQ OR MNQ" : not tickGridExpected ? "CHECK CONTRACT TICK" : extendedClosedGap ? "EXTENDED CLOSE - VERIFY LEVELS" : "MACRO " + bigAuthority + " + CANONICAL TP"

var table coach = na
if barstate.isfirst
    if showCoach
        coach := table.new(position.top_right, 2, 13, border_width = 2, frame_width = 2, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)
        table.merge_cells(coach, 0, 0, 1, 0)
    else
        coach := table.new(position.top_right, 1, 1, border_width = 1, frame_width = 1, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)

if barstate.islast
    if showCoach
        table.cell(coach, 0, 0, "🤖 SLUMDAWG TRADERS", text_color = color.lime, bgcolor = PANEL_MID, text_size = 16)
        table.cell(coach, 0, 1, "BIG DIRECTION", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 1, bigDirectionText, text_color = color.white, bgcolor = bigDirectionColor, text_size = 14)
        table.cell(coach, 0, 2, "CURRENT MOVE", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 2, currentMoveText, text_color = color.white, bgcolor = currentMoveColor, text_size = 13)
        table.cell(coach, 0, 3, "ACTIVE PLAN", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 3, activePlanText, text_color = color.white, bgcolor = planColor, text_size = 13)
        table.cell(coach, 0, 4, "NEXT WALL", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 4, nextWallText, text_color = color.orange, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 0, 5, "🟢 LONG ENTRY", text_color = color.black, bgcolor = YELLOW_GO, text_size = 13)
        table.cell(coach, 1, 5, longEntrySet ? str.tostring(displayedLongEntry, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 14)
        table.cell(coach, 0, 6, "🔴 SHORT ENTRY", text_color = color.black, bgcolor = YELLOW_GO, text_size = 13)
        table.cell(coach, 1, 6, shortEntrySet ? str.tostring(displayedShortEntry, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 14)
        table.cell(coach, 0, 7, "🎯 TP1", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 1, 7, tp1Text, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 0, 8, "🎯 TP2", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 1, 8, tp2Text, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 0, 9, "🎯 TP3", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 1, 9, tp3Text, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 0, 10, "🕯️ ENTRY CONFIRMATION", text_color = color.white, bgcolor = PANEL_DARK, text_size = 12)
        table.cell(coach, 1, 10, entryConfirmationText, text_color = color.white, bgcolor = PANEL_MID, text_size = 12)
        table.cell(coach, 0, 11, "NOW", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 11, nowText, text_color = anyEntryReady ? color.white : color.black, bgcolor = anyEntryReady ? GREEN_UP : ORANGE_WAIT, text_size = 13)
        table.cell(coach, 0, 12, "SYSTEM", text_color = color.white, bgcolor = PANEL_DARK, text_size = 12)
        table.cell(coach, 1, 12, runtimeReason, text_color = color.orange, bgcolor = PANEL_DARK, text_size = 12)
    else
        table.cell(coach, 0, 0, "🤖 SLUMDAWG  ▸", text_color = color.lime, bgcolor = PANEL_MID, text_size = 12)

alertcondition(standardEntryReady, "Slumdawg STANDARD ENTRY READY", "SLUMDAWG STANDARD ENTRY READY - verify plan/risk before any action")
alertcondition(qualifiedMomentumEntry, "Slumdawg RESEARCH MOMENTUM ENTRY", "SLUMDAWG RESEARCH MOMENTUM ENTRY CANDIDATE - research/parity only")
