//@version=6
indicator("Slumdawg traders indicator", shorttitle = "SLUMDAWG", overlay = true, behind_chart = true, max_labels_count = 80, max_lines_count = 40, max_boxes_count = 10)

// v0.16.1 - TP LINES + CONSERVATIVE NEAR-SIDE TARGETS + ORIGINAL PANEL COLORS
// PLATFORM PARITY / RESEARCH ONLY. NOT LIVE-DECISION-SUPPORT APPROVED.
// Automatic trendlines remain removed.
// PDH/PDL/PWH/PWL preserve the visually accepted v0.14.x engine.
// The visually accepted v0.15.x 15m structural entry selector is intentionally unchanged.
// TP reaction structures remain a visual-parity hypothesis, but visible TP geometry is now:
// - a full-width BLUE line, not a filled box;
// - LONG TP line = conservative near/lower side of the selected upper reaction zone;
// - SHORT TP line = conservative near/upper side of the selected lower reaction zone;
// - the far wick is NEVER the automatic TP price in this build.

const bool LIVE_DECISION_SUPPORT_APPROVED = false
const float EXPECTED_TICK = 0.25
const int NORMAL_CLOSED_GAP_MS = 72 * 60 * 60 * 1000
const float HUGE_DISTANCE = 1e12
const int LEVEL_LABEL_OFFSET_BARS = 16
const int FALLBACK_BAR_MS = 5 * 60 * 1000
const int ENTRY_PIVOT_LEFT = 2
const int ENTRY_PIVOT_RIGHT = 2
const int ENTRY_SWING_MEMORY = 8  // TEST-ONLY / CALIBRATION-REQUIRED.

string gSetup = "1 - SETUP"
string bigDirection = input.string("NOT SET", "BIG DIRECTION", options = ["UP", "DOWN", "NOT SET"], group = gSetup, display = display.none)
string planSide = input.string("LONG", "PLAN", options = ["LONG", "SHORT"], group = gSetup, display = display.none)
string entryMode = input.string("AUTO", "ENTRY LEVEL MODE", options = ["AUTO", "MANUAL"], group = gSetup, display = display.none)
float manualLongEntry = input.price(0.0, "MANUAL LONG ENTRY", group = gSetup, display = display.none)
float manualShortEntry = input.price(0.0, "MANUAL SHORT ENTRY", group = gSetup, display = display.none)
string targetMode = input.string("AUTO", "TAKE PROFIT MODE", options = ["AUTO", "MANUAL"], group = gSetup, display = display.none)
float manualTargetLow = input.price(0.0, "MANUAL TAKE PROFIT lower edge", group = gSetup, display = display.none)
float manualTargetHigh = input.price(0.0, "MANUAL TAKE PROFIT upper edge", group = gSetup, display = display.none)

string gView = "2 - DISPLAY"
bool showCoach = input.bool(true, "Show Slumdawg Traders panel", group = gView, tooltip = "Turn OFF to collapse the panel into a small SLUMDAWG tab. Turn ON to restore the full panel.")
bool showWeeklyWhenNear = input.bool(true, "Show PWH/PWL when near", group = gView)
bool showEntryLines = input.bool(true, "Show LONG/SHORT entry zones", group = gView)
bool showTakeProfitZones = input.bool(true, "Show Take Profit Zones", group = gView)
bool showBothTpSides = input.bool(true, "Show both LONG/SHORT TP ladders", group = gView, tooltip = "ON shows target lines above and below price. OFF shows only the PLAN side.")

color GREEN_UP = color.rgb(0, 205, 105)
color RED_DOWN = color.rgb(230, 55, 70)
color BLUE_DAY = color.rgb(35, 112, 255)
color BLUE_WEEK = color.rgb(91, 82, 230)
color BLUE_TARGET = color.rgb(42, 118, 255)
color YELLOW_GO = color.rgb(255, 190, 25)
color ORANGE_WAIT = color.rgb(255, 155, 35)
color PANEL_DARK = color.rgb(18, 20, 25)
color PANEL_MID = color.rgb(37, 41, 49)
color GOLD_ACCENT = color.rgb(205, 165, 70)

bool isNqMnq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool tickGridExpected = math.abs(syminfo.mintick - EXPECTED_TICK) < 1e-6
bool executionViewSupported = timeframe.isminutes and timeframe.multiplier <= 15

[dHighCurrent, dLowCurrent, dCloseTimeCurrent] = request.security(syminfo.tickerid, "D", [high, low, time_close], lookahead = barmerge.lookahead_off)
[dHighPrev, dLowPrev] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wHighCurrent, wLowCurrent, wCloseTimeCurrent] = request.security(syminfo.tickerid, "W", [high, low, time_close], lookahead = barmerge.lookahead_off)
[wHighPrev, wLowPrev] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

int closedGapMs = timenow - time_close
bool recentClosedGap = not barstate.isrealtime and closedGapMs >= 0 and closedGapMs <= NORMAL_CLOSED_GAP_MS
bool extendedClosedGap = not barstate.isrealtime and closedGapMs > NORMAL_CLOSED_GAP_MS
bool dailyCurrentCompletedNow = recentClosedGap and not na(dCloseTimeCurrent) and timenow >= dCloseTimeCurrent
bool weeklyCurrentCompletedNow = recentClosedGap and not na(wCloseTimeCurrent) and timenow >= wCloseTimeCurrent

float pdh = dailyCurrentCompletedNow ? dHighCurrent : dHighPrev
float pdl = dailyCurrentCompletedNow ? dLowCurrent : dLowPrev
float pwh = weeklyCurrentCompletedNow ? wHighCurrent : wHighPrev
float pwl = weeklyCurrentCompletedNow ? wLowCurrent : wLowPrev

bool dayValuesValid = not na(pdh) and not na(pdl)
bool weekValuesValid = not na(pwh) and not na(pwl)
float dailyVisualEnvelope = dayValuesValid ? math.max(math.abs(pdh - close), math.abs(pdl - close)) : na
bool showPdh = dayValuesValid
bool showPdl = dayValuesValid
bool showPwh = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwh - close) <= dailyVisualEnvelope
bool showPwl = showWeeklyWhenNear and weekValuesValid and not na(dailyVisualEnvelope) and math.abs(pwl - close) <= dailyVisualEnvelope

plot(pdh, "PDH data", display = display.none)
plot(pdl, "PDL data", display = display.none)
plot(pwh, "PWH data", display = display.none)
plot(pwl, "PWL data", display = display.none)

f_max_na(float a, float b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

f_min_na(float a, float b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

f_outer_entry_pair_15m() =>
    float ph = ta.pivothigh(high, ENTRY_PIVOT_LEFT, ENTRY_PIVOT_RIGHT)
    float pl = ta.pivotlow(low, ENTRY_PIVOT_LEFT, ENTRY_PIVOT_RIGHT)
    float ph0 = ta.valuewhen(not na(ph), ph, 0)
    float ph1 = ta.valuewhen(not na(ph), ph, 1)
    float ph2 = ta.valuewhen(not na(ph), ph, 2)
    float ph3 = ta.valuewhen(not na(ph), ph, 3)
    float ph4 = ta.valuewhen(not na(ph), ph, 4)
    float ph5 = ta.valuewhen(not na(ph), ph, 5)
    float ph6 = ta.valuewhen(not na(ph), ph, 6)
    float ph7 = ta.valuewhen(not na(ph), ph, 7)
    float pl0 = ta.valuewhen(not na(pl), pl, 0)
    float pl1 = ta.valuewhen(not na(pl), pl, 1)
    float pl2 = ta.valuewhen(not na(pl), pl, 2)
    float pl3 = ta.valuewhen(not na(pl), pl, 3)
    float pl4 = ta.valuewhen(not na(pl), pl, 4)
    float pl5 = ta.valuewhen(not na(pl), pl, 5)
    float pl6 = ta.valuewhen(not na(pl), pl, 6)
    float pl7 = ta.valuewhen(not na(pl), pl, 7)
    float hi01 = f_max_na(ph0, ph1)
    float hi23 = f_max_na(ph2, ph3)
    float hi45 = f_max_na(ph4, ph5)
    float hi67 = f_max_na(ph6, ph7)
    float outerHigh = f_max_na(f_max_na(hi01, hi23), f_max_na(hi45, hi67))
    float lo01 = f_min_na(pl0, pl1)
    float lo23 = f_min_na(pl2, pl3)
    float lo45 = f_min_na(pl4, pl5)
    float lo67 = f_min_na(pl6, pl7)
    float outerLow = f_min_na(f_min_na(lo01, lo23), f_min_na(lo45, lo67))
    [outerHigh, outerLow]

[autoLongRaw, autoShortRaw] = request.security(syminfo.tickerid, "15", f_outer_entry_pair_15m(), lookahead = barmerge.lookahead_off)

f_round_up_tick(float p) =>
    na(p) ? na : math.ceil((p - 1e-10) / syminfo.mintick) * syminfo.mintick

f_round_down_tick(float p) =>
    na(p) ? na : math.floor((p + 1e-10) / syminfo.mintick) * syminfo.mintick

float autoLongEntry = f_round_up_tick(autoLongRaw)
float autoShortEntry = f_round_down_tick(autoShortRaw)
float longEntry = entryMode == "MANUAL" and manualLongEntry > 0 ? manualLongEntry : autoLongEntry
float shortEntry = entryMode == "MANUAL" and manualShortEntry > 0 ? manualShortEntry : autoShortEntry
bool longEntrySet = not na(longEntry) and longEntry > 0
bool shortEntrySet = not na(shortEntry) and shortEntry > 0
float activeGoLine = planSide == "LONG" ? longEntry : shortEntry
bool goSet = not na(activeGoLine) and activeGoLine > 0

plot(longEntry, "LONG structural proof data", display = display.none)
plot(shortEntry, "SHORT structural proof data", display = display.none)

f_tp_candidates_15m() =>
    float ph = ta.pivothigh(high, ENTRY_PIVOT_LEFT, ENTRY_PIVOT_RIGHT)
    float pl = ta.pivotlow(low, ENTRY_PIVOT_LEFT, ENTRY_PIVOT_RIGHT)
    float highBodySource = math.max(open[ENTRY_PIVOT_RIGHT], close[ENTRY_PIVOT_RIGHT])
    float lowBodySource = math.min(open[ENTRY_PIVOT_RIGHT], close[ENTRY_PIVOT_RIGHT])
    float h8 = ta.valuewhen(not na(ph), ph, 8)
    float hb8 = ta.valuewhen(not na(ph), highBodySource, 8)
    float h9 = ta.valuewhen(not na(ph), ph, 9)
    float hb9 = ta.valuewhen(not na(ph), highBodySource, 9)
    float h10 = ta.valuewhen(not na(ph), ph, 10)
    float hb10 = ta.valuewhen(not na(ph), highBodySource, 10)
    float h11 = ta.valuewhen(not na(ph), ph, 11)
    float hb11 = ta.valuewhen(not na(ph), highBodySource, 11)
    float h12 = ta.valuewhen(not na(ph), ph, 12)
    float hb12 = ta.valuewhen(not na(ph), highBodySource, 12)
    float h13 = ta.valuewhen(not na(ph), ph, 13)
    float hb13 = ta.valuewhen(not na(ph), highBodySource, 13)
    float h14 = ta.valuewhen(not na(ph), ph, 14)
    float hb14 = ta.valuewhen(not na(ph), highBodySource, 14)
    float h15 = ta.valuewhen(not na(ph), ph, 15)
    float hb15 = ta.valuewhen(not na(ph), highBodySource, 15)
    float l8 = ta.valuewhen(not na(pl), pl, 8)
    float lb8 = ta.valuewhen(not na(pl), lowBodySource, 8)
    float l9 = ta.valuewhen(not na(pl), pl, 9)
    float lb9 = ta.valuewhen(not na(pl), lowBodySource, 9)
    float l10 = ta.valuewhen(not na(pl), pl, 10)
    float lb10 = ta.valuewhen(not na(pl), lowBodySource, 10)
    float l11 = ta.valuewhen(not na(pl), pl, 11)
    float lb11 = ta.valuewhen(not na(pl), lowBodySource, 11)
    float l12 = ta.valuewhen(not na(pl), pl, 12)
    float lb12 = ta.valuewhen(not na(pl), lowBodySource, 12)
    float l13 = ta.valuewhen(not na(pl), pl, 13)
    float lb13 = ta.valuewhen(not na(pl), lowBodySource, 13)
    float l14 = ta.valuewhen(not na(pl), pl, 14)
    float lb14 = ta.valuewhen(not na(pl), lowBodySource, 14)
    float l15 = ta.valuewhen(not na(pl), pl, 15)
    float lb15 = ta.valuewhen(not na(pl), lowBodySource, 15)
    [hb8, h8, hb9, h9, hb10, h10, hb11, h11, hb12, h12, hb13, h13, hb14, h14, hb15, h15,
     l8, lb8, l9, lb9, l10, lb10, l11, lb11, l12, lb12, l13, lb13, l14, lb14, l15, lb15]

[tpHb8, tpH8, tpHb9, tpH9, tpHb10, tpH10, tpHb11, tpH11, tpHb12, tpH12, tpHb13, tpH13, tpHb14, tpH14, tpHb15, tpH15,
 tpL8, tpLb8, tpL9, tpLb9, tpL10, tpLb10, tpL11, tpLb11, tpL12, tpLb12, tpL13, tpLb13, tpL14, tpLb14, tpL15, tpLb15] = request.security(syminfo.tickerid, "15", f_tp_candidates_15m(), lookahead = barmerge.lookahead_off)

array<float> longTpLos = array.from(tpHb8, tpHb9, tpHb10, tpHb11, tpHb12, tpHb13, tpHb14, tpHb15)
array<float> longTpHis = array.from(tpH8, tpH9, tpH10, tpH11, tpH12, tpH13, tpH14, tpH15)
array<float> shortTpLos = array.from(tpL8, tpL9, tpL10, tpL11, tpL12, tpL13, tpL14, tpL15)
array<float> shortTpHis = array.from(tpLb8, tpLb9, tpLb10, tpLb11, tpLb12, tpLb13, tpLb14, tpLb15)

f_pick_long_zone(array<float> lows, array<float> highs, float floorPrice) =>
    float bestLo = na
    float bestHi = na
    float bestDist = HUGE_DISTANCE
    int n = array.size(lows)
    if n > 0
        for i = 0 to n - 1
            float lo = array.get(lows, i)
            float hi = array.get(highs, i)
            bool valid = not na(lo) and not na(hi) and hi > lo and lo > floorPrice
            if valid
                float dist = lo - floorPrice
                if dist < bestDist
                    bestDist := dist
                    bestLo := lo
                    bestHi := hi
    [bestLo, bestHi]

f_pick_short_zone(array<float> lows, array<float> highs, float ceilingPrice) =>
    float bestLo = na
    float bestHi = na
    float bestDist = HUGE_DISTANCE
    int n = array.size(lows)
    if n > 0
        for i = 0 to n - 1
            float lo = array.get(lows, i)
            float hi = array.get(highs, i)
            bool valid = not na(lo) and not na(hi) and hi > lo and hi < ceilingPrice
            if valid
                float dist = ceilingPrice - hi
                if dist < bestDist
                    bestDist := dist
                    bestLo := lo
                    bestHi := hi
    [bestLo, bestHi]

float longTpFloor = longEntrySet ? longEntry : close
float shortTpCeiling = shortEntrySet ? shortEntry : close
[longTp1Lo, longTp1Hi] = f_pick_long_zone(longTpLos, longTpHis, longTpFloor)
[longTp2Lo, longTp2Hi] = f_pick_long_zone(longTpLos, longTpHis, na(longTp1Hi) ? longTpFloor : longTp1Hi + syminfo.mintick)
[longTp3Lo, longTp3Hi] = f_pick_long_zone(longTpLos, longTpHis, na(longTp2Hi) ? (na(longTp1Hi) ? longTpFloor : longTp1Hi + syminfo.mintick) : longTp2Hi + syminfo.mintick)
[shortTp1Lo, shortTp1Hi] = f_pick_short_zone(shortTpLos, shortTpHis, shortTpCeiling)
[shortTp2Lo, shortTp2Hi] = f_pick_short_zone(shortTpLos, shortTpHis, na(shortTp1Lo) ? shortTpCeiling : shortTp1Lo - syminfo.mintick)
[shortTp3Lo, shortTp3Hi] = f_pick_short_zone(shortTpLos, shortTpHis, na(shortTp2Lo) ? (na(shortTp1Lo) ? shortTpCeiling : shortTp1Lo - syminfo.mintick) : shortTp2Lo - syminfo.mintick)

bool longTp1Set = not na(longTp1Lo) and not na(longTp1Hi)
bool longTp2Set = not na(longTp2Lo) and not na(longTp2Hi)
bool longTp3Set = not na(longTp3Lo) and not na(longTp3Hi)
bool shortTp1Set = not na(shortTp1Lo) and not na(shortTp1Hi)
bool shortTp2Set = not na(shortTp2Lo) and not na(shortTp2Hi)
bool shortTp3Set = not na(shortTp3Lo) and not na(shortTp3Hi)

float longTp1Price = longTp1Set ? f_round_down_tick(longTp1Lo) : na
float longTp2Price = longTp2Set ? f_round_down_tick(longTp2Lo) : na
float longTp3Price = longTp3Set ? f_round_down_tick(longTp3Lo) : na
float shortTp1Price = shortTp1Set ? f_round_up_tick(shortTp1Hi) : na
float shortTp2Price = shortTp2Set ? f_round_up_tick(shortTp2Hi) : na
float shortTp3Price = shortTp3Set ? f_round_up_tick(shortTp3Hi) : na

bool manualTargetSet = manualTargetLow > 0 and manualTargetHigh > manualTargetLow
float manualTargetPrice = not manualTargetSet ? na : planSide == "LONG" ? f_round_down_tick(manualTargetLow) : f_round_up_tick(manualTargetHigh)
float activeTp1Price = targetMode == "MANUAL" ? manualTargetPrice : planSide == "LONG" ? longTp1Price : shortTp1Price
bool activeTp1Set = not na(activeTp1Price) and activeTp1Price > 0

plot(longTp1Price, "LONG TP1 near-side data", display = display.none)
plot(shortTp1Price, "SHORT TP1 near-side data", display = display.none)

var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pwhLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line pwlLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longEntryLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortEntryLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longTp1Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longTp2Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line longTp3Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortTp1Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortTp2Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line shortTp3Line = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)
var line manualTpLine = line.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.both)

var label pdhLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pdlLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pwhLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label pwlLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longEntryLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortEntryLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longTp1Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longTp2Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label longTp3Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortTp1Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortTp2Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label shortTp3Label = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)
var label manualTpLabel = label.new(na, na, "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left)

int chartBarMs = not na(time_close) and time_close > time ? time_close - time : FALLBACK_BAR_MS
int levelLabelX = (not na(time_close) ? time_close : time) + chartBarMs * LEVEL_LABEL_OFFSET_BARS

f_sync_level(line id, label lid, float price, string name, color c, bool visible, int labelX, int width, color txtColor) =>
    if visible and not na(price) and price > 0
        line.set_xy1(id, time, price)
        line.set_xy2(id, time_close, price)
        line.set_extend(id, extend.both)
        line.set_color(id, c)
        line.set_width(id, width)
        label.set_xy(lid, labelX, price)
        label.set_text(lid, name)
        label.set_color(lid, c)
        label.set_textcolor(lid, txtColor)
        label.set_size(lid, size.normal)
    else
        line.set_xy1(id, na, na)
        line.set_xy2(id, na, na)
        label.set_xy(lid, na, na)
        label.set_text(lid, "")

array<string> wallNames = array.new_string()
array<float> wallPrices = array.new_float()

f_add_wall(bool condition, string name, float price) =>
    if condition and not na(price)
        array.push(wallNames, name)
        array.push(wallPrices, price)

if planSide == "LONG"
    f_add_wall(showPdh and pdh > close, "PDH", pdh)
    f_add_wall(showPwh and pwh > close, "PWH", pwh)
else
    f_add_wall(showPdl and pdl < close, "PDL", pdl)
    f_add_wall(showPwl and pwl < close, "PWL", pwl)

string nextWallName = "NONE AHEAD"
float nextWallPrice = na
float nextWallDistance = HUGE_DISTANCE
if array.size(wallPrices) > 0
    for i = 0 to array.size(wallPrices) - 1
        float p = array.get(wallPrices, i)
        float dist = math.abs(p - close)
        if dist < nextWallDistance
            nextWallDistance := dist
            nextWallName := array.get(wallNames, i)
            nextWallPrice := p
string nextWallText = na(nextWallPrice) ? nextWallName : nextWallName + " @ " + str.tostring(nextWallPrice, format.mintick)

if barstate.islast
    f_sync_level(pdhLine, pdhLabel, pdh, "PDH", BLUE_DAY, showPdh, levelLabelX, 2, color.white)
    f_sync_level(pdlLine, pdlLabel, pdl, "PDL", BLUE_DAY, showPdl, levelLabelX, 2, color.white)
    f_sync_level(pwhLine, pwhLabel, pwh, "PWH", BLUE_WEEK, showPwh, levelLabelX, 2, color.white)
    f_sync_level(pwlLine, pwlLabel, pwl, "PWL", BLUE_WEEK, showPwl, levelLabelX, 2, color.white)
    bool showEntryGeometry = showEntryLines and executionViewSupported
    f_sync_level(longEntryLine, longEntryLabel, longEntry, "🟢 LONG - ENTRY ZONE", YELLOW_GO, showEntryGeometry and longEntrySet, levelLabelX, 3, color.black)
    f_sync_level(shortEntryLine, shortEntryLabel, shortEntry, "🔴 SHORT - ENTRY ZONE", YELLOW_GO, showEntryGeometry and shortEntrySet, levelLabelX, 3, color.black)
    bool tpView = showTakeProfitZones and executionViewSupported
    bool drawLongTp = tpView and (showBothTpSides or planSide == "LONG") and targetMode == "AUTO"
    bool drawShortTp = tpView and (showBothTpSides or planSide == "SHORT") and targetMode == "AUTO"
    f_sync_level(longTp1Line, longTp1Label, longTp1Price, "🎯 TAKE PROFIT ZONE 1", BLUE_TARGET, drawLongTp and longTp1Set, levelLabelX, 2, color.white)
    f_sync_level(longTp2Line, longTp2Label, longTp2Price, "🎯 TAKE PROFIT ZONE 2", BLUE_TARGET, drawLongTp and longTp2Set, levelLabelX, 2, color.white)
    f_sync_level(longTp3Line, longTp3Label, longTp3Price, "🎯 TAKE PROFIT ZONE 3", BLUE_TARGET, drawLongTp and longTp3Set, levelLabelX, 2, color.white)
    f_sync_level(shortTp1Line, shortTp1Label, shortTp1Price, "🎯 TAKE PROFIT ZONE 1", BLUE_TARGET, drawShortTp and shortTp1Set, levelLabelX, 2, color.white)
    f_sync_level(shortTp2Line, shortTp2Label, shortTp2Price, "🎯 TAKE PROFIT ZONE 2", BLUE_TARGET, drawShortTp and shortTp2Set, levelLabelX, 2, color.white)
    f_sync_level(shortTp3Line, shortTp3Label, shortTp3Price, "🎯 TAKE PROFIT ZONE 3", BLUE_TARGET, drawShortTp and shortTp3Set, levelLabelX, 2, color.white)
    bool drawManual = tpView and targetMode == "MANUAL" and manualTargetSet
    f_sync_level(manualTpLine, manualTpLabel, manualTargetPrice, "🎯 TAKE PROFIT ZONE", BLUE_TARGET, drawManual, levelLabelX, 2, color.white)

bool directionKnown = bigDirection != "NOT SET"
bool planWithDirection = directionKnown and ((bigDirection == "UP" and planSide == "LONG") or (bigDirection == "DOWN" and planSide == "SHORT"))
string currentMoveText = not directionKnown ? "WAITING FOR DIRECTION" : planWithDirection ? (planSide == "LONG" ? "UP WITH BIG DIRECTION" : "DOWN WITH BIG DIRECTION") : (planSide == "LONG" ? "TEMPORARY UP MOVE" : "TEMPORARY DOWN MOVE")
string activeTpText = activeTp1Set ? str.tostring(activeTp1Price, format.mintick) : "NOT SET"
string nowText = not executionViewSupported ? "ENTRY/TP VIEW: 5M / 15M" : not goSet ? "⚠️ NO CONFIRMED ENTRY WICK" : planSide == "LONG" ? "⏳ WATCH 🟢 LONG ENTRY" : "⏳ WATCH 🔴 SHORT ENTRY"
string runtimeReason = not isNqMnq ? "USE NQ OR MNQ" : not tickGridExpected ? "CHECK CONTRACT TICK" : extendedClosedGap ? "EXTENDED CLOSE - VERIFY LEVELS" : "KEY LEVELS + ENTRY + TP"
color bigDirectionColor = bigDirection == "UP" ? GREEN_UP : bigDirection == "DOWN" ? RED_DOWN : color.gray
color moveColor = not directionKnown ? color.gray : planSide == "LONG" ? GREEN_UP : RED_DOWN

var table coach = na
if barstate.isfirst
    if showCoach
        coach := table.new(position.top_right, 2, 9, border_width = 2, frame_width = 2, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)
        table.merge_cells(coach, 0, 0, 1, 0)
    else
        coach := table.new(position.top_right, 1, 1, border_width = 1, frame_width = 1, frame_color = GOLD_ACCENT, bgcolor = PANEL_DARK)

if barstate.islast
    if showCoach
        table.cell(coach, 0, 0, "🤖 SLUMDAWG TRADERS", text_color = color.lime, bgcolor = PANEL_MID, text_size = 16)
        table.cell(coach, 0, 1, "BIG DIRECTION", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 1, bigDirection, text_color = color.white, bgcolor = bigDirectionColor, text_size = 14)
        table.cell(coach, 0, 2, "CURRENT MOVE", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 2, currentMoveText, text_color = color.white, bgcolor = moveColor, text_size = 13)
        table.cell(coach, 0, 3, "NEXT WALL", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 3, nextWallText, text_color = color.orange, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 0, 4, "🟢 LONG ENTRY", text_color = color.black, bgcolor = YELLOW_GO, text_size = 13)
        table.cell(coach, 1, 4, longEntrySet ? str.tostring(longEntry, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 14)
        table.cell(coach, 0, 5, "🔴 SHORT ENTRY", text_color = color.black, bgcolor = YELLOW_GO, text_size = 13)
        table.cell(coach, 1, 5, shortEntrySet ? str.tostring(shortEntry, format.mintick) : "NOT SET", text_color = color.black, bgcolor = YELLOW_GO, text_size = 14)
        table.cell(coach, 0, 6, "🎯 TAKE PROFIT", text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 1, 6, activeTpText, text_color = color.white, bgcolor = BLUE_TARGET, text_size = 13)
        table.cell(coach, 0, 7, "NOW", text_color = color.white, bgcolor = PANEL_DARK, text_size = 13)
        table.cell(coach, 1, 7, nowText, text_color = color.black, bgcolor = ORANGE_WAIT, text_size = 13)
        table.cell(coach, 0, 8, "SYSTEM", text_color = color.white, bgcolor = PANEL_DARK, text_size = 12)
        table.cell(coach, 1, 8, runtimeReason, text_color = color.orange, bgcolor = PANEL_DARK, text_size = 12)
    else
        table.cell(coach, 0, 0, "🤖 SLUMDAWG  ▸", text_color = color.lime, bgcolor = PANEL_MID, text_size = 12)

alertcondition(false, "V0.16.1 TP lines + conservative near-side targets", "NON-ACTIONABLE research build")
