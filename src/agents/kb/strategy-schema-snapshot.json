{
  "$defs": {
    "ChartConstruction": {
      "description": "Chart construction type. CANDLES is the safe default (real OHLC).\nRENKO is opt-in for grid/scaling strategies and requires brick_size_atr in entry_params.\nHEIKIN_ASHI is rejected — synthetic price means backtests don't validate real edge.",
      "enum": [
        "candles",
        "renko"
      ],
      "title": "ChartConstruction",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "long",
        "short",
        "both"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EntryType": {
      "enum": [
        "breakout",
        "mean_reversion",
        "trend_follow",
        "volatility_expansion",
        "session_pattern",
        "event_driven"
      ],
      "title": "EntryType",
      "type": "string"
    },
    "ExitType": {
      "enum": [
        "fixed_target",
        "trailing_stop",
        "time_exit",
        "indicator_signal",
        "atr_multiple"
      ],
      "title": "ExitType",
      "type": "string"
    },
    "ProfitScalingTier": {
      "additionalProperties": false,
      "description": "Profit-tier sizing config (W5a / Tier 5.4).\n\nPairs with `compute_profit_tier()` and `compute_position_sizes()` in\n`src/engine/sizing.py`. Every `threshold` of cumulative single-account profit\nadds `increment` extra micro contracts to the base ATR-derived size, capped by\nthe firm-specific cap and the global CONTRACT_CAP_MAX (20).\n\nDSL fixtures emit `{\"increment\": 2, \"threshold\": 3000}` only —\n`account_pnl_total` is injected at backtest-run time from live account PnL,\nso it is intentionally absent from the schema.",
      "properties": {
        "increment": {
          "default": 2,
          "description": "Contracts added per tier",
          "maximum": 10,
          "minimum": 1,
          "title": "Increment",
          "type": "integer"
        },
        "threshold": {
          "default": 3000,
          "description": "Cumulative single-account profit per tier ($)",
          "exclusiveMinimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "title": "ProfitScalingTier",
      "type": "object"
    },
    "Timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ],
      "title": "Timeframe",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Strategy Definition Language — the strict schema every strategy must conform to.",
  "properties": {
    "bypass_news_blackout": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When True, strategy explicitly opts into trading during news windows. Required for event-driven strategies like news_fade_mcl. Must be explicitly set — no default opt-in.",
      "title": "Bypass News Blackout"
    },
    "chart_construction": {
      "$ref": "#/$defs/ChartConstruction",
      "default": "candles",
      "description": "Chart bar construction. 'candles' (default) uses real OHLC. 'renko' is opt-in for grid/scaling strategies — requires brick_size_atr in entry_params."
    },
    "daily_target_dollars": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Daily P&L target in dollars (informational). None = no target.",
      "title": "Daily Target Dollars"
    },
    "description": {
      "description": "One-sentence strategy description",
      "maxLength": 500,
      "minLength": 10,
      "title": "Description",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "entry_condition": {
      "description": "Plain English entry rule, one sentence",
      "title": "Entry Condition",
      "type": "string"
    },
    "entry_indicator": {
      "description": "Primary indicator for entry (e.g., 'sma_crossover', 'bollinger_breakout', 'rsi_reversal')",
      "title": "Entry Indicator",
      "type": "string"
    },
    "entry_params": {
      "additionalProperties": true,
      "description": "Max 5 parameters for entry logic",
      "title": "Entry Params",
      "type": "object"
    },
    "entry_type": {
      "$ref": "#/$defs/EntryType"
    },
    "exit_params": {
      "additionalProperties": true,
      "description": "Exit parameters (target, stop, trail)",
      "title": "Exit Params",
      "type": "object"
    },
    "exit_type": {
      "$ref": "#/$defs/ExitType"
    },
    "frankenstein_test_mode": {
      "anyOf": [
        {
          "enum": [
            "full_shuffle",
            "benchmark_relative",
            "calendar_preserving",
            "synthetic_gbm"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Shuffle mode for A4 Frankenstein randomization test. None = full_shuffle.",
      "title": "Frankenstein Test Mode"
    },
    "max_contracts": {
      "anyOf": [
        {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Contracts"
    },
    "name": {
      "maxLength": 100,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "preferred_regime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "TRENDING_UP | TRENDING_DOWN | RANGE_BOUND | HIGH_VOL | LOW_VOL",
      "title": "Preferred Regime"
    },
    "profit_scaling_tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfitScalingTier"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional profit-tier sizing config. When None, no scaling."
    },
    "schema_version": {
      "default": "v1",
      "description": "DSL schema version",
      "title": "Schema Version",
      "type": "string"
    },
    "session_filter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "RTH_ONLY | ETH_ONLY | ALL_SESSIONS | LONDON | ASIA",
      "title": "Session Filter"
    },
    "sizing_method": {
      "anyOf": [
        {
          "enum": [
            "fixed",
            "kelly",
            "atr_based"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Position sizing method. None = existing fixed/ATR logic (backward-compatible). 'kelly' = Kelly Criterion optimal sizing (quarter-Kelly by default). 'fixed' = fixed contracts (same as None, explicit). 'atr_based' = dynamic ATR sizing (same as None, explicit).",
      "title": "Sizing Method"
    },
    "source": {
      "default": "manual",
      "description": "manual | ollama | openclaw | n8n",
      "title": "Source",
      "type": "string"
    },
    "stop_loss_atr_multiple": {
      "description": "Stop loss as ATR multiple",
      "maximum": 5,
      "minimum": 0.5,
      "title": "Stop Loss Atr Multiple",
      "type": "number"
    },
    "symbol": {
      "description": "Futures symbol (MES, MNQ, MCL only)",
      "enum": [
        "MES",
        "MNQ",
        "MCL"
      ],
      "title": "Symbol",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "take_profit_atr_multiple": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Take Profit Atr Multiple"
    },
    "timeframe": {
      "$ref": "#/$defs/Timeframe"
    }
  },
  "required": [
    "name",
    "description",
    "symbol",
    "timeframe",
    "direction",
    "entry_type",
    "entry_indicator",
    "entry_params",
    "entry_condition",
    "exit_type",
    "exit_params",
    "stop_loss_atr_multiple"
  ],
  "title": "StrategyDSL",
  "type": "object"
}
