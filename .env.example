# sweep detection lookback
LIQUIDITY_SWEEP_LOOKBACK_DEFAULT=your-value-here
# sweep volume multiplier
LIQUIDITY_SWEEP_VOLUME_MULT_DEFAULT=your-value-here
# NEMO scenario count default
NEMO_DEFAULT_COUNT=0
# min critiques for aggregation (default 10)
PATTERN_AGGREGATOR_MIN_CRITIQUES=your-value-here
# pattern aggregator window
PATTERN_AGGREGATOR_WINDOW=your-value-here
# pause snapshot toggle
PAUSE_SNAPSHOT_ENABLED=false
# regime survival phase override
REGIME_SURVIVAL_PHASE=your-value-here
# risk-targeted VIX level
RISK_VIX_TARGET=your-value-here
# risk vol scale max
RISK_VOL_SCALE_MAX=0
# risk vol scale min
RISK_VOL_SCALE_MIN=0
# ruleset staleness (active)
RULESET_MAX_AGE_HOURS_ACTIVE=your-value-here
# ruleset staleness (research)
RULESET_MAX_AGE_HOURS_RESEARCH=your-value-here
# slippage tick rounding
SLIPPAGE_TICK_ROUNDING_MODE=your-value-here
# snapshot update mode (CI)
SNAPSHOT_UPDATE=your-value-here
# DSL feature lookback bars
STRATEGY_DSL_LOOKBACK=your-value-here
# DSL similarity dedup threshold
STRATEGY_DSL_SIMILARITY_THRESHOLD=0
# allow fixed-1 sizing (debugging)
TF_ALLOW_FIXED_1=your-value-here
# backtest anti-setup mode
TF_BACKTEST_ANTI_SETUP_MODE=your-value-here
# backtest compliance mode override
TF_BACKTEST_COMPLIANCE_MODE=your-value-here
# backtest skip mode
TF_BACKTEST_SKIP_MODE=your-value-here
# decay full sub-signals
TF_DECAY_FULL_SUBSIGNALS=your-value-here
# fail-closed execution gate
TF_FAIL_CLOSED_EXECUTION=your-value-here
# paper skip mode
TF_PAPER_SKIP_MODE=your-value-here
# position lock toggle
TF_POSITION_LOCKING=your-value-here
# stress test mode
TF_STRESS_TEST_MODE=your-value-here
# survival in forge score toggle
TF_SURVIVAL_IN_FORGE_SCORE=your-value-here
# verify replay determinism
TF_VERIFY_DETERMINISM=your-value-here
# trade critique concurrency (default 3)
TRADE_CRITIQUE_CONCURRENCY=your-value-here
# validation cadence floor
VALIDATION_CADENCE_MIN_STRATEGIES_PER_MONTH=your-value-here
# validation cadence red threshold days
VALIDATION_CADENCE_RED_THRESHOLD_DAYS=0
# volume profile node threshold
VP_NODE_THRESHOLD_PCT_DEFAULT=your-value-here
# VP profile window
VP_PROFILE_WINDOW_DEFAULT=your-value-here
# VP-tracked symbols (CSV)
VP_SYMBOLS=your-value-here
# Temporary migration escape valve ONLY. false (default) = promotion FAILS CLOSED when a strategy lacks
# CPCV/WRC/SPA/B14 evidence (correct institutional posture). Set true ONLY during a one-time migration
# of pre-Pass-E strategies, then set back to false.
PROMOTION_GRANDFATHER_PRE_PASS_E=false
