# Trading Forge frontend env template
# Copy to .env and adjust per deployment.

# Backend API base URL.
# - Same-origin (frontend served by Express): "/api"
# - Cross-origin (frontend on Vercel/static, backend on tf-relay): "https://tf-relay-production.up.railway.app/api"
# Default if unset: "/api"
VITE_API_BASE=/api
