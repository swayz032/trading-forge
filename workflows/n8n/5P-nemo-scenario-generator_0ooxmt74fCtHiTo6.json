  "name": "5P-nemo-scenario-generator",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Sunday 5AM ET Weekly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,10 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "generate-nemo-scenarios",
      "name": "Generate NeMo Scenarios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        260,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/nemo-scenarios/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "count",
              "value": "500"
            }
          ]
        },
        "options": {
          "timeout": 14400000
        }
      },
      "onError": "continueRegularOutput",
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000
    },
    {
      "id": "check-result",
      "name": "Batch Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        520,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "log-success",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nreturn [{\n  json: {\n    event: 'nemo_batch_success',\n    batchId: result.batchId,\n    scenariosInserted: result.scenariosInserted,\n    elapsedMs: result.elapsedMs,\n    generatorVersion: result.generatorVersion,\n    governance: result.governance,\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "log-failure",
      "name": "Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        400
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nreturn [{\n  json: {\n    event: 'nemo_batch_failed',\n    status: result.status,\n    error: result.error,\n    skipped: result.skipped,\n    governance: result.governance,\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    }
  ],
  "connections": {
