  "id": "5bfT33w0TylM0Hbk",
  "name": "3A-workflow-backup",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "sched",
      "name": "Daily 3 AM ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "g",
      "name": "GET All Workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://n8n-production-84ff.up.railway.app/api/v1/workflows",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.TF_N8N_API_KEY }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "id": "f",
      "name": "Format Backup Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst workflows = resp.data || resp;\nconst count = Array.isArray(workflows) ? workflows.length : 0;\nconst items = [];\nif (Array.isArray(workflows)) {\n  for (const wf of workflows) {\n    items.push({ json: { id: wf.id, name: wf.name, active: wf.active, updatedAt: wf.updatedAt } });\n  }\n}\nif (items.length === 0) items.push({ json: { id: 'none', name: 'No workflows found' } });\nreturn items;"
      }
    },
    {
      "id": "b",
      "name": "Broadcast Backup Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/sse/broadcast",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: \"backup:complete\", data: { workflowCount: $json.workflowCount, timestamp: $json.timestamp } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "fd",
      "name": "Fetch Workflow Detail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "continueOnFail": true,
      "parameters": {
        "url": "=https://n8n-production-84ff.up.railway.app/api/v1/workflows/{{ $json.id }}",
        "method": "GET",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $env.TF_N8N_API_KEY }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "sb",
      "name": "Store Backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst backup = {\n  timestamp: new Date().toISOString(),\n  workflowCount: allItems.length,\n  workflows: allItems.map(i => ({ id: i.json.id, name: i.json.name, active: i.json.active, nodeCount: (i.json.nodes || []).length }))\n};\nreturn [{ json: backup }];"
      }
    },
    {
      "id": "err-trigger",
      "name": "On Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        200,
        -300
      ]
    },
    {
      "id": "err-alert",
      "name": "Alert on Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        -300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/sse/broadcast",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: \"alert:triggered\", data: { type: \"workflow_error\", workflow: \"3A-workflow-backup\", error: $json.execution?.error?.message || $json.error?.message || \"Unknown error\", timestamp: new Date().toISOString() } }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    }
  ],
