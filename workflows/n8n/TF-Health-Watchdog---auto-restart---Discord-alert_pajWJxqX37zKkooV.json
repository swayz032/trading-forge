  "name": "TF Health Watchdog — auto-restart + Discord alert",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "cron-60s",
      "name": "Every 60s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "* * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "http-health",
      "name": "GET /api/health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://tf-relay-production.up.railway.app/api/health",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "id": "code-track",
      "name": "Track failures (workflow staticData)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Wave 26 Pass H.4 — health watchdog state machine\n// HMAC computed HERE (Code node has Node.js require); HTTP nodes downstream read $json.signature\nconst crypto = require('crypto');\nconst staticData = $getWorkflowStaticData('global');\nstaticData.consecutiveFails ??= 0;\nstaticData.lastRestartAt ??= 0;\nstaticData.lastDiscordAt ??= 0;\n\nconst resp = $input.first().json;\nconst status = resp.statusCode ?? resp.status ?? 0;\nconst isHealthy = status === 200 && resp.body?.status === 'ok';\nconst now = Date.now();\n\nlet action = 'noop';\nlet detail = `health_status=${status} healthy=${isHealthy}`;\n\nif (isHealthy) {\n  if (staticData.consecutiveFails > 0) {\n    detail += ` recovered_after=${staticData.consecutiveFails}_fails`;\n    action = 'recovered';\n  }\n  staticData.consecutiveFails = 0;\n} else {\n  staticData.consecutiveFails++;\n  detail += ` consecutive_fails=${staticData.consecutiveFails}`;\n  if (staticData.consecutiveFails >= 3 && (now - staticData.lastRestartAt) > 5 * 60 * 1000) {\n    action = 'restart';\n    staticData.lastRestartAt = now;\n  }\n  if (staticData.consecutiveFails >= 5 && (now - staticData.lastDiscordAt) > 15 * 60 * 1000) {\n    action = action === 'restart' ? 'restart_and_alert' : 'alert';\n    staticData.lastDiscordAt = now;\n  }\n}\n\n// Pre-compute HMAC payload so HTTP node (sandboxed, no require) can read it via $json.signature\nconst timestamp = Math.floor(now / 1000);\nconst reason = 'watchdog_3_consecutive_fails';\nconst secret = $env.ADMIN_RESTART_HMAC_SECRET || 'unset';\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}:${reason}`).digest('hex');\n\nreturn [{ json: { action, detail, consecutiveFails: staticData.consecutiveFails, healthBody: resp.body ?? null, timestamp, reason, signature } }];"
      }
    },
    {
      "id": "switch-action",
      "name": "Switch on action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        720,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "restart",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.action}}",
                    "rightValue": "restart",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "alert",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.action}}",
                    "rightValue": "alert",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "restart_and_alert",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.action}}",
                    "rightValue": "restart_and_alert",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
    {
      "id": "http-restart",
      "name": "POST self-restart (HMAC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/admin/self-restart",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ timestamp: $json.timestamp, reason: $json.reason }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Restart-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "id": "http-discord",
      "name": "POST Discord alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_OPS_WEBHOOK || 'https://tf-relay-production.up.railway.app/api/admin/discord-fallback' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"🚨 TF API unhealthy — \" + $json.consecutiveFails + \" consecutive failures. Watchdog has restarted but service still down. Manual intervention may be needed.\"\n}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    }
  ],
