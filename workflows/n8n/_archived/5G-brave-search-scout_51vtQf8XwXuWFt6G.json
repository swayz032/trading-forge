      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.search.brave.com/res/v1/web/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Subscription-Token",
              "value": "={{ $env.BRAVE_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "futures trading strategies algo edge profitable backtest"
            },
            {
              "name": "count",
              "value": "20"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "brave-search",
      "name": "Brave Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst webResults = $input.first().json.web?.results || [];\nfor (const r of webResults) {\n  results.push({\n    json: {\n      source: 'brave',\n      title: r.title || '',\n      description: r.description || '',\n      url: r.url || '',\n      confidence_score: r.extra_snippets ? 0.7 : 0.5\n    }\n  });\n}\nreturn [{ json: { ideas: results.map(r => r.json) } }];"
      },
      "id": "parse-brave",
      "name": "Parse Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/agent/scout-ideas",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ideas: ($json.ideas || []).map(i => Object.assign({}, i, { signal_type: 'strategy_candidate' })) }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "post-ideas",
      "name": "Post Scout Ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
