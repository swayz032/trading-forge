        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "rt",
      "name": "Run Tournament",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/tournament/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ strategies: .data ||  }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "id": "fr",
      "name": "Format Tournament Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const results = $input.first().json;\nconst summary = { timestamp: new Date().toISOString(), winner: results.winner || results.topStrategy || 'N/A', participants: results.participants || results.count || 0, rankings: results.rankings || results.results || [], message: 'Tournament complete: ' + (results.participants || results.count || 0) + ' strategies competed. Winner: ' + (results.winner || results.topStrategy || 'N/A') };\nreturn [{ json: summary }];"
      }
    },
    {
      "id": "at",
      "name": "Alert Tournament Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/sse/broadcast",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: \"tournament:complete\", data: { winner: .winner, participants: .participants, rankings: .rankings, timestamp: .timestamp, message: .message } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
