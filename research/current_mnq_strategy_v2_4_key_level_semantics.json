{
  "schema_version": 4,
  "release_id": "MNQ-V2.4-KEY-LEVEL-EQUATION-4",
  "frozen_at": "2026-08-18",
  "purpose": "Encode the trader/video rule that a key zone can be established either by multiple independent rejections or by one exceptional swing rejection followed by drastic displacement, without PnL tuning or hindsight from later pivots, and preserve trader-confirmed range-day travel room before fresh entry zones.",
  "established_zone_path": {
    "authority": "existing causal multi-rejection quality engine",
    "minimum_independent_rejections": 2,
    "quality_dimensions": [
      "wick_quality",
      "displacement_away",
      "close_away",
      "price_compactness",
      "temporal_independence",
      "recency",
      "reaction_count_saturation"
    ]
  },
  "exceptional_single_swing_path": {
    "enabled": true,
    "lookback_calendar_days": 40,
    "lookback_anchor": "candidate_confirmation_time",
    "current_asof_may_not_rewindow_candidate_reference_history": true,
    "same_side_reference_only": true,
    "reference_pivots_must_confirm_before_candidate": true,
    "candidate_itself_excluded_from_reference_distribution": true,
    "later_pivots_forbidden_from_retroactive_classification": true,
    "older_reference_pivots_aging_out_of_current_map_may_not_reclassify_candidate": true,
    "minimum_wick_fraction_uses_frozen_strategy_parameter": "min_wick",
    "absolute_displacement_floor_atr": 1.0,
    "recent_displacement_percentile": 0.75,
    "minimum_reference_pivots_for_percentile": 4,
    "equation": "confirmed_before_map_freeze AND wick>=min_wick AND displacement_atr>=max(1.0,Q75(same-side pivot displacement_atr whose confirmation is inside [candidate_confirm-40d,candidate_confirm)))",
    "no_overlap_duplicate_with_established_zone": true,
    "zone_half_width": "max(4_ticks,key_level_pad_atr*the_pivot_ATR)",
    "must_survive_zone_lifecycle_to_map_freeze": true
  },
  "range_day_zone_room": {
    "enabled": true,
    "causal_classifier": "premarket_plan.pm_structure == MIXED",
    "rule": "On a ranging/mixed day, do not authorize fresh key zones crowded against or inside the active pre-open range. Prefer entry zones that leave room for price to break out and travel before reaching the key zone.",
    "minimum_room": "Params.min_room_r * Params.stop",
    "nearby_structure_is_preserved_for_reaction_or_tp_context": true,
    "nearby_structure_is_not_deleted_from_market_map": true,
    "no_hindsight_full_day_range_label": true,
    "no_new_numeric_threshold": true
  },
  "confluence": {
    "prior_day_or_week_level_overlap_adds_one_vote": true,
    "native_active_15m_fvg_overlap_adds_one_vote": true,
    "fvg_detector_authority": "src/engine/indicators/fvg_native.py"
  },
  "anti_overfit": {
    "no_PnL_selection": true,
    "no_threshold_search": true,
    "percentile_is_market_regime_adaptation_not_variant_selection": true,
    "changing_this_contract_invalidates_prior_v2_4_evidence": true
  }
}
