        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tf-relay-production.up.railway.app/api/sse/broadcast",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: \"backup:complete\", data: { workflowCount: .workflowCount, timestamp: .timestamp } }) }}",
        "options": {
          "timeout": 15000
        }
      },
