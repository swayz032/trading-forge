        "jsonBody": "={{ JSON.stringify({ channel: 'alerts', event: 'workflow:error', payload: { workflowId: '5J-unified-search-router-scout', workflowName: 'Unified Search Router Scout', executionId: $execution.id, nodeName: 'unknown', errorMessage: ($json.error?.message || 'unknown error').slice(0, 500), firstSeenAt: new Date().toISOString(), occurrenceCount: 1 } }) }}",
        "options": {
          "timeout": 10000
        }
      },
