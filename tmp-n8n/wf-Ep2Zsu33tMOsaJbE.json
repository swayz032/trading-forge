  "name": "5J-unified-search-router-scout",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "cron",
      "name": "Hourly Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "disabled": false
    },
    {
      "id": "router-call",
      "name": "POST /search/strategy-hunt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/search/strategy-hunt",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ intent: 'systematic-trading-strategy', query: 'futures trading strategy backtest results', maxResults: 15 }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "split",
      "name": "Split Results",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "shape",
      "name": "Shape to Strict Scout Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst result = r.results?.[0] || r;\nconst snippet = (result.snippet || result.description || '').slice(0, 1500);\nconst title = (result.title || 'unknown').slice(0, 200);\nconst url = result.url || '';\nconst fusedScore = Number(result.fusedScore) || 0.5;\nconst sourceProvider = result.source || 'unified-search';\n\nconst combined = title + ' ' + snippet;\nconst instrumentMatches = combined.match(/(MES|MNQ|MCL|ES|NQ|CL)\\b/gi) || [];\nconst indicatorMatches = combined.match(/(VWAP|RSI|SMA|EMA|MACD|ATR|Bollinger|ORB|Order Block|FVG|ICT|SMC|Donchian|Keltner|Ichimoku|DEMA|ALMA)\\b/gi) || [];\nconst instruments = [...new Set(instrumentMatches.map(m => m.toUpperCase()))];\nconst indicators = [...new Set(indicatorMatches)];\n\nconst out = {\n  ideas: [{\n    source: 'unified-search-' + sourceProvider,\n    title: title,\n    description: snippet,\n    url: url,\n    source_quality: fusedScore >= 0.7 ? 'high' : fusedScore >= 0.4 ? 'medium' : 'low',\n    confidence_score: Math.min(1, Math.max(0, fusedScore)),\n    instruments: instruments,\n    indicators_mentioned: indicators,\n    signal_type: 'strategy_candidate',\n  }]\n};\nreturn [{ json: out }];"
      }
    },
    {
      "id": "post-strict",
      "name": "POST /agent/scout-ideas (legacy)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agent/scout-ideas",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ideas: ($json.ideas || []).map(i => ({ ...i, signal_type: i.signal_type || 'strategy_candidate' })) }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "loop-back",
      "name": "Loop Back",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1840,
        300
      ],
      "parameters": {}
    },
    {
      "id": "error-trigger",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
