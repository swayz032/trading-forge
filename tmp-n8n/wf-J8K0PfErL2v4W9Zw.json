      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agent/scout-ideas/strict",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ideas: [{ thesis: $json.description || $json.thesis || $json.name || 'youtube-transcript-extracted strategy', market: ($json.symbol === 'MES' ? 'ES' : ($json.symbol === 'MNQ' ? 'NQ' : ($json.symbol === 'MCL' ? 'CL' : 'ES'))), timeframe: $json.timeframe || '15m', entry_rules: ($json.entry_condition || $json.entry_rules || '') + ' indicator:' + ($json.entry_indicator || 'unknown'), exit_rules: 'exit_type: ' + ($json.exit_type || 'atr_multiple') + '; stop ' + ($json.stop_loss_atr_multiple || 1.5) + 'x ATR', risk_rules: 'ATR-based stop at ' + ($json.stop_loss_atr_multiple || 1.5) + 'x ATR', source_url: $json.source_url, regime: $json.preferred_regime || 'TRENDING_UP', concept_name: $json.entry_indicator || $json.name || 'youtube_extracted', source_provider: 'manual', signal_type: 'strategy_candidate' }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
