      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agent/transcript-extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ youtubeUrl: $('Execute Workflow Trigger').item.json.url, title: $('Execute Workflow Trigger').item.json.title || '', channel: $('Execute Workflow Trigger').item.json.creator || '', transcript: $json.text || '' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "split-strategies",
      "name": "Split Strategies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "const strategies = $input.first().json.strategies;\nif (!Array.isArray(strategies) || strategies.length === 0) {\n  console.log('transcript-extract returned no strategies');\n  return [];\n}\nreturn strategies.map(s => ({ json: s }));"
      }
    },
    {
      "id": "post-scout",
