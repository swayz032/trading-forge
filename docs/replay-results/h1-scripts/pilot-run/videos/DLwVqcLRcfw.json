        "entry_sequence": [
          {
            "step": 1,
            "action": "Wait for the first two-minute candle after the bell to close above the 20 Simple Moving Average (SMA) and the Volume Weighted Average Price (VWAP).",
            "rationale": "This confirms a bullish bias for the session."
          },
          {
            "step": 2,
            "action": "Wait for a following candle to confirm the high of the candle that closed above the 20 SMA.",
            "rationale": "Confirmation of the initial breakout."
          },
          {
            "step": 3,
            "action": "If the price pulls back into the VWAP, this is a good buying opportunity to lower the dollar cost average.",
            "rationale": "VWAP acts as support during a bullish trend."
          },
          {
            "step": 4,
            "action": "Hold the position as long as the VWAP and the 20 SMA are trending higher.",
            "rationale": "The 20 SMA acts as a trailing stop."
          },
          {
            "step": 5,
            "action": "If the price closes below the 20 SMA, use that as an indication to exit the trade.",
            "rationale": "The 20 SMA serves as the trailing stop/exit signal."
          },
          {
            "step": 6,
            "action": "If the price loses both VWAP and the 20 SMA collectively and then closes below VWAP, look to short the rejection of VWAP and the 20 SMA.",
            "rationale": "Reversal signal for a short entry."
          }
        ],
