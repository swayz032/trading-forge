        "entry_sequence": [
          {
            "step": 1,
            "action": "Identify the highest high and lowest low of price action between 3:00 a.m. EST and the New York market open (9:30 a.m. EST) on the 5-minute timeframe.",
            "rationale": "These levels act as magnets and traps for liquidity."
          },
          {
            "step": 2,
            "action": "Wait for price to break above the pre-market high or below the pre-market low.",
            "rationale": "A clean break confirms a potential long or short entry."
          },
          {
            "step": 3,
            "action": "For a breakout trade, wait for the 2-minute candle to close above the pre-market high or below the pre-market low, confirming the break.",
            "rationale": "Confirmation is required to avoid early entries."
          },
          {
            "step": 4,
            "action": "For a breakout trade, wait for an increase in volume on the breakout candle.",
            "rationale": "Volume elevation confirms the breakout is valid."
          },
          {
            "step": 5,
            "action": "Enter long at the close of the 2-minute breakout candle above the pre-market high, or enter short at the close of the 2-minute candle below the pre-market low.",
            "rationale": "Entry is taken upon confirmation of the break."
          },
          {
            "step": 6,
            "action": "For a retest trade, wait for price to pull back into the previous high (for long) or previous low (for short) and make it support/resistance.",
            "rationale": "The retest provides a second entry opportunity after the initial break."
          }
        ],
