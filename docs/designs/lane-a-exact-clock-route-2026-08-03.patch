+def _derive_exact_clock_primitive_window(
+    range_minutes: int, session_start_et: str
+) -> tuple[int, int] | None:
+    """EXECUTE the declared primitive and OBSERVE the window it aggregates over.
+
+    ★ THIS NEVER RESTATES A CONSTANT. R-660 section 3: "a cheaper comparison
+    against the primitive's DECLARED window arithmetic qualifies ONLY if it
+    COMPARES against something DERIVED FROM THE PRIMITIVE. Re-asserting a
+    constant is not a comparison and would reinstate the defect under a new
+    name." So: synthetic one-minute bars for a whole day with high == low ==
+    minute-of-day, which makes the returned opening-range high/low report the
+    BOUNDS OF THE WINDOW THE PRIMITIVE ACTUALLY USED.
+
+    FAILS CLOSED: any import, execution or shape problem returns None, and the
+    caller then declines to bind. A primitive we cannot run is a primitive we
+    do not certify."""
+    try:
+        import datetime as _datetime
+        import importlib
+
+        import polars as _pl
+
+        meta = FAMILY_META["WAIT_SESSION"]
+        dotted = meta.exact_clock_primitive
+        if not dotted:
+            return None
+        module_path, _, fn_name = dotted.rpartition(".")
+        fn = getattr(importlib.import_module(module_path), fn_name)
+
+        day = _datetime.date(2024, 1, 3)
+        ts = [_datetime.datetime.combine(day, _datetime.time(m // 60, m % 60))
+              for m in range(1440)]
+        marks = [float(m) for m in range(1440)]
+        df = _pl.DataFrame({"ts_event": ts, "high": marks, "low": marks})
+
+        orh, orl, _range = fn(df, range_minutes=range_minutes,
+                              session_start_et=session_start_et)
+        hi = orh.drop_nulls().max()
+        lo = orl.drop_nulls().min()
+        if hi is None or lo is None:
+            return None
+        # high/low carry minute-of-day, so the locked OR high is the LAST minute
+        # the primitive included and the OR low is the FIRST. End is exclusive.
+        return int(lo), int(hi) + 1
+    except Exception:  # noqa: BLE001 - fail closed, never bind on a broken probe
+        return None
+
