+def resolve_exact_clock_span(object_text: str) -> tuple[int, int] | None:
+    """Taught text -> (start_min, end_min) for ONE unambiguous clock span, else None.
+
+    CONJUNCTS, ALL REQUIRED, FAIL-CLOSED. Measured over all 260 Phase-1 rows: this
+    selects EXACTLY ONE row (AR-711). The conjunct that does all the narrowing is
+    the span-preposition test, which is an EXISTING guard in this module --
+    _SESSION_CLOCK_SPAN_PREP_RE, whose set deliberately excludes `at` and `into`
+    (see the note at the LEVEL_ZONE neighbourhood comment). That is why
+    "this one AT 7:00 a.m. and this one AT 8:00 a.m." (two POINT references, not
+    a span) and "after 3:00 a.m. ... INTO New York market open" are both refused
+    structurally rather than by special case.
+    """
+    if not object_text:
+        return None
+    text = object_text.strip()
+
+    # (1) EXACTLY two clock tokens. Three or more means a parameterised family
+    #     taught in one row -- the golden slice carries SIX, spanning three
+    #     windows -- and picking one of them is a derivation loss (R-660 section 1).
+    toks = list(_SESSION_CLOCK_TOKEN_RE.finditer(text))
+    if len(toks) != 2:
+        return None
+
+    mins: list[int] = []
+    for m in toks:
+        hour, minute, meridiem = _session_clock_token_parts(m)
+        hh = hour % 12
+        if meridiem and meridiem.lower().startswith("p"):
+            hh += 12
+        mins.append(hh * 60 + minute)
+
+    # (2) Two DISTINCT anchors in order. Equal or reversed is not a span.
+    if len(set(mins)) != 2 or mins[0] >= mins[1]:
+        return None
+
+    # (3) BOTH numerals governed by a span preposition -- the delimiting test.
+    if len(_SESSION_CLOCK_SPAN_PREP_RE.findall(text)) < 2:
+        return None
+
+    # (4) TIER-1 market context, never a bare timezone. This module records a
+    #     measured false bind where "eastern time" alone attached a coaching-
+    #     session sentence to the london window.
+    if not _SESSION_CLOCK_MARKET_CONTEXT_RE.search(text):
+        return None
+
+    return mins[0], mins[1]
+
