+    def _h_opening_range(self, b: ConditionBinding, ctx: dict) -> np.ndarray:
+        """Execute the TAUGHT opening-range window this instance carries.
+
+        WHAT THIS BOOLEAN MEANS, AND IT IS NOT WHAT A READER WILL ASSUME:
+        `OPENING RANGE STATE AVAILABLE AND COMPLETE` — never `TRADE NOW`. This family
+        is a DEFINITION, not a trigger. There is no breakout above the range high, no
+        breakdown below the low, no midpoint entry, no direction selection, no retest,
+        no confirmation, no stop and no target here; every one of those is source-owned
+        entry logic that this step is forbidden to invent (R-779 §7, and architecture
+        invariant 2 — source-owned entry logic is never silently rewritten).
+
+        PER-BAR, AND FALSE BEFORE THE WINDOW CLOSES. The bar at 09:34 must not know the
+        5m range, 09:44 the 15m, 09:59 the 30m. The adapter is called ONCE, and it reads
+        only bars inside `[start, lock)`, so its answer cannot depend on anything later;
+        the availability gate below is what stops that answer being published early.
+
+        REFUSES, NEVER GUESSES:
+          * no candidate            -> ValueError naming the missing candidate
+          * a frame with no usable timestamps -> ValueError, not a silent all-False
+          * FORMING / INCOMPLETE    -> all-False, the adapter's own refusal, unedited
+        """
+        candidate = self.opening_range_candidate
+        if candidate is None:
+            raise ValueError(
+                f"condition {b.condition_id!r} ({b.type}) is an opening-range condition, but "
+                "this strategy instance carries NO execution candidate, so the taught window "
+                "it should compute is unknown. REFUSAL opening_range_candidate_absent: the "
+                "teacher taught three alternatives and named no default, so selecting one "
+                "here would be invention. Construct the instance with the candidate it is "
+                "meant to execute."
+            )
+
+        ts_list = ctx.get("ts_list") or []
+        n = int(ctx.get("n") or len(ts_list))
+        out = np.zeros(n, dtype=bool)
+        stamped = [(i, ts) for i, ts in enumerate(ts_list) if ts is not None]
+        if not stamped:
+            raise ValueError(
+                f"condition {b.condition_id!r} ({b.type}) reached the opening-range adapter "
+                "with a frame carrying no usable timestamps. REFUSAL "
+                "opening_range_frame_untimed: an opening range is defined by wall-clock "
+                "boundaries in a named zone, so an untimed frame cannot produce one. "
+                "Refused rather than returning an all-False column, which a caller cannot "
+                "tell apart from a session where the window simply never closed."
+            )
+
+        # The bar interval is a DATA-CONTRACT fact the runtime supplies, never something
+        # the source taught (opening_range_definition.py is explicit that interval belongs
+        # to the adapter side of the boundary). It is read off this instance's declared
+        # timeframe rather than inferred from the bars, because inferring it from the same
+        # timestamps the adapter then grid-checks would make the completeness check
+        # partly self-confirming: a frame missing a bar would define its own interval and
+        # look on-grid. `AN INSTRUMENT THAT DERIVES ITS TOLERANCE FROM THE SAMPLE CANNOT
+        # DETECT AN OUT-OF-TOLERANCE SAMPLE.`
+        timeframe = str(self.timeframe or "").strip().lower()
+        if not (timeframe.endswith("m") and timeframe[:-1].isdigit()):
+            raise ValueError(
+                f"condition {b.condition_id!r} ({b.type}) cannot be evaluated: this instance's "
+                f"timeframe {self.timeframe!r} is not a whole number of minutes, and the "
+                "opening-range adapter requires the bar interval in minutes. REFUSAL "
+                "opening_range_bar_interval_unknown: no interval was guessed."
+            )
+        bar_interval_minutes = int(timeframe[:-1])
+
+        zone = ZoneInfo(candidate.definition.source_timezone)
+        # The SESSION DATE is runtime-owned and comes from the frame's own first stamped
+        # bar, read in the TAUGHT zone — not from a constant, and not from the source.
+        session_date = stamped[0][1].astimezone(zone).date()
+        as_of = stamped[-1][1]
+
+        # ONE call. The existing adapter, with the candidate's OWN definition and variant —
+        # no second calculator, no re-derivation of the window, no reimplementation of the
+        # refusals it already owns.
+        #
+        # RESOLVED THROUGH THE MODULE ATTRIBUTE, DELIBERATELY. `from ... import
+        # compute_opening_range_state` would bind this call to a private reference taken at
+        # import time, which is a different object from the one `PRIMITIVE_RESOLVERS`
+        # resolves (`module:attr`). The two agree in production and diverge under any
+        # instrumentation that patches the module — so the import form would make the
+        # declared primitive and the executed function DIFFERENT THINGS while every name in
+        # the declaration still resolved. `A POINTER THAT NAMES THE RIGHT FUNCTION AND A
+        # CALL THAT REACHES A COPY OF IT ARE NOT THE SAME WIRING.`
+        state = opening_range_adapter.compute_opening_range_state(
+            candidate.definition,
+            candidate.variant,
+            [
+                OpeningRangeBar(
+                    timestamp=ts,
+                    high=float(ctx["high"][i]),
+                    low=float(ctx["low"][i]),
+                )
+                for i, ts in stamped
+            ],
+            session_date=session_date,
+            bar_interval_minutes=bar_interval_minutes,
+            as_of=as_of,
+        )
+        if not state.opening_range_complete:
+            # The adapter refused (FORMING or INCOMPLETE_OPENING_WINDOW). Its refusal is
+            # published as-is: no levels, no signal, and no fallback to a shorter window.
+            return out
+
+        # AVAILABILITY GATE — the same single window calculator the adapter uses, reused
+        # rather than duplicated, so there is exactly one definition of when this window
+        # closes. Bars before the lock instant are False: that is the no-lookahead rule
+        # expressed as code rather than asserted in a comment.
+        _, lock = _window_bounds(candidate.definition, candidate.variant, session_date)
+        for i, ts in stamped:
+            if ts >= lock:
+                out[i] = True
+        return out
