        100
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.SLUMDAWG_WEBHOOK_SECRET;\nif (!secret) { throw new Error('SLUMDAWG_WEBHOOK_SECRET not set on this n8n environment'); }\nconst path = \"/ingest-youtube\";\nconst ts = Math.floor(Date.now() / 1000).toString();\nconst sig = crypto.createHmac('sha256', secret).update(`${ts}:${path}`).digest('hex');\nreturn { ...$json, _slumdawgAuth: { ts, sig, path } };"
      }
