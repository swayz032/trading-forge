{
  "name": "trading-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "build:all": "npm run build:frontend && npm run build",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "lint": "eslint src/",
    "deep-scan": "tsx scripts/deep-scan.ts",
    "system-map:check": "tsx scripts/system-map.ts check",
    "system-map:sync": "tsx scripts/system-map.ts sync",
    "check:package-lock-integrity": "node scripts/check-package-lock-integrity.mjs",
    "check:production-isolation": "node scripts/check-production-isolation.mjs",
    "check:2026-compliance": "node scripts/verify-2026-rules-compliance.mjs",
    "check:family-grade-postscript": "tsx scripts/check-family-grade-postscript.ts",
    "check:sse-contract": "node scripts/check-sse-contract.mjs",
    "check:gate-parity": "node scripts/check-gate-parity.mjs",
    "check:ts-python-exit-parity": "npx tsx scripts/wave26-ts-python-exit-parity.ts",
    "check:pglite-ddl-parity": "npx tsx scripts/check-pglite-ddl-parity.ts",
    "check:gate-contract-keys": "npx tsx scripts/check-gate-contract-keys.ts",
    "check:spec-binding-plan-parity": "npx tsx scripts/check-spec-binding-plan-parity.ts",
    "check:ts-python-tier1-parity": "npx tsx scripts/check-ts-python-tier1-parity.ts",
    "check:ts-python-pm-factor-parity": "npx tsx scripts/check-ts-python-pm-factor-parity.ts",
    "check:ts-python-stop-geometry-parity": "npx tsx scripts/check-ts-python-stop-geometry-parity.ts",
    "check:ts-python-firm-rules-version": "npx tsx scripts/check-ts-python-firm-rules-version.ts",
    "check:archetype-lockstep": "npx tsx scripts/check-archetype-lockstep.ts",
    "check:migration-immutability": "vitest run src/server/__tests__/migration-immutability-guard.test.ts",
    "check:gate-fault-injection": "node node_modules/vitest/vitest.mjs run src/server/__tests__/ds22-x1-gate-contract-keys-strict.test.ts src/server/__tests__/ds22-x1-family-grade-postscript-strict.test.ts src/server/__tests__/ds22-x1-other-gates-fault-injection.test.ts",
    "audit:n8n": "node scripts/audit-n8n-workflows.mjs",
    "check:quantum-backends": "python -m src.engine.quantum_backend_status",
    "preflight:vacation": "tsx scripts/pre-vacation-preflight.ts",
    "forge": "tsx scripts/cli.ts",
    "discord": "tsx src/discord/bot.ts",
    "discord:dev": "tsx watch src/discord/bot.ts",
    "test:metrics": "python -m pytest src/engine/tests/test_metric_snapshot.py src/engine/tests/test_golden_fixtures.py src/engine/tests/test_frankenstein.py src/engine/tests/test_cross_engine_parity.py -v --tb=short",
    "test:metrics:fast": "python -m pytest src/engine/tests/test_metric_snapshot.py::TestSnapshotPerfect src/engine/tests/test_metric_snapshot.py::TestSnapshotMarginal src/engine/tests/test_metric_snapshot.py::TestSnapshotFeesKiller src/engine/tests/test_metric_snapshot.py::TestSnapshotConsistency -q --tb=short",
    "test:metrics:update-snapshots": "SNAPSHOT_UPDATE=1 python -m pytest src/engine/tests/test_metric_snapshot.py -v --tb=short",
    "test:full-fleet": "vitest run --config vitest.config.full-fleet.ts",
    "test:scripts": "node --test \"scripts/lib/__tests__/*.test.mjs\" \"scripts/soak/__tests__/*.test.mjs\" \"scripts/watchdog/__tests__/*.test.mjs\" \"scripts/ops/__tests__/*.test.mjs\" scripts/rails/__tests__/cert-core.test.mjs scripts/rails/__tests__/full-lane.test.mjs scripts/rails/__tests__/full-lane.redproof.test.mjs scripts/rails/__tests__/rail-liveness-report.test.mjs",
    "lint:false-success": "node scripts/lib/run-false-success-lint.cjs",
    "runsheet:check": "node scripts/ops/render-runsheet.cjs",
    "runsheet:write": "node scripts/ops/render-runsheet.cjs --write",
    "env-manifest:check": "node scripts/ops/verify-env-manifest.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/lib-storage": "^3.1005.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "duckdb-async": "^1.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "openai": "^6.33.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "ws": "^8.21.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.5.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "tar": "7.5.21"
  }
}
