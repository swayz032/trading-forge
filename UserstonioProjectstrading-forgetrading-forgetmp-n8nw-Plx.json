Tries":2},{"id":"merge-reddit-a","name":"Merge Reddit A","type":"n8n-nodes-base.merge","typeVersion":3,"position":[470,-140],"parameters":{"mode":"append","numberInputs":2}},{"id":"merge-reddit-b","name":"Merge Reddit B","type":"n8n-nodes-base.merge","typeVersion":3,"position":[690,-40],"parameters":{"mode":"append","numberInputs":2}},{"id":"merge-context","name":"Merge Scout Context","type":"n8n-nodes-base.merge","typeVersion":3,"position":[910,20],"parameters":{"mode":"append","numberInputs":2}},{"id":"parse-reddit","name":"Parse Reddit","type":"n8n-nodes-base.code","typeVersion":2,"position":[1130,20],"parameters":{"jsCode":"const fingerprintPayload = $('Fetch Scout Fingerprints').first()?.json ?? {};\nconst fingerprints = Array.isArray(fingerprintPayload.fingerprints) ? fingerprintPayload.fingerprints : [];\nconst knownKeys = new Set();\nfor (const fingerprint of fingerprints) {\n  if (fingerprint.title_hash) knownKeys.add(String(fingerprint.title_hash));\n  if (fingerprint.url) knownKeys.add(String(fingerprint.url));\n}\n\nconst fetchFailures = [];\nconst ideas = [];\nconst normalizeTitle = (title) => title.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().slice(0, 160);\n\nfor (const item of $input.all()) {\n  const payload = item.json ?? {};\n  const requestError = payload.error || payload.errorMessage || payload.message || null;\n  if (requestError) {\n    fetchFailures.push(String(requestError));\n    continue;\n  }\n\n  const posts = Array.isArray(payload?.data?.children) ? payload.data.children : [];\n  for (const post of posts) {\n    const data = post?.data ?? {};\n    const ups = Number(data.ups || 0);\n    const title = String(data.title || '').trim();\n    const url = 'https://www.reddit.com' + String(data.permalink || '');\n    const titleHash = normalizeTitle(title);\n    if (!title || ups <= 10) continue;\n    if (knownKeys.has(titleHash) || knownKeys.has(url)) continue;\n    knownKeys.add(titleHash);\n    knownKeys.add(url);\n\n    ideas.push({\n 